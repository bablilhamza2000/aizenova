---
import Layout from '~/layouts/Layout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `404 - Page Not Found`;
---

<Layout metadata={{ title }}>
  <section class="flex items-center min-h-screen px-6 py-20">
    <div class="container mx-auto text-center">

      <h1 class="text-8xl md:text-9xl font-extrabold text-primary">
        404
      </h1>

      <h2 class="mt-6 text-3xl md:text-4xl font-bold">
        Oops! This page doesn't exist.
      </h2>

      <p class="mt-5 max-w-2xl mx-auto text-lg text-muted dark:text-slate-400">
        The page you're looking for may have been moved, deleted,
        or the URL might be incorrect.
      </p>

      <div class="mt-10 flex justify-center gap-4 flex-wrap">
        <a href={getHomePermalink()} class="btn">
          🏠 Back to Home
        </a>

        <a href="/blog" class="btn btn-secondary">
          📚 Visit Blog
        </a>
      </div>

    </div>
  </section>
</Layout>