---
import Layout from '../../layouts/Layout.astro';

const pageTitle = 'AI Instagram Caption Generator | AIZENOVA';
const pageDescription =
  'Generate engaging Instagram captions with hashtags and calls to action using AIZENOVA.';
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="mx-auto max-w-5xl px-6 py-12 text-white">

    <a
      href="/ai-tools"
      class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
    >
      ← Back to AI Tools
    </a>

    <header class="mt-10 text-center">
      <div
        class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
      >
        📸
      </div>

      <h1 class="text-4xl font-bold sm:text-5xl">
        AI Instagram Caption Generator
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-gray-400">
        Create engaging Instagram captions for photos, products, brands, and
        social media content.
      </p>
    </header>

    <section class="mt-12 grid gap-8 lg:grid-cols-2">

      <!-- INPUT -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8"
      >
        <h2 class="text-xl font-semibold">
          Caption Details
        </h2>

        <p class="mt-2 text-sm text-gray-500">
          Describe your post and choose the style you want.
        </p>

        <div class="mt-7">
          <label
            for="topic"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            What is your post about?
          </label>

          <textarea
            id="topic"
            rows="6"
            placeholder="Example: A photo from my trip to Morocco at sunset"
            class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm leading-7 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>
        </div>

        <div class="mt-5">
          <label
            for="style"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Caption Style
          </label>

          <select
            id="style"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white outline-none focus:border-white/30"
          >
            <option value="engaging" selected>
              Engaging
            </option>

            <option value="funny">
              Funny
            </option>

            <option value="inspirational">
              Inspirational
            </option>

            <option value="professional">
              Professional
            </option>

            <option value="minimal">
              Short & Simple
            </option>

            <option value="luxury">
              Luxury
            </option>

            <option value="storytelling">
              Storytelling
            </option>
          </select>
        </div>

        <div class="mt-5">
          <label
            for="length"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Caption Length
          </label>

          <select
            id="length"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white outline-none focus:border-white/30"
          >
            <option value="short">
              Short
            </option>

            <option value="medium" selected>
              Medium
            </option>

            <option value="long">
              Long
            </option>
          </select>
        </div>

        <div class="mt-5">
          <label
            for="audience"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Target Audience
          </label>

          <input
            id="audience"
            type="text"
            placeholder="Example: Travelers, creators, entrepreneurs"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-5">
          <label
            for="cta"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Call to Action
          </label>

          <input
            id="cta"
            type="text"
            placeholder="Example: What is your favorite travel destination?"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <button
            id="generateBtn"
            type="button"
            class="flex-1 rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200"
          >
            Generate Caption
          </button>

          <button
            id="clearBtn"
            type="button"
            class="rounded-xl border border-white/10 px-6 py-4 text-gray-300 transition hover:bg-white/10"
          >
            Clear
          </button>
        </div>

        <p
          id="status"
          class="mt-4 hidden text-center text-sm text-gray-400"
        ></p>
      </div>

      <!-- OUTPUT -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8 lg:sticky lg:top-8 lg:self-start"
      >
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold">
              Generated Caption
            </h2>

            <p class="mt-1 text-sm text-gray-500">
              Your Instagram caption will appear here.
            </p>
          </div>

          <button
            id="copyBtn"
            type="button"
            class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10"
          >
            Copy
          </button>
        </div>

        <textarea
          id="output"
          readonly
          rows="25"
          placeholder="Your Instagram caption will appear here..."
          class="mt-6 w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-4 text-sm leading-7 text-gray-300 outline-none"
        ></textarea>

        <div class="mt-4 flex items-center justify-between text-xs text-gray-500">
          <span id="wordCount">
            0 words
          </span>

          <span id="charCount">
            0 characters
          </span>
        </div>
      </div>

    </section>

    <section class="mt-16 max-w-3xl">
      <h2 class="text-2xl font-bold">
        Tips for better Instagram captions
      </h2>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">✨</div>

          <h3 class="mt-3 font-semibold">
            Start with a hook
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Use an interesting opening line that makes people want to keep
            reading.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">💬</div>

          <h3 class="mt-3 font-semibold">
            Encourage interaction
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Ask a relevant question or invite your audience to share their
            opinion.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">🎯</div>

          <h3 class="mt-3 font-semibold">
            Stay relevant
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Make sure the caption accurately matches your photo or video.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">#️⃣</div>

          <h3 class="mt-3 font-semibold">
            Use useful hashtags
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Choose hashtags related to the actual topic instead of adding
            unrelated popular tags.
          </p>
        </div>

      </div>
    </section>

  </main>

  <script>
    const $ = (id: string) =>
      document.getElementById(id);

    const getValue = (id: string) => {
      const element =
        document.getElementById(id) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | HTMLSelectElement
          | null;

      return element?.value.trim() || '';
    };

    const clean = (text: string) =>
      text.replace(/\s+/g, ' ').trim();

    function makeHashtags(topic: string) {
      const words =
        topic
          .toLowerCase()
          .replace(/[^\p{L}\p{N}\s]/gu, '')
          .split(/\s+/)
          .filter(
            (word) => word.length > 3
          )
          .slice(0, 6);

      const tags = [
        ...words,
        'Instagram',
        'ContentCreator',
        'Inspiration',
      ];

      return [
        ...new Set(
          tags
        ),
      ]
        .slice(0, 10)
        .map(
          (tag) => `#${tag.charAt(0).toUpperCase()}${tag.slice(1)}`
        )
        .join(' ');
    }

    function createCaption(
      topic: string,
      style: string,
      length: string,
      audience: string,
      cta: string
    ) {
      const subject =
        clean(topic);

      const target =
        clean(audience) ||
        'everyone';

      const action =
        clean(cta);

      const hashtags =
        makeHashtags(subject);

      const hooks: Record<string, string> = {
        engaging:
          '✨ Sometimes the simplest moments become the ones we remember the most.',
        funny:
          '😂 Okay, this was definitely not part of the original plan...',
        inspirational:
          '✨ Keep going. Small steps can lead to amazing places.',
        professional:
          'A moment worth reflecting on:',
        minimal:
          'Less noise. More moments. ✨',
        luxury:
          '✨ A moment of elegance, detail, and unforgettable experiences.',
        storytelling:
          'There is always a story behind the picture.',
      };

      const hook =
        hooks[style] ||
        hooks.engaging;

      if (length === 'short') {
        return [
          hook,
          '',
          subject + '.',
          '',
          action ||
            `What do you think?`,
          '',
          hashtags,
        ].join('\n');
      }

      if (length === 'long') {
        return [
          hook,
          '',
          subject + '.',
          '',
          `This moment reminded me that the little details often make the biggest difference.`,
          '',
          `Whether you're part of ${target} or simply enjoy discovering new ideas and experiences, there is always something worth taking away from moments like this.`,
          '',
          `Take your time, enjoy the process, and don't forget to appreciate how far you've already come.`,
          '',
          action ||
            'What would you add to this? Share your thoughts below 👇',
          '',
          hashtags,
        ].join('\n');
      }

      return [
        hook,
        '',
        subject + '.',
        '',
        `This is one of those moments that makes you stop, appreciate the present, and enjoy the experience.`,
        '',
        `For ${target}, the most important thing is to stay curious, keep creating, and enjoy the journey.`,
        '',
        action ||
          'What do you think? Let me know in the comments 👇',
        '',
        hashtags,
      ].join('\n');
    }

    function updateStats(text: string) {
      const words =
        text.trim()
          ? text.trim().split(/\s+/).length
          : 0;

      $('wordCount')!.textContent =
        `${words} ${words === 1 ? 'word' : 'words'}`;

      $('charCount')!.textContent =
        `${text.length} characters`;
    }

    function showStatus(message: string) {
      const status =
        $('status')!;

      status.textContent =
        message;

      status.classList.remove(
        'hidden'
      );

      setTimeout(() => {
        status.classList.add(
          'hidden'
        );
      }, 2500);
    }

    $('generateBtn')!.addEventListener(
      'click',
      () => {
        const topic =
          getValue('topic');

        if (!topic) {
          showStatus(
            'Please describe your post first.'
          );

          return;
        }

        const style =
          getValue('style');

        const length =
          getValue('length');

        const audience =
          getValue('audience');

        const cta =
          getValue('cta');

        const caption =
          createCaption(
            topic,
            style,
            length,
            audience,
            cta
          );

        const output =
          $('output') as HTMLTextAreaElement;

        output.value =
          caption;

        updateStats(
          caption
        );

        showStatus(
          'Instagram caption generated successfully.'
        );
      }
    );

    $('copyBtn')!.addEventListener(
      'click',
      async () => {
        const output =
          (
            $('output') as HTMLTextAreaElement
          ).value.trim();

        if (!output) {
          showStatus(
            'Generate a caption first.'
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(
            output
          );

          const button =
            $('copyBtn')!;

          const original =
            button.textContent;

          button.textContent =
            'Copied!';

          setTimeout(() => {
            button.textContent =
              original;
          }, 1800);
        } catch {
          showStatus(
            'Unable to copy automatically.'
          );
        }
      }
    );

    $('clearBtn')!.addEventListener(
      'click',
      () => {
        (
          $('topic') as HTMLTextAreaElement
        ).value = '';

        (
          $('style') as HTMLSelectElement
        ).value = 'engaging';

        (
          $('length') as HTMLSelectElement
        ).value = 'medium';

        (
          $('audience') as HTMLInputElement
        ).value = '';

        (
          $('cta') as HTMLInputElement
        ).value = '';

        (
          $('output') as HTMLTextAreaElement
        ).value = '';

        updateStats('');

        $('status')!.classList.add(
          'hidden'
        );
      }
    );

    updateStats('');
  </script>
</Layout>