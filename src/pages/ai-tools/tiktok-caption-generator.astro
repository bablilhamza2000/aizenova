---
import Layout from '../../layouts/Layout.astro';

const pageTitle = 'AI TikTok Caption Generator | AIZENOVA';
const pageDescription =
  'Generate catchy TikTok captions, hooks, calls to action, and hashtags with AIZENOVA.';
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="mx-auto max-w-5xl px-6 py-12 text-white">

    <a
      href="/ai-tools"
      class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
    >
      ← Back to AI Tools
    </a>

    <header class="mt-10 text-center">
      <div
        class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
      >
        🎵
      </div>

      <h1 class="text-4xl font-bold sm:text-5xl">
        AI TikTok Caption Generator
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-gray-400">
        Generate catchy TikTok captions, hooks, calls to action, and relevant
        hashtags for your videos.
      </p>
    </header>

    <section class="mt-12 grid gap-8 lg:grid-cols-2">

      <!-- INPUT -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8"
      >
        <h2 class="text-xl font-semibold">
          Video Details
        </h2>

        <p class="mt-2 text-sm text-gray-500">
          Describe your TikTok video and choose your preferred style.
        </p>

        <div class="mt-7">
          <label
            for="topic"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            What is your video about?
          </label>

          <textarea
            id="topic"
            rows="6"
            placeholder="Example: 5 useful AI tools that help students study faster"
            class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm leading-7 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>
        </div>

        <div class="mt-5">
          <label
            for="style"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Caption Style
          </label>

          <select
            id="style"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white outline-none focus:border-white/30"
          >
            <option value="viral" selected>
              Viral
            </option>

            <option value="funny">
              Funny
            </option>

            <option value="educational">
              Educational
            </option>

            <option value="storytelling">
              Storytelling
            </option>

            <option value="motivational">
              Motivational
            </option>

            <option value="minimal">
              Short & Simple
            </option>
          </select>
        </div>

        <div class="mt-5">
          <label
            for="length"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Caption Length
          </label>

          <select
            id="length"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white outline-none focus:border-white/30"
          >
            <option value="short">
              Short
            </option>

            <option value="medium" selected>
              Medium
            </option>

            <option value="long">
              Long
            </option>
          </select>
        </div>

        <div class="mt-5">
          <label
            for="audience"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Target Audience
          </label>

          <input
            id="audience"
            type="text"
            placeholder="Example: Students, creators, entrepreneurs"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-5">
          <label
            for="cta"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Call to Action
          </label>

          <input
            id="cta"
            type="text"
            placeholder="Example: Follow for more AI tips!"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <button
            id="generateBtn"
            type="button"
            class="flex-1 rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200"
          >
            Generate Caption
          </button>

          <button
            id="clearBtn"
            type="button"
            class="rounded-xl border border-white/10 px-6 py-4 text-gray-300 transition hover:bg-white/10"
          >
            Clear
          </button>
        </div>

        <p
          id="status"
          class="mt-4 hidden text-center text-sm text-gray-400"
        ></p>
      </div>

      <!-- OUTPUT -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8 lg:sticky lg:top-8 lg:self-start"
      >
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold">
              Generated TikTok Caption
            </h2>

            <p class="mt-1 text-sm text-gray-500">
              Your caption will appear here.
            </p>
          </div>

          <button
            id="copyBtn"
            type="button"
            class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10"
          >
            Copy
          </button>
        </div>

        <textarea
          id="output"
          readonly
          rows="26"
          placeholder="Your TikTok caption will appear here..."
          class="mt-6 w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-4 text-sm leading-7 text-gray-300 outline-none"
        ></textarea>

        <div class="mt-4 flex items-center justify-between text-xs text-gray-500">
          <span id="wordCount">
            0 words
          </span>

          <span id="charCount">
            0 characters
          </span>
        </div>
      </div>

    </section>

    <section class="mt-16 max-w-3xl">
      <h2 class="text-2xl font-bold">
        TikTok caption tips
      </h2>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">🔥</div>

          <h3 class="mt-3 font-semibold">
            Hook viewers quickly
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Start with a short and interesting line that makes people want to
            watch the video.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">💬</div>

          <h3 class="mt-3 font-semibold">
            Encourage engagement
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Ask a simple question or invite viewers to comment.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">🎯</div>

          <h3 class="mt-3 font-semibold">
            Match the video
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Keep your caption relevant to what viewers actually see in the
            video.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">#️⃣</div>

          <h3 class="mt-3 font-semibold">
            Use relevant hashtags
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Choose hashtags connected to your topic instead of unrelated
            trending tags.
          </p>
        </div>

      </div>
    </section>

  </main>

  <script>
    const $ = (id: string) =>
      document.getElementById(id);

    const getValue = (id: string) => {
      const element =
        document.getElementById(id) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | HTMLSelectElement
          | null;

      return element?.value.trim() || '';
    };

    const clean = (text: string) =>
      text.replace(/\s+/g, ' ').trim();

    function makeHashtags(topic: string) {
      const words =
        topic
          .toLowerCase()
          .replace(/[^\p{L}\p{N}\s]/gu, '')
          .split(/\s+/)
          .filter(
            (word) => word.length > 3
          )
          .slice(0, 5);

      const fixedTags = [
        'TikTok',
        'ForYou',
        'FYP',
        'Viral',
        'ContentCreator',
      ];

      const topicTags =
        words.map(
          (word) =>
            word.charAt(0).toUpperCase() +
            word.slice(1)
        );

      return [
        ...new Set([
          ...topicTags,
          ...fixedTags,
        ]),
      ]
        .slice(0, 10)
        .map(
          (tag) => `#${tag}`
        )
        .join(' ');
    }

    function createCaption(
      topic: string,
      style: string,
      length: string,
      audience: string,
      cta: string
    ) {
      const subject =
        clean(topic);

      const target =
        clean(audience) ||
        'everyone';

      const action =
        clean(cta);

      const hashtags =
        makeHashtags(subject);

      const hooks: Record<string, string> = {
        viral:
          '🔥 You need to see this!',
        funny:
          '😂 Okay, I did NOT expect this...',
        educational:
          '💡 Here is something you should know:',
        storytelling:
          'Wait until you hear the story behind this...',
        motivational:
          '✨ A little reminder that might help you today:',
        minimal:
          'Simple. Useful. Worth saving.',
      };

      const hook =
        hooks[style] ||
        hooks.viral;

      if (length === 'short') {
        return [
          hook,
          '',
          subject + '.',
          '',
          action ||
            'Follow for more! 👀',
          '',
          hashtags,
        ].join('\n');
      }

      if (length === 'long') {
        return [
          hook,
          '',
          subject + '.',
          '',
          `If you're part of ${target}, this is something worth paying attention to.`,
          '',
          'The best part is that you can start applying this idea immediately instead of waiting for the perfect moment.',
          '',
          'Save this video so you can come back to it later.',
          '',
          action ||
            'Follow for more useful content and tips! 🚀',
          '',
          hashtags,
        ].join('\n');
      }

      return [
        hook,
        '',
        subject + '.',
        '',
        `This is especially useful for ${target}.`,
        '',
        'Save this video so you can find it again later.',
        '',
        action ||
          'Follow for more useful content! 🚀',
        '',
        hashtags,
      ].join('\n');
    }

    function updateStats(text: string) {
      const words =
        text.trim()
          ? text.trim().split(/\s+/).length
          : 0;

      $('wordCount')!.textContent =
        `${words} ${words === 1 ? 'word' : 'words'}`;

      $('charCount')!.textContent =
        `${text.length} characters`;
    }

    function showStatus(message: string) {
      const status =
        $('status')!;

      status.textContent =
        message;

      status.classList.remove(
        'hidden'
      );

      setTimeout(() => {
        status.classList.add(
          'hidden'
        );
      }, 2500);
    }

    $('generateBtn')!.addEventListener(
      'click',
      () => {
        const topic =
          getValue('topic');

        if (!topic) {
          showStatus(
            'Please describe your TikTok video first.'
          );

          return;
        }

        const style =
          getValue('style');

        const length =
          getValue('length');

        const audience =
          getValue('audience');

        const cta =
          getValue('cta');

        const caption =
          createCaption(
            topic,
            style,
            length,
            audience,
            cta
          );

        const output =
          $('output') as HTMLTextAreaElement;

        output.value =
          caption;

        updateStats(
          caption
        );

        showStatus(
          'TikTok caption generated successfully.'
        );
      }
    );

    $('copyBtn')!.addEventListener(
      'click',
      async () => {
        const output =
          (
            $('output') as HTMLTextAreaElement
          ).value.trim();

        if (!output) {
          showStatus(
            'Generate a caption first.'
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(
            output
          );

          const button =
            $('copyBtn')!;

          const original =
            button.textContent;

          button.textContent =
            'Copied!';

          setTimeout(() => {
            button.textContent =
              original;
          }, 1800);
        } catch {
          showStatus(
            'Unable to copy automatically.'
          );
        }
      }
    );

    $('clearBtn')!.addEventListener(
      'click',
      () => {
        (
          $('topic') as HTMLTextAreaElement
        ).value = '';

        (
          $('style') as HTMLSelectElement
        ).value = 'viral';

        (
          $('length') as HTMLSelectElement
        ).value = 'medium';

        (
          $('audience') as HTMLInputElement
        ).value = '';

        (
          $('cta') as HTMLInputElement
        ).value = '';

        (
          $('output') as HTMLTextAreaElement
        ).value = '';

        updateStats('');

        $('status')!.classList.add(
          'hidden'
        );
      }
    );

    updateStats('');
  </script>
</Layout>