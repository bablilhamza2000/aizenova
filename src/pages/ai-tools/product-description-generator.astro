---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="AI Product Description Generator | AIZENOVA">
  <main class="mx-auto max-w-4xl px-6 py-16 text-white">

    <a
      href="/ai-tools"
      class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-white"
    >
      ← Back to AI Tools
    </a>

    <div class="mt-10 text-center">
      <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl">
        🛍️
      </div>

      <h1 class="text-4xl font-bold sm:text-5xl">
        AI Product Description Generator
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-gray-400">
        Create compelling product descriptions that clearly explain your product and help turn visitors into customers.
      </p>
    </div>

    <section class="mt-12 rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8">

      <label
        for="product"
        class="mb-3 block text-sm font-medium text-gray-200"
      >
        Product Information
      </label>

      <textarea
        id="product"
        rows="8"
        maxlength="4000"
        placeholder="Example: Wireless Bluetooth headphones with noise cancellation, 30-hour battery life, comfortable ear cushions, USB-C charging..."
        class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-4 text-white placeholder-gray-500 outline-none focus:border-white/30"
      ></textarea>

      <div class="mt-2 flex justify-between text-xs text-gray-500">
        <span>Include the main features, benefits, and details.</span>

        <span>
          <span id="charCount">0</span>/4000
        </span>
      </div>

      <div class="mt-6 grid gap-5 sm:grid-cols-2">

        <div>
          <label
            for="platform"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Where will you use it?
          </label>

          <select
            id="platform"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none"
          >
            <option value="Online Store">Online Store</option>
            <option value="Amazon">Amazon</option>
            <option value="Shopify">Shopify</option>
            <option value="Etsy">Etsy</option>
            <option value="Social Media">Social Media</option>
            <option value="General Website">General Website</option>
          </select>
        </div>

        <div>
          <label
            for="tone"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Tone
          </label>

          <select
            id="tone"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none"
          >
            <option value="Persuasive">Persuasive</option>
            <option value="Professional">Professional</option>
            <option value="Friendly">Friendly</option>
            <option value="Premium">Premium</option>
            <option value="Casual">Casual</option>
            <option value="Minimal">Minimal</option>
          </select>
        </div>

      </div>

      <div class="mt-5 grid gap-5 sm:grid-cols-2">

        <div>
          <label
            for="language"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Language
          </label>

          <select
            id="language"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none"
          >
            <option value="English">English</option>
            <option value="French">French</option>
            <option value="Arabic">Arabic</option>
            <option value="Spanish">Spanish</option>
            <option value="German">German</option>
          </select>
        </div>

        <div>
          <label
            for="length"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Description Length
          </label>

          <select
            id="length"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none"
          >
            <option value="Short">Short</option>
            <option value="Medium" selected>Medium</option>
            <option value="Long">Long</option>
          </select>
        </div>

      </div>

      <div class="mt-5 flex items-center gap-3">
        <input
          id="seo"
          type="checkbox"
          checked
          class="h-4 w-4 rounded border-white/20 bg-[#111118]"
        />

        <label
          for="seo"
          class="text-sm text-gray-300"
        >
          Optimize the description for SEO
        </label>
      </div>

      <button
        id="generateBtn"
        type="button"
        class="mt-6 w-full rounded-xl bg-white px-6 py-4 font-semibold text-black hover:bg-gray-200 disabled:cursor-not-allowed disabled:opacity-50"
      >
        ✨ Generate Product Description
      </button>

      <div
        id="loading"
        class="mt-6 hidden rounded-xl border border-white/10 bg-white/[0.03] p-6 text-center"
      >
        <div class="animate-pulse text-2xl">🛍️</div>

        <p class="mt-2 text-sm text-gray-400">
          AI is writing your product description...
        </p>
      </div>

      <div
        id="errorContainer"
        class="mt-6 hidden rounded-xl border border-red-500/20 bg-red-500/5 p-4"
      >
        <p id="errorMessage" class="text-sm text-red-400"></p>
      </div>

      <div id="resultContainer" class="mt-8 hidden">

        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">

          <h2 class="text-lg font-semibold">
            Generated Description
          </h2>

          <div class="flex gap-2">

            <button
              id="generateAgainBtn"
              type="button"
              class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 hover:bg-white/10 hover:text-white"
            >
              🔄 Generate Again
            </button>

            <button
              id="copyBtn"
              type="button"
              class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 hover:bg-white/10 hover:text-white"
            >
              📋 Copy
            </button>

          </div>

        </div>

        <div
          id="result"
          class="min-h-[300px] whitespace-pre-wrap rounded-xl border border-white/10 bg-[#111118] p-5 leading-7 text-gray-200"
        ></div>

        <button
          id="clearBtn"
          type="button"
          class="mt-4 text-sm text-gray-500 hover:text-white"
        >
          Clear result
        </button>

      </div>

    </section>

  </main>

  <script>
    const product =
      document.getElementById("product") as HTMLTextAreaElement;

    const platform =
      document.getElementById("platform") as HTMLSelectElement;

    const tone =
      document.getElementById("tone") as HTMLSelectElement;

    const language =
      document.getElementById("language") as HTMLSelectElement;

    const length =
      document.getElementById("length") as HTMLSelectElement;

    const seo =
      document.getElementById("seo") as HTMLInputElement;

    const charCount =
      document.getElementById("charCount")!;

    const generateBtn =
      document.getElementById("generateBtn") as HTMLButtonElement;

    const generateAgainBtn =
      document.getElementById("generateAgainBtn") as HTMLButtonElement;

    const loading =
      document.getElementById("loading")!;

    const errorContainer =
      document.getElementById("errorContainer")!;

    const errorMessage =
      document.getElementById("errorMessage")!;

    const resultContainer =
      document.getElementById("resultContainer")!;

    const result =
      document.getElementById("result")!;

    const copyBtn =
      document.getElementById("copyBtn") as HTMLButtonElement;

    const clearBtn =
      document.getElementById("clearBtn") as HTMLButtonElement;

    let hasGenerated = false;

    product.addEventListener("input", () => {
      charCount.textContent =
        String(product.value.length);
    });

    function showError(message: string) {
      errorMessage.textContent = message;
      errorContainer.classList.remove("hidden");
    }

    function hideError() {
      errorContainer.classList.add("hidden");
      errorMessage.textContent = "";
    }

    async function generateDescription() {
      hideError();

      const productValue =
        product.value.trim();

      if (!productValue) {
        showError(
          "Please enter your product information."
        );

        product.focus();
        return;
      }

      generateBtn.disabled = true;
      loading.classList.remove("hidden");
      resultContainer.classList.add("hidden");

      try {
        const response = await fetch(
          "/api/generate-product-description",
          {
            method: "POST",

            headers: {
              "Content-Type": "application/json",
            },

            body: JSON.stringify({
              product: productValue,
              platform: platform.value,
              tone: tone.value,
              language: language.value,
              length: length.value,
              seo: seo.checked,
            }),
          }
        );

        const data =
          await response.json();

        if (!response.ok) {
          throw new Error(
            data?.error ||
            "Failed to generate the product description."
          );
        }

        if (!data.text) {
          throw new Error(
            "The AI did not return a product description."
          );
        }

        result.textContent =
          data.text.trim();

        resultContainer.classList.remove(
          "hidden"
        );

        hasGenerated = true;

      } catch (error) {
        console.error(error);

        showError(
          error instanceof Error
            ? error.message
            : "Something went wrong."
        );

      } finally {
        generateBtn.disabled = false;
        loading.classList.add("hidden");
      }
    }

    generateBtn.addEventListener(
      "click",
      generateDescription
    );

    generateAgainBtn.addEventListener(
      "click",
      () => {
        if (hasGenerated) {
          generateDescription();
        }
      }
    );

    copyBtn.addEventListener(
      "click",
      async () => {
        const text =
          result.textContent?.trim();

        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);

          const oldText =
            copyBtn.textContent;

          copyBtn.textContent =
            "✅ Copied";

          setTimeout(() => {
            copyBtn.textContent =
              oldText;
          }, 1500);

        } catch {
          showError(
            "Could not copy the product description."
          );
        }
      }
    );

    clearBtn.addEventListener(
      "click",
      () => {
        result.textContent = "";

        resultContainer.classList.add(
          "hidden"
        );

        hideError();

        hasGenerated = false;
      }
    );
  </script>
</Layout>