---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI Translator | AIZENOVA</title>
    <meta
      name="description"
      content="Translate text quickly and naturally with AIZENOVA AI Translator."
    />
  </head>

  <body class="min-h-screen bg-[#0a0a0f] text-white">
    <main class="mx-auto max-w-4xl px-6 py-12">
      <a
        href="/ai-tools"
        class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
      >
        ← Back to AI Tools
      </a>

      <section class="mt-10 text-center">
        <div
          class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
        >
          🌍
        </div>

        <h1 class="text-4xl font-bold sm:text-5xl">
          AI Translator
        </h1>

        <p class="mx-auto mt-4 max-w-2xl text-gray-400">
          Translate your text naturally and accurately into different
          languages using AI.
        </p>
      </section>

      <section class="mt-10 rounded-2xl border border-white/10 bg-white/[0.03] p-6">
        <!-- Languages -->
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label
              for="sourceLanguage"
              class="mb-3 block text-sm font-medium text-gray-200"
            >
              Translate from
            </label>

            <select
              id="sourceLanguage"
              class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
            >
              <option value="Auto">Auto Detect</option>
              <option value="English">English</option>
              <option value="French">French</option>
              <option value="Spanish">Spanish</option>
              <option value="Arabic">Arabic</option>
              <option value="German">German</option>
              <option value="Italian">Italian</option>
              <option value="Portuguese">Portuguese</option>
              <option value="Dutch">Dutch</option>
              <option value="Chinese">Chinese</option>
              <option value="Japanese">Japanese</option>
              <option value="Korean">Korean</option>
            </select>
          </div>

          <div>
            <label
              for="targetLanguage"
              class="mb-3 block text-sm font-medium text-gray-200"
            >
              Translate to
            </label>

            <select
              id="targetLanguage"
              class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
            >
              <option value="English">English</option>
              <option value="French">French</option>
              <option value="Spanish">Spanish</option>
              <option value="Arabic">Arabic</option>
              <option value="German">German</option>
              <option value="Italian">Italian</option>
              <option value="Portuguese">Portuguese</option>
              <option value="Dutch">Dutch</option>
              <option value="Chinese">Chinese</option>
              <option value="Japanese">Japanese</option>
              <option value="Korean">Korean</option>
            </select>
          </div>
        </div>

        <!-- Input -->
        <div class="mt-6">
          <div class="flex items-center justify-between">
            <label
              for="sourceText"
              class="mb-3 block text-sm font-medium text-gray-200"
            >
              Text to translate
            </label>

            <span class="text-xs text-gray-500">
              <span id="charCount">0</span>/10000
            </span>
          </div>

          <textarea
            id="sourceText"
            rows="10"
            maxlength="10000"
            placeholder="Enter the text you want to translate..."
            class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-4 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>
        </div>

        <!-- Translate -->
        <button
          id="translateBtn"
          type="button"
          class="mt-6 w-full rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Translate
        </button>

        <!-- Loading -->
        <div
          id="loading"
          class="mt-6 hidden rounded-xl border border-white/10 bg-white/[0.03] p-6 text-center"
        >
          <div class="animate-pulse text-2xl">
            🌍
          </div>

          <p class="mt-2 text-sm text-gray-400">
            Translating your text...
          </p>

          <p class="mt-1 text-xs text-gray-500">
            This may take a few seconds.
          </p>
        </div>

        <!-- Error -->
        <div
          id="errorContainer"
          class="mt-6 hidden rounded-xl border border-red-500/20 bg-red-500/5 p-4"
        >
          <p id="errorMessage" class="text-sm text-red-400"></p>
        </div>

        <!-- Result -->
        <div id="resultContainer" class="mt-8 hidden">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-semibold">
              Translation
            </h2>

            <div class="flex flex-wrap gap-2">
              <button
                id="copyBtn"
                type="button"
                class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
              >
                📋 Copy
              </button>

              <button
                id="downloadBtn"
                type="button"
                class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
              >
                ⬇️ Download
              </button>
            </div>
          </div>

          <div
            id="result"
            class="max-h-[600px] min-h-[200px] overflow-y-auto whitespace-pre-wrap rounded-xl border border-white/10 bg-[#111118] p-5 leading-7 text-gray-200"
          ></div>

          <button
            id="clearBtn"
            type="button"
            class="mt-4 text-sm text-gray-500 transition hover:text-white"
          >
            Clear result
          </button>
        </div>
      </section>

      <!-- Features -->
      <section class="mt-10 grid gap-5 sm:grid-cols-3">
        <div
          class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
        >
          <div class="text-2xl">⚡</div>

          <h3 class="mt-3 font-semibold">
            Fast
          </h3>

          <p class="mt-2 text-sm text-gray-500">
            Translate text in seconds.
          </p>
        </div>

        <div
          class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
        >
          <div class="text-2xl">🌍</div>

          <h3 class="mt-3 font-semibold">
            Multiple Languages
          </h3>

          <p class="mt-2 text-sm text-gray-500">
            Translate between popular languages easily.
          </p>
        </div>

        <div
          class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
        >
          <div class="text-2xl">🤖</div>

          <h3 class="mt-3 font-semibold">
            AI Powered
          </h3>

          <p class="mt-2 text-sm text-gray-500">
            Natural translations powered by AI.
          </p>
        </div>
      </section>
    </main>

    <script>
      const sourceText = document.getElementById(
        "sourceText"
      ) as HTMLTextAreaElement;

      const sourceLanguage = document.getElementById(
        "sourceLanguage"
      ) as HTMLSelectElement;

      const targetLanguage = document.getElementById(
        "targetLanguage"
      ) as HTMLSelectElement;

      const translateBtn = document.getElementById(
        "translateBtn"
      ) as HTMLButtonElement;

      const loading = document.getElementById(
        "loading"
      ) as HTMLDivElement;

      const errorContainer = document.getElementById(
        "errorContainer"
      ) as HTMLDivElement;

      const errorMessage = document.getElementById(
        "errorMessage"
      ) as HTMLParagraphElement;

      const resultContainer = document.getElementById(
        "resultContainer"
      ) as HTMLDivElement;

      const result = document.getElementById(
        "result"
      ) as HTMLDivElement;

      const charCount = document.getElementById(
        "charCount"
      ) as HTMLSpanElement;

      const copyBtn = document.getElementById(
        "copyBtn"
      ) as HTMLButtonElement;

      const downloadBtn = document.getElementById(
        "downloadBtn"
      ) as HTMLButtonElement;

      const clearBtn = document.getElementById(
        "clearBtn"
      ) as HTMLButtonElement;

      sourceText.addEventListener("input", () => {
        charCount.textContent = sourceText.value.length.toString();
      });

      function showError(message: string) {
        errorMessage.textContent = message;
        errorContainer.classList.remove("hidden");
      }

      function hideError() {
        errorContainer.classList.add("hidden");
        errorMessage.textContent = "";
      }

      translateBtn.addEventListener("click", async () => {
        hideError();

        const text = sourceText.value.trim();

        if (!text) {
          showError("Please enter some text to translate.");
          sourceText.focus();
          return;
        }

        if (sourceLanguage.value === targetLanguage.value) {
          showError(
            "The source and target languages must be different."
          );
          return;
        }

        translateBtn.disabled = true;
        translateBtn.textContent = "Translating...";
        loading.classList.remove("hidden");
        resultContainer.classList.add("hidden");

        try {
          const response = await fetch("/api/translate-text", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              text,
              sourceLanguage: sourceLanguage.value,
              targetLanguage: targetLanguage.value,
            }),
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(
              data.error || "Translation failed."
            );
          }

          result.textContent = data.text || "";

          resultContainer.classList.remove("hidden");
        } catch (error) {
          showError(
            error instanceof Error
              ? error.message
              : "Something went wrong while translating."
          );
        } finally {
          translateBtn.disabled = false;
          translateBtn.textContent = "Translate";
          loading.classList.add("hidden");
        }
      });

      copyBtn.addEventListener("click", async () => {
        const text = result.textContent || "";

        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);

          const oldText = copyBtn.textContent;
          copyBtn.textContent = "✅ Copied";

          setTimeout(() => {
            copyBtn.textContent = oldText;
          }, 1500);
        } catch {
          showError("Could not copy the translation.");
        }
      });

      downloadBtn.addEventListener("click", () => {
        const text = result.textContent || "";

        if (!text) return;

        const blob = new Blob([text], {
          type: "text/plain;charset=utf-8",
        });

        const url = URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = url;
        link.download = "aizenova-translation.txt";

        document.body.appendChild(link);
        link.click();
        link.remove();

        URL.revokeObjectURL(url);
      });

      clearBtn.addEventListener("click", () => {
        result.textContent = "";
        resultContainer.classList.add("hidden");
        hideError();
      });
    </script>
  </body>
</html>