---
const tools = [
  {
    title: 'AI Text Generator',
    description:
      'Generate articles, ideas, summaries, emails, social posts, and more with AI.',
    href: '/ai-tools/text',
    icon: '✍️',
  },
  {
    title: 'AI Image Generator',
    description:
      'Create unique AI-generated images from simple text prompts.',
    href: '/ai-tools/image',
    icon: '🖼️',
  },
  {
    title: 'AI Resume Builder',
    description:
      'Create a professional resume quickly with an easy-to-use AI-powered builder.',
    href: '/ai-tools/resume-builder',
    icon: '📄',
  },
  {
    title: 'AI Email Writer',
    description:
      'Write clear and professional emails for work, business, and everyday communication.',
    href: '/ai-tools/email-writer',
    icon: '✉️',
  },
  {
    title: 'AI Summarizer',
    description:
      'Turn long articles and text into concise summaries that are easier to understand.',
    href: '/ai-tools/summarizer',
    icon: '📝',
  },
  {
    title: 'AI Proofreader',
    description:
      'Improve grammar, spelling, punctuation, clarity, and readability in your writing.',
    href: '/ai-tools/proofreader',
    icon: '✍️',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>
      AI Tools - Free AI Writing & Productivity Tools | AIZENOVA
    </title>

    <meta
      name="description"
      content="Explore AIZENOVA AI tools for writing, summarizing, proofreading, resumes, emails, images, and everyday productivity."
    />

    <meta
      name="robots"
      content="index, follow"
    />

    <link
      rel="canonical"
      href="https://aizenova.com/ai-tools"
    />

    <!-- Open Graph -->
    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:title"
      content="AI Tools - Free AI Writing & Productivity Tools | AIZENOVA"
    />

    <meta
      property="og:description"
      content="Explore AIZENOVA AI tools for writing, summarizing, proofreading, resumes, emails, images, and everyday productivity."
    />

    <meta
      property="og:url"
      content="https://aizenova.com/ai-tools"
    />

    <meta
      property="og:site_name"
      content="AIZENOVA"
    />

    <!-- Twitter -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content="AI Tools | AIZENOVA"
    />

    <meta
      name="twitter:description"
      content="Explore practical AI tools for writing, productivity, resumes, emails, summarization, and more."
    />
  </head>

  <body class="min-h-screen bg-[#0a0a0f] text-white">

    <main class="mx-auto max-w-7xl px-6 py-16">

      <!-- Header -->
      <section class="mb-14 text-center">

        <div
          class="mb-4 inline-flex rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-gray-300"
        >
          🤖 AIZENOVA AI
        </div>

        <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">
          AI Tools
        </h1>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-gray-400">
          Create, write, summarize, improve, and work smarter with powerful
          AI tools from AIZENOVA.
        </p>

      </section>

      <!-- Tools -->
      <section
        aria-label="AIZENOVA AI Tools"
        class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"
      >

        {tools.map((tool) => (
          <a
            href={tool.href}
            class="group rounded-3xl border border-white/10 bg-white/[0.03] p-8 transition duration-300 hover:-translate-y-1 hover:border-white/20 hover:bg-white/[0.06]"
          >

            <div
              class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
              aria-hidden="true"
            >
              {tool.icon}
            </div>

            <h2 class="text-2xl font-semibold">
              {tool.title}
            </h2>

            <p class="mt-3 leading-7 text-gray-400">
              {tool.description}
            </p>

            <div
              class="mt-7 inline-flex items-center gap-2 font-medium text-white"
            >
              Start Creating

              <span
                aria-hidden="true"
                class="transition-transform group-hover:translate-x-1"
              >
                →
              </span>
            </div>

          </a>
        ))}

      </section>

      <!-- Information -->
      <section
        class="mt-16 rounded-3xl border border-white/10 bg-white/[0.03] p-8 text-center"
      >

        <h2 class="text-2xl font-semibold">
          Create with AI
        </h2>

        <p class="mx-auto mt-3 max-w-2xl text-gray-400">
          AIZENOVA AI Tools are designed to make content creation
          faster, easier, and more accessible for students, creators,
          professionals, and businesses.
        </p>

      </section>

    </main>

  </body>
</html>