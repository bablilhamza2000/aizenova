---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'AI Tools - Free AI Writing & Productivity Tools',
  description:
    'Explore AIZENOVA AI tools for writing, summarizing, proofreading, resumes, emails, and everyday productivity.',
};

const tools = [
  {
    title: 'AI Text Generator',
    description:
      'Generate articles, ideas, summaries, emails, social posts, and more with AI.',
    href: '/ai-tools/text',
    icon: '✍️',
  },
  {
    title: 'AI Resume Builder',
    description:
      'Create a professional resume quickly with an easy-to-use AI-powered builder.',
    href: '/ai-tools/resume-builder',
    icon: '📄',
  },
  {
    title: 'AI Email Writer',
    description:
      'Write clear and professional emails for work, business, and everyday communication.',
    href: '/ai-tools/email-writer',
    icon: '✉️',
  },
  {
    title: 'AI Summarizer',
    description:
      'Turn long articles and text into concise summaries that are easier to understand.',
    href: '/ai-tools/summarizer',
    icon: '📝',
  },
  {
    title: 'AI Proofreader',
    description:
      'Improve grammar, spelling, punctuation, clarity, and readability in your writing.',
    href: '/ai-tools/proofreader',
    icon: '🔎',
  },
];

---

<Layout metadata={metadata}>
  <main class="min-h-screen bg-page text-page">
    <section class="mx-auto max-w-7xl px-6 py-16 sm:py-20">

      <div class="mx-auto max-w-3xl text-center">

        <div
          class="mb-5 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-4 py-2 text-sm font-medium text-primary"
        >
          🤖 AIZENOVA AI
        </div>

        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          AI Tools
        </h1>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-muted">
          Create, write, summarize, improve, and work smarter with powerful AI
          tools from AIZENOVA.
        </p>

      </div>

      <div
        class="mx-auto mt-12 grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-3"
      >

        {tools.map((tool) => (
          <a
            href={tool.href}
            class="group rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-xl dark:border-gray-700 dark:bg-gray-900"
          >

            <div
              class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-2xl"
              aria-hidden="true"
            >
              {tool.icon}
            </div>

            <h2 class="mt-6 text-xl font-semibold">
              {tool.title}
            </h2>

            <p class="mt-3 leading-7 text-muted">
              {tool.description}
            </p>

            <div
              class="mt-6 inline-flex items-center gap-2 font-semibold text-primary"
            >
              Start Creating

              <span
                aria-hidden="true"
                class="transition-transform duration-200 group-hover:translate-x-1"
              >
                →
              </span>
            </div>

          </a>
        ))}

      </div>

      <div
        class="mx-auto mt-14 max-w-4xl rounded-3xl border border-gray-200 bg-white p-8 text-center shadow-sm dark:border-gray-700 dark:bg-gray-900 sm:p-10"
      >

        <div class="text-3xl" aria-hidden="true">
          ✨
        </div>

        <h2 class="mt-4 text-2xl font-bold">
          Create with AI
        </h2>

        <p class="mx-auto mt-3 max-w-2xl leading-7 text-muted">
          AIZENOVA AI Tools are designed to make content creation faster,
          easier, and more accessible for students, creators, professionals,
          and businesses.
        </p>

      </div>

      <div class="mt-10 text-center">

        <a
          href="/"
          class="inline-flex items-center gap-2 font-semibold text-primary transition hover:opacity-80"
        >
          ← Back to AIZENOVA
        </a>

      </div>

    </section>
  </main>
</Layout>