---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="AI Title Generator | AIZENOVA">
  <main class="mx-auto max-w-4xl px-6 py-16 text-white">

    <a
      href="/ai-tools"
      class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
    >
      ← Back to AI Tools
    </a>

    <div class="mt-10 text-center">

      <div
        class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
      >
        📝
      </div>

      <h1 class="text-4xl font-bold sm:text-5xl">
        AI Title Generator
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-gray-400">
        Generate catchy and engaging titles for your blog posts,
        videos, articles, and social media content.
      </p>

    </div>

    <section class="mt-12 rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8">

      <!-- Topic -->
      <div>

        <label
          for="topic"
          class="mb-3 block text-sm font-medium text-gray-200"
        >
          Topic or Keyword
        </label>

        <textarea
          id="topic"
          rows="5"
          maxlength="2000"
          placeholder="Example: artificial intelligence for small businesses"
          class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-4 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
        ></textarea>

        <div class="mt-2 flex justify-between text-xs text-gray-500">
          <span>Be specific for better titles.</span>
          <span>
            <span id="charCount">0</span>/2000
          </span>
        </div>

      </div>


      <!-- Options -->
      <div class="mt-6 grid gap-5 sm:grid-cols-3">

        <!-- Language -->
        <div>

          <label
            for="language"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Language
          </label>

          <select
            id="language"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="English">English</option>
            <option value="French">French</option>
            <option value="Arabic">Arabic</option>
            <option value="Spanish">Spanish</option>
            <option value="German">German</option>
            <option value="Italian">Italian</option>
          </select>

        </div>


        <!-- Tone -->
        <div>

          <label
            for="tone"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Tone
          </label>

          <select
            id="tone"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="Professional">Professional</option>
            <option value="Catchy">Catchy</option>
            <option value="Creative">Creative</option>
            <option value="Curious">Curious</option>
            <option value="Persuasive">Persuasive</option>
            <option value="Casual">Casual</option>
          </select>

        </div>


        <!-- Number -->
        <div>

          <label
            for="count"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Number of Titles
          </label>

          <select
            id="count"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="5">5 Titles</option>
            <option value="10" selected>10 Titles</option>
            <option value="15">15 Titles</option>
            <option value="20">20 Titles</option>
          </select>

        </div>

      </div>


      <!-- Generate -->
      <button
        id="generateBtn"
        type="button"
        class="mt-6 w-full rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200 disabled:cursor-not-allowed disabled:opacity-50"
      >
        ✨ Generate Titles
      </button>


      <!-- Loading -->
      <div
        id="loading"
        class="mt-6 hidden rounded-xl border border-white/10 bg-white/[0.03] p-6 text-center"
      >

        <div class="animate-pulse text-2xl">
          ✨
        </div>

        <p class="mt-2 text-sm text-gray-400">
          AI is generating your titles...
        </p>

        <p class="mt-1 text-xs text-gray-500">
          This may take a few seconds.
        </p>

      </div>


      <!-- Error -->
      <div
        id="errorContainer"
        class="mt-6 hidden rounded-xl border border-red-500/20 bg-red-500/5 p-4"
      >

        <p
          id="errorMessage"
          class="text-sm text-red-400"
        ></p>

      </div>


      <!-- Results -->
      <div
        id="resultContainer"
        class="mt-8 hidden"
      >

        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">

          <h2 class="text-lg font-semibold">
            Generated Titles
          </h2>

          <div class="flex flex-wrap gap-2">

            <button
              id="regenerateBtn"
              type="button"
              class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
            >
              🔄 Regenerate
            </button>

            <button
              id="copyBtn"
              type="button"
              class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
            >
              📋 Copy
            </button>

          </div>

        </div>


        <div
          id="result"
          class="min-h-[250px] whitespace-pre-wrap rounded-xl border border-white/10 bg-[#111118] p-5 leading-8 text-gray-200"
        ></div>


        <button
          id="clearBtn"
          type="button"
          class="mt-4 text-sm text-gray-500 transition hover:text-white"
        >
          Clear result
        </button>

      </div>

    </section>


    <!-- Features -->
    <section class="mt-10 grid gap-5 sm:grid-cols-3">

      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
        <div class="text-2xl">⚡</div>

        <h3 class="mt-3 font-semibold">
          Fast
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Generate multiple title ideas in seconds.
        </p>
      </div>


      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
        <div class="text-2xl">🎯</div>

        <h3 class="mt-3 font-semibold">
          Engaging
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Create titles designed to grab attention.
        </p>
      </div>


      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
        <div class="text-2xl">📋</div>

        <h3 class="mt-3 font-semibold">
          Easy to Use
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Generate and copy your favorite titles easily.
        </p>
      </div>

    </section>

  </main>


  <script>
    const topic = document.getElementById("topic") as HTMLTextAreaElement;
    const language = document.getElementById("language") as HTMLSelectElement;
    const tone = document.getElementById("tone") as HTMLSelectElement;
    const count = document.getElementById("count") as HTMLSelectElement;

    const charCount = document.getElementById("charCount")!;
    const generateBtn = document.getElementById("generateBtn") as HTMLButtonElement;

    const loading = document.getElementById("loading")!;
    const errorContainer = document.getElementById("errorContainer")!;
    const errorMessage = document.getElementById("errorMessage")!;

    const resultContainer = document.getElementById("resultContainer")!;
    const result = document.getElementById("result")!;

    const copyBtn = document.getElementById("copyBtn") as HTMLButtonElement;
    const regenerateBtn = document.getElementById("regenerateBtn") as HTMLButtonElement;
    const clearBtn = document.getElementById("clearBtn") as HTMLButtonElement;

    let lastRequest = false;

    topic.addEventListener("input", () => {
      charCount.textContent = String(topic.value.length);
    });

    function showError(message: string) {
      errorMessage.textContent = message;
      errorContainer.classList.remove("hidden");
    }

    function hideError() {
      errorContainer.classList.add("hidden");
      errorMessage.textContent = "";
    }

    async function generateTitles() {
      const value = topic.value.trim();

      hideError();

      if (!value) {
        showError("Please enter a topic or keyword.");
        topic.focus();
        return;
      }

      generateBtn.disabled = true;
      loading.classList.remove("hidden");
      resultContainer.classList.add("hidden");

      try {
        const response = await fetch("/api/generate-titles", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            topic: value,
            language: language.value,
            tone: tone.value,
            count: Number(count.value),
          }),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(
            data?.error || "Failed to generate titles."
          );
        }

        result.textContent = data.text || "";

        resultContainer.classList.remove("hidden");

        lastRequest = true;

      } catch (error) {
        console.error(error);

        showError(
          error instanceof Error
            ? error.message
            : "Something went wrong."
        );

      } finally {
        generateBtn.disabled = false;
        loading.classList.add("hidden");
      }
    }

    generateBtn.addEventListener("click", generateTitles);

    regenerateBtn.addEventListener("click", () => {
      if (lastRequest) {
        generateTitles();
      }
    });

    copyBtn.addEventListener("click", async () => {
      const text = result.textContent?.trim();

      if (!text) {
        return;
      }

      try {
        await navigator.clipboard.writeText(text);

        const oldText = copyBtn.textContent;

        copyBtn.textContent = "✅ Copied";

        setTimeout(() => {
          copyBtn.textContent = oldText;
        }, 1500);

      } catch {
        showError("Could not copy the titles.");
      }
    });

    clearBtn.addEventListener("click", () => {
      result.textContent = "";
      resultContainer.classList.add("hidden");
      hideError();
      lastRequest = false;
    });
  </script>
</Layout>