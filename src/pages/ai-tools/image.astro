---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>AI Image Generator | AIZENOVA</title>

    <meta
      name="description"
      content="Create unique AI-generated images from text prompts with AIZENOVA AI Image Generator."
    />
  </head>

  <body class="min-h-screen bg-[#0a0a0f] text-white">

    <main class="mx-auto max-w-6xl px-6 py-12">

      <!-- Back -->
      <a
        href="/ai-tools"
        class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
      >
        ← Back to AI Tools
      </a>


      <!-- Header -->
      <section class="mt-10 text-center">

        <div
          class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
        >
          🖼️
        </div>

        <h1 class="text-4xl font-bold sm:text-5xl">
          AI Image Generator
        </h1>

        <p class="mx-auto mt-4 max-w-2xl text-gray-400">
          Turn your ideas into unique AI-generated images using a simple
          text prompt.
        </p>

      </section>


      <!-- Generator -->
      <section class="mx-auto mt-12 max-w-4xl rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:p-8">

        <!-- Prompt -->
        <div>

          <label
            for="prompt"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Describe the image you want
          </label>

          <textarea
            id="prompt"
            rows="6"
            placeholder="Example: A futuristic city at night, neon lights, cinematic atmosphere, ultra realistic..."
            class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-4 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>

          <div class="mt-2 text-right text-xs text-gray-500">
            <span id="charCount">0</span> characters
          </div>

        </div>


        <!-- Options -->
        <div class="mt-6 grid gap-4 sm:grid-cols-2">

          <!-- Aspect Ratio -->
          <div>

            <label
              for="aspectRatio"
              class="mb-2 block text-sm font-medium text-gray-200"
            >
              Aspect Ratio
            </label>

            <select
              id="aspectRatio"
              class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
            >
              <option value="1:1">Square (1:1)</option>
              <option value="16:9">Landscape (16:9)</option>
              <option value="9:16">Portrait (9:16)</option>
              <option value="4:3">Standard (4:3)</option>
              <option value="3:4">Portrait (3:4)</option>
            </select>

          </div>


          <!-- Style -->
          <div>

            <label
              for="style"
              class="mb-2 block text-sm font-medium text-gray-200"
            >
              Style
            </label>

            <select
              id="style"
              class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
            >
              <option value="realistic">Realistic</option>
              <option value="cinematic">Cinematic</option>
              <option value="digital-art">Digital Art</option>
              <option value="anime">Anime</option>
              <option value="3d">3D Render</option>
              <option value="illustration">Illustration</option>
            </select>

          </div>

        </div>


        <!-- Generate -->
        <button
          id="generateBtn"
          type="button"
          class="mt-6 w-full rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Generate Image
        </button>


        <!-- Loading -->
        <div
          id="loading"
          class="mt-6 hidden rounded-xl border border-white/10 bg-white/[0.03] p-8 text-center"
        >

          <div class="animate-pulse text-4xl">
            ✨
          </div>

          <p class="mt-3 text-sm text-gray-400">
            AI is creating your image...
          </p>

          <p class="mt-1 text-xs text-gray-600">
            This may take a few seconds.
          </p>

        </div>


        <!-- Result -->
        <div
          id="resultContainer"
          class="mt-8 hidden"
        >

          <div class="mb-4 flex items-center justify-between">

            <h2 class="text-lg font-semibold">
              Generated Image
            </h2>

            <button
              id="downloadBtn"
              type="button"
              class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
            >
              Download
            </button>

          </div>


          <div
            class="overflow-hidden rounded-2xl border border-white/10 bg-[#111118]"
          >

            <img
              id="generatedImage"
              src=""
              alt="AI generated image"
              class="mx-auto block max-h-[700px] w-auto object-contain"
            />

          </div>

        </div>

      </section>


      <!-- Info -->
      <section class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-3">

        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">🎨</div>

          <h3 class="mt-3 font-semibold">
            Creative
          </h3>

          <p class="mt-2 text-sm text-gray-500">
            Turn your ideas into unique visuals.
          </p>
        </div>


        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">⚡</div>

          <h3 class="mt-3 font-semibold">
            Fast
          </h3>

          <p class="mt-2 text-sm text-gray-500">
            Generate images in seconds.
          </p>
        </div>


        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">✨</div>

          <h3 class="mt-3 font-semibold">
            AI Powered
          </h3>

          <p class="mt-2 text-sm text-gray-500">
            Create images using powerful AI models.
          </p>
        </div>

      </section>

    </main>


    <script>

      const promptInput =
        document.getElementById('prompt');

      const charCount =
        document.getElementById('charCount');

      const generateBtn =
        document.getElementById('generateBtn');

      const loading =
        document.getElementById('loading');

      const resultContainer =
        document.getElementById('resultContainer');

      const generatedImage =
        document.getElementById('generatedImage');

      const downloadBtn =
        document.getElementById('downloadBtn');


      promptInput?.addEventListener('input', () => {

        charCount.textContent =
          promptInput.value.length;

      });


      generateBtn?.addEventListener('click', async () => {

        const prompt =
          promptInput.value.trim();


        if (!prompt) {

          alert('Please describe the image you want.');

          return;

        }


        const aspectRatio =
          document.getElementById('aspectRatio').value;

        const style =
          document.getElementById('style').value;


        generateBtn.disabled = true;

        loading.classList.remove('hidden');

        resultContainer.classList.add('hidden');


        try {

          const response =
            await fetch('/api/generate-image', {

              method: 'POST',

              headers: {
                'Content-Type': 'application/json',
              },

              body: JSON.stringify({

                prompt,

                aspectRatio,

                style,

              }),

            });


          const data =
            await response.json();


          if (!response.ok) {

            throw new Error(
              data.error ||
              'Failed to generate image.'
            );

          }


          if (!data.image) {

            throw new Error(
              'No image was returned.'
            );

          }


          generatedImage.src =
            data.image;


          resultContainer.classList.remove(
            'hidden'
          );


        } catch (error) {

          console.error(
            'Image generation error:',
            error
          );


          alert(
            error instanceof Error
              ? error.message
              : 'Failed to generate image.'
          );


        } finally {

          loading.classList.add('hidden');

          generateBtn.disabled = false;

        }

      });


      downloadBtn?.addEventListener(
        'click',
        async () => {

          const imageUrl =
            generatedImage.src;


          if (!imageUrl) return;


          try {

            const response =
              await fetch(imageUrl);

            const blob =
              await response.blob();


            const url =
              URL.createObjectURL(blob);


            const link =
              document.createElement('a');


            link.href = url;

            link.download =
              'aizenova-ai-image.png';


            document.body.appendChild(link);

            link.click();

            link.remove();


            URL.revokeObjectURL(url);


          } catch (error) {

            console.error(
              'Download error:',
              error
            );

          }

        }
      );

    </script>

  </body>
</html>