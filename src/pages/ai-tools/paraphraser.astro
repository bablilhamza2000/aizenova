---
const title = "AI Paraphraser";
const description =
  "Rewrite and improve your text with AI while keeping the original meaning.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | AIZENOVA</title>
    <meta name="description" content={description} />
  </head>

  <body class="min-h-screen bg-[#09090f] text-white">
    <main class="mx-auto max-w-5xl px-6 py-12">

      <!-- Back -->
      <a
        href="/ai-tools"
        class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
      >
        ← Back to AI Tools
      </a>

      <!-- Header -->
      <section class="mx-auto mt-10 max-w-3xl text-center">

        <div
          class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
        >
          ✍️
        </div>

        <h1 class="text-4xl font-bold sm:text-5xl">
          AI Paraphraser
        </h1>

        <p class="mx-auto mt-4 max-w-2xl text-gray-400">
          Rewrite your text with AI while keeping the original meaning.
        </p>

      </section>

      <!-- Tool -->
      <section
        class="mx-auto mt-10 max-w-3xl rounded-2xl border border-white/10 bg-white/[0.03] p-6"
      >

        <!-- Language -->
        <div>
          <label
            for="language"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Language
          </label>

          <select
            id="language"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="English">English</option>
            <option value="French">French</option>
            <option value="Arabic">Arabic</option>
            <option value="Spanish">Spanish</option>
            <option value="German">German</option>
            <option value="Italian">Italian</option>
          </select>
        </div>

        <!-- Style -->
        <div class="mt-6">

          <label
            for="style"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Writing Style
          </label>

          <select
            id="style"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="Natural">Natural</option>
            <option value="Professional">Professional</option>
            <option value="Simple">Simple</option>
            <option value="Academic">Academic</option>
            <option value="Creative">Creative</option>
            <option value="Casual">Casual</option>
          </select>

        </div>

        <!-- Input -->
        <div class="mt-6">

          <div class="flex items-center justify-between gap-3">

            <label
              for="textInput"
              class="block text-sm font-medium text-gray-200"
            >
              Text to paraphrase
            </label>

            <span class="text-xs text-gray-500">
              <span id="charCount">0</span>/10000
            </span>

          </div>

          <textarea
            id="textInput"
            rows="10"
            maxlength="10000"
            placeholder="Paste the text you want to rewrite..."
            class="mt-3 w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-4 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>

        </div>

        <!-- Generate -->
        <button
          id="paraphraseBtn"
          type="button"
          class="mt-6 w-full rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200 disabled:cursor-not-allowed disabled:opacity-50"
        >
          ✨ Paraphrase Text
        </button>

        <!-- Loading -->
        <div
          id="loading"
          class="mt-6 hidden rounded-xl border border-white/10 bg-white/[0.03] p-6 text-center"
        >
          <div class="animate-pulse text-2xl">
            ✨
          </div>

          <p class="mt-2 text-sm text-gray-400">
            AI is rewriting your text...
          </p>

          <p class="mt-1 text-xs text-gray-500">
            This may take a few seconds.
          </p>
        </div>

        <!-- Error -->
        <div
          id="errorContainer"
          class="mt-6 hidden rounded-xl border border-red-500/20 bg-red-500/5 p-4"
        >
          <p id="errorMessage" class="text-sm text-red-400"></p>
        </div>

        <!-- Result -->
        <div id="resultContainer" class="mt-8 hidden">

          <div class="mb-3 flex flex-wrap items-center justify-between gap-3">

            <h2 class="text-lg font-semibold">
              Paraphrased Text
            </h2>

            <div class="flex flex-wrap gap-2">

              <button
                id="regenerateBtn"
                type="button"
                class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
              >
                🔄 Regenerate
              </button>

              <button
                id="copyBtn"
                type="button"
                class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
              >
                📋 Copy
              </button>

              <button
                id="downloadBtn"
                type="button"
                class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
              >
                ⬇️ Download
              </button>

            </div>

          </div>

          <div
            id="result"
            class="max-h-[650px] min-h-[250px] overflow-y-auto whitespace-pre-wrap rounded-xl border border-white/10 bg-[#111118] p-5 leading-7 text-gray-200"
          ></div>

          <button
            id="clearBtn"
            type="button"
            class="mt-4 text-sm text-gray-500 transition hover:text-white"
          >
            Clear result
          </button>

        </div>

      </section>

      <!-- Features -->
      <section class="mx-auto mt-10 grid max-w-3xl gap-5 sm:grid-cols-3">

        <div
          class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
        >
          <div class="text-2xl">✍️</div>

          <h3 class="mt-3 font-semibold">
            Rewrite
          </h3>

          <p class="mt-2 text-sm text-gray-500">
            Rewrite text while preserving its meaning.
          </p>
        </div>

        <div
          class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
        >
          <div class="text-2xl">🎯</div>

          <h3 class="mt-3 font-semibold">
            Multiple Styles
          </h3>

          <p class="mt-2 text-sm text-gray-500">
            Choose the writing style that fits your needs.
          </p>
        </div>

        <div
          class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
        >
          <div class="text-2xl">📋</div>

          <h3 class="mt-3 font-semibold">
            Easy to Copy
          </h3>

          <p class="mt-2 text-sm text-gray-500">
            Copy or download your rewritten text instantly.
          </p>
        </div>

      </section>

    </main>

    <script>
      const textInput =
        document.getElementById("textInput") as HTMLTextAreaElement;

      const language =
        document.getElementById("language") as HTMLSelectElement;

      const style =
        document.getElementById("style") as HTMLSelectElement;

      const paraphraseBtn =
        document.getElementById("paraphraseBtn") as HTMLButtonElement;

      const regenerateBtn =
        document.getElementById("regenerateBtn") as HTMLButtonElement;

      const copyBtn =
        document.getElementById("copyBtn") as HTMLButtonElement;

      const downloadBtn =
        document.getElementById("downloadBtn") as HTMLButtonElement;

      const clearBtn =
        document.getElementById("clearBtn") as HTMLButtonElement;

      const charCount =
        document.getElementById("charCount") as HTMLSpanElement;

      const loading =
        document.getElementById("loading") as HTMLDivElement;

      const errorContainer =
        document.getElementById("errorContainer") as HTMLDivElement;

      const errorMessage =
        document.getElementById("errorMessage") as HTMLParagraphElement;

      const resultContainer =
        document.getElementById("resultContainer") as HTMLDivElement;

      const result =
        document.getElementById("result") as HTMLDivElement;

      function updateCharCount() {
        charCount.textContent = textInput.value.length.toString();
      }

      function showError(message: string) {
        errorMessage.textContent = message;
        errorContainer.classList.remove("hidden");
      }

      function hideError() {
        errorContainer.classList.add("hidden");
        errorMessage.textContent = "";
      }

      async function paraphraseText() {
        const text = textInput.value.trim();

        hideError();

        if (!text) {
          showError("Please enter some text to paraphrase.");
          textInput.focus();
          return;
        }

        if (text.length > 10000) {
          showError(
            "The text is too long. Maximum 10,000 characters."
          );
          return;
        }

        paraphraseBtn.disabled = true;
        regenerateBtn.disabled = true;

        loading.classList.remove("hidden");
        resultContainer.classList.add("hidden");

        try {
          const response = await fetch("/api/paraphrase-text", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              text,
              language: language.value,
              style: style.value,
            }),
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(
              data.error || "Failed to paraphrase text."
            );
          }

          result.textContent = data.text || data.paraphrase || "";

          resultContainer.classList.remove("hidden");
        } catch (error) {
          console.error(error);

          showError(
            error instanceof Error
              ? error.message
              : "Something went wrong."
          );
        } finally {
          loading.classList.add("hidden");
          paraphraseBtn.disabled = false;
          regenerateBtn.disabled = false;
        }
      }

      textInput.addEventListener("input", updateCharCount);

      paraphraseBtn.addEventListener("click", paraphraseText);

      regenerateBtn.addEventListener("click", paraphraseText);

      copyBtn.addEventListener("click", async () => {
        const text = result.textContent?.trim();

        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);

          const original = copyBtn.textContent;
          copyBtn.textContent = "✅ Copied!";

          setTimeout(() => {
            copyBtn.textContent = original;
          }, 1500);
        } catch {
          showError("Could not copy the text.");
        }
      });

      downloadBtn.addEventListener("click", () => {
        const text = result.textContent?.trim();

        if (!text) return;

        const blob = new Blob([text], {
          type: "text/plain;charset=utf-8",
        });

        const url = URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = url;
        link.download = "paraphrased-text.txt";

        document.body.appendChild(link);
        link.click();
        link.remove();

        URL.revokeObjectURL(url);
      });

      clearBtn.addEventListener("click", () => {
        result.textContent = "";
        resultContainer.classList.add("hidden");
      });

      updateCharCount();
    </script>
  </body>
</html>