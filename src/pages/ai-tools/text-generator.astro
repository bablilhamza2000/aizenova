---
---

<main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">

  <!-- Back -->
  <a
    href="/ai-tools"
    class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
  >
    ← Back to AI Tools
  </a>

  <!-- Header -->
  <section class="mt-8 text-center sm:mt-10">

    <div
      class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
    >
      ✍️
    </div>

    <h1 class="text-3xl font-bold sm:text-5xl">
      AI Text Generator
    </h1>

    <p class="mx-auto mt-4 max-w-2xl text-sm leading-6 text-gray-400 sm:text-base">
      Generate high-quality text for your website, blog,
      social media, emails, and more.
    </p>

  </section>

  <!-- Generator -->
  <section
    class="mt-8 rounded-2xl border border-white/10 bg-white/[0.03] p-4 sm:mt-12 sm:rounded-3xl sm:p-8"
  >

    <!-- Type -->
    <div>

      <label
        for="textType"
        class="mb-3 block text-sm font-medium text-gray-200"
      >
        What do you want to create?
      </label>

      <select
        id="textType"
        class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
      >
        <option value="blog">Blog Article</option>
        <option value="idea">Content Ideas</option>
        <option value="social">Social Media Post</option>
        <option value="email">Email</option>
        <option value="description">Product Description</option>
        <option value="summary">Summary</option>
      </select>

    </div>

    <!-- Options -->
    <div class="mt-6 grid gap-5 sm:grid-cols-3">

      <!-- Language -->
      <div>

        <label
          for="language"
          class="mb-3 block text-sm font-medium text-gray-200"
        >
          Language
        </label>

        <select
          id="language"
          class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
        >
          <option value="English">English</option>
          <option value="French">French</option>
          <option value="Arabic">Arabic</option>
          <option value="Spanish">Spanish</option>
          <option value="German">German</option>
          <option value="Italian">Italian</option>
        </select>

      </div>

      <!-- Tone -->
      <div>

        <label
          for="tone"
          class="mb-3 block text-sm font-medium text-gray-200"
        >
          Tone
        </label>

        <select
          id="tone"
          class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
        >
          <option value="Professional">Professional</option>
          <option value="Friendly">Friendly</option>
          <option value="Casual">Casual</option>
          <option value="Persuasive">Persuasive</option>
          <option value="Creative">Creative</option>
          <option value="Academic">Academic</option>
        </select>

      </div>

      <!-- Length -->
      <div>

        <label
          for="length"
          class="mb-3 block text-sm font-medium text-gray-200"
        >
          Length
        </label>

        <select
          id="length"
          class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
        >
          <option value="Short">Short</option>
          <option value="Medium" selected>Medium</option>
          <option value="Long">Long</option>
        </select>

      </div>

    </div>

    <!-- Prompt -->
    <div class="mt-6">

      <label
        for="prompt"
        class="mb-3 block text-sm font-medium text-gray-200"
      >
        What should the AI write?
      </label>

      <textarea
        id="prompt"
        rows="8"
        maxlength="5000"
        placeholder="Example: Write a beginner-friendly article about the benefits of artificial intelligence for small businesses."
        class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-4 text-sm leading-6 text-white placeholder-gray-500 outline-none transition focus:border-white/30 sm:text-base"
      ></textarea>

      <div class="mt-2 flex justify-between text-xs text-gray-500">

        <span>
          Be specific for better results.
        </span>

        <span>
          <span id="charCount">0</span>/5000
        </span>

      </div>

    </div>

    <!-- Generate Button -->
    <button
      id="generateBtn"
      type="button"
      class="mt-6 w-full rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200 disabled:cursor-not-allowed disabled:opacity-50"
    >
      Generate Text
    </button>

    <!-- Loading -->
    <div
      id="loading"
      class="mt-6 hidden rounded-xl border border-white/10 bg-white/[0.03] p-6 text-center"
    >

      <div class="animate-pulse text-2xl">
        ✨
      </div>

      <p class="mt-2 text-sm text-gray-400">
        AI is generating your content...
      </p>

      <p class="mt-1 text-xs text-gray-500">
        This may take a few seconds.
      </p>

    </div>

    <!-- Error -->
    <div
      id="errorContainer"
      class="mt-6 hidden rounded-xl border border-red-500/20 bg-red-500/5 p-4"
    >

      <p
        id="errorMessage"
        class="text-sm leading-6 text-red-400"
      ></p>

    </div>

    <!-- Result -->
    <div
      id="resultContainer"
      class="mt-8 hidden"
    >

      <!-- Result Header -->
      <div
        class="mb-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
      >

        <h2 class="text-lg font-semibold">
          Generated Content
        </h2>

        <div class="flex flex-wrap gap-2">

          <!-- Regenerate -->
          <button
            id="regenerateBtn"
            type="button"
            class="rounded-lg border border-white/10 px-3 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
          >
            🔄 Regenerate
          </button>

          <!-- Copy -->
          <button
            id="copyBtn"
            type="button"
            class="rounded-lg border border-white/10 px-3 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
          >
            📋 Copy
          </button>

          <!-- Download -->
          <button
            id="downloadBtn"
            type="button"
            class="rounded-lg border border-white/10 px-3 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
          >
            ⬇️ Download
          </button>

        </div>

      </div>

      <!-- Result Content -->
      <div
        id="result"
        class="max-h-[650px] min-h-[250px] overflow-y-auto whitespace-pre-wrap break-words rounded-xl border border-white/10 bg-[#111118] p-4 text-sm leading-7 text-gray-200 sm:p-5 sm:text-base"
      ></div>

      <!-- Clear -->
      <button
        id="clearBtn"
        type="button"
        class="mt-4 text-sm text-gray-500 transition hover:text-white"
      >
        Clear result
      </button>

    </div>

  </section>

  <!-- Info -->
  <section class="mt-8 grid gap-4 sm:mt-10 sm:grid-cols-3">

    <div
      class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
    >
      <div class="text-2xl">
        ⚡
      </div>

      <h3 class="mt-3 font-semibold">
        Fast
      </h3>

      <p class="mt-2 text-sm leading-6 text-gray-500">
        Generate content in seconds.
      </p>

    </div>

    <div
      class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
    >
      <div class="text-2xl">
        🤖
      </div>

      <h3 class="mt-3 font-semibold">
        AI Powered
      </h3>

      <p class="mt-2 text-sm leading-6 text-gray-500">
        Create useful content with AI.
      </p>

    </div>

    <div
      class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
    >
      <div class="text-2xl">
        📋
      </div>

      <h3 class="mt-3 font-semibold">
        Easy to Use
      </h3>

      <p class="mt-2 text-sm leading-6 text-gray-500">
        Generate and copy your content easily.
      </p>

    </div>

  </section>

</main>

<script>
  // ==========================================
  // ELEMENTS
  // ==========================================

  const promptInput =
    document.getElementById("prompt");

  const charCount =
    document.getElementById("charCount");

  const textType =
    document.getElementById("textType");

  const language =
    document.getElementById("language");

  const tone =
    document.getElementById("tone");

  const length =
    document.getElementById("length");

  const generateBtn =
    document.getElementById("generateBtn");

  const regenerateBtn =
    document.getElementById("regenerateBtn");

  const loading =
    document.getElementById("loading");

  const errorContainer =
    document.getElementById("errorContainer");

  const errorMessage =
    document.getElementById("errorMessage");

  const resultContainer =
    document.getElementById("resultContainer");

  const result =
    document.getElementById("result");

  const copyBtn =
    document.getElementById("copyBtn");

  const downloadBtn =
    document.getElementById("downloadBtn");

  const clearBtn =
    document.getElementById("clearBtn");


  // ==========================================
  // CHARACTER COUNTER
  // ==========================================

  promptInput?.addEventListener(
    "input",
    () => {
      if (promptInput && charCount) {
        charCount.textContent =
          promptInput.value.length.toString();
      }
    }
  );


  // ==========================================
  // SHOW ERROR
  // ==========================================

  function showError(message) {
    if (errorMessage) {
      errorMessage.textContent = message;
    }

    errorContainer?.classList.remove("hidden");
  }


  // ==========================================
  // HIDE ERROR
  // ==========================================

  function hideError() {
    errorContainer?.classList.add("hidden");

    if (errorMessage) {
      errorMessage.textContent = "";
    }
  }


  // ==========================================
  // GENERATE FUNCTION
  // ==========================================

  async function generateText() {
    if (
      !promptInput ||
      !textType ||
      !language ||
      !tone ||
      !length ||
      !generateBtn
    ) {
      return;
    }

    const prompt =
      promptInput.value.trim();

    // -----------------------------
    // Validate prompt
    // -----------------------------

    if (!prompt) {
      showError("Please enter a prompt.");
      promptInput.focus();
      return;
    }

    if (prompt.length > 5000) {
      showError(
        "Prompt is too long. Maximum 5000 characters."
      );
      return;
    }

    // -----------------------------
    // Hide previous states
    // -----------------------------

    hideError();

    resultContainer?.classList.add("hidden");

    // -----------------------------
    // Loading state
    // -----------------------------

    generateBtn.disabled = true;

    if (regenerateBtn) {
      regenerateBtn.disabled = true;
    }

    generateBtn.textContent =
      "Generating...";

    loading?.classList.remove("hidden");

    try {
      // -----------------------------
      // API request
      // -----------------------------

      const response = await fetch(
        "/api/generate-text",
        {
          method: "POST",

          headers: {
            "Content-Type":
              "application/json",
          },

          body: JSON.stringify({
            prompt: prompt,

            // IMPORTANT:
            // API expects textType
            textType:
              textType.value,

            language:
              language.value,

            tone:
              tone.value,

            length:
              length.value,
          }),
        }
      );

      // -----------------------------
      // Read response safely
      // -----------------------------

      const contentType =
        response.headers.get(
          "content-type"
        ) || "";

      let data = null;

      if (
        contentType.includes(
          "application/json"
        )
      ) {
        data = await response.json();
      } else {
        const text =
          await response.text();

        throw new Error(
          text ||
          `Request failed with status ${response.status}.`
        );
      }

      // -----------------------------
      // API error
      // -----------------------------

      if (!response.ok) {
        throw new Error(
          data?.error ||
          `Request failed with status ${response.status}.`
        );
      }

      // -----------------------------
      // Empty result
      // -----------------------------

      if (
        !data ||
        typeof data.text !== "string" ||
        !data.text.trim()
      ) {
        throw new Error(
          "No content was generated."
        );
      }

      // -----------------------------
      // Show result
      // -----------------------------

      if (result) {
        result.textContent =
          data.text.trim();
      }

      resultContainer?.classList.remove(
        "hidden"
      );

      // -----------------------------
      // Scroll to result
      // -----------------------------

      setTimeout(() => {
        resultContainer?.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }, 100);

    } catch (error) {
      console.error(
        "Generation error:",
        error
      );

      if (error instanceof Error) {
        showError(error.message);
      } else {
        showError(
          "Something went wrong. Please try again."
        );
      }

    } finally {
      // -----------------------------
      // Reset loading
      // -----------------------------

      loading?.classList.add("hidden");

      generateBtn.disabled = false;

      if (regenerateBtn) {
        regenerateBtn.disabled = false;
      }

      generateBtn.textContent =
        "Generate Text";
    }
  }


  // ==========================================
  // GENERATE
  // ==========================================

  generateBtn?.addEventListener(
    "click",
    generateText
  );


  // ==========================================
  // REGENERATE
  // ==========================================

  regenerateBtn?.addEventListener(
    "click",
    generateText
  );


  // ==========================================
  // COPY
  // ==========================================

  copyBtn?.addEventListener(
    "click",
    async () => {
      const text =
        result?.textContent?.trim() || "";

      if (!text) {
        return;
      }

      try {
        await navigator.clipboard.writeText(
          text
        );

        copyBtn.textContent =
          "✓ Copied!";

        setTimeout(() => {
          copyBtn.textContent =
            "📋 Copy";
        }, 1500);

      } catch (error) {
        console.error(
          "Copy error:",
          error
        );

        // Fallback
        try {
          const textarea =
            document.createElement(
              "textarea"
            );

          textarea.value = text;

          textarea.style.position =
            "fixed";

          textarea.style.opacity =
            "0";

          document.body.appendChild(
            textarea
          );

          textarea.focus();
          textarea.select();

          document.execCommand(
            "copy"
          );

          document.body.removeChild(
            textarea
          );

          copyBtn.textContent =
            "✓ Copied!";

          setTimeout(() => {
            copyBtn.textContent =
              "📋 Copy";
          }, 1500);

        } catch {
          copyBtn.textContent =
            "Copy failed";

          setTimeout(() => {
            copyBtn.textContent =
              "📋 Copy";
          }, 1500);
        }
      }
    }
  );


  // ==========================================
  // DOWNLOAD
  // ==========================================

  downloadBtn?.addEventListener(
    "click",
    () => {
      const text =
        result?.textContent?.trim() || "";

      if (!text) {
        return;
      }

      const blob =
        new Blob(
          [text],
          {
            type:
              "text/plain;charset=utf-8",
          }
        );

      const url =
        URL.createObjectURL(blob);

      const a =
        document.createElement("a");

      a.href = url;

      a.download =
        "aizenova-ai-content.txt";

      document.body.appendChild(a);

      a.click();

      document.body.removeChild(a);

      setTimeout(() => {
        URL.revokeObjectURL(url);
      }, 100);
    }
  );


  // ==========================================
  // CLEAR
  // ==========================================

  clearBtn?.addEventListener(
    "click",
    () => {
      if (result) {
        result.textContent = "";
      }

      resultContainer?.classList.add(
        "hidden"
      );

      hideError();
    }
  );
</script>