---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="AI Meta Description Generator | AIZENOVA">
  <main class="mx-auto max-w-4xl px-6 py-16 text-white">

    <a
      href="/ai-tools"
      class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
    >
      ← Back to AI Tools
    </a>

    <div class="mt-10 text-center">

      <div
        class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
      >
        🔍
      </div>

      <h1 class="text-4xl font-bold sm:text-5xl">
        AI Meta Description Generator
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-gray-400">
        Generate SEO-friendly meta descriptions for your website,
        blog posts, and landing pages.
      </p>

    </div>

    <section class="mt-12 rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8">

      <!-- Page Title -->
      <div>

        <label
          for="pageTitle"
          class="mb-3 block text-sm font-medium text-gray-200"
        >
          Page Title
        </label>

        <input
          id="pageTitle"
          type="text"
          maxlength="200"
          placeholder="Example: The Best AI Tools for Small Businesses"
          class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
        />

      </div>


      <!-- Keyword -->
      <div class="mt-6">

        <label
          for="keyword"
          class="mb-3 block text-sm font-medium text-gray-200"
        >
          Main Keyword
        </label>

        <input
          id="keyword"
          type="text"
          maxlength="200"
          placeholder="Example: AI tools for small businesses"
          class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
        />

      </div>


      <!-- Content -->
      <div class="mt-6">

        <label
          for="content"
          class="mb-3 block text-sm font-medium text-gray-200"
        >
          Page Content or Topic
        </label>

        <textarea
          id="content"
          rows="7"
          maxlength="5000"
          placeholder="Describe what your page is about..."
          class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-4 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
        ></textarea>

        <div class="mt-2 flex justify-end text-xs text-gray-500">
          <span>
            <span id="charCount">0</span>/5000
          </span>
        </div>

      </div>


      <!-- Options -->
      <div class="mt-6 grid gap-5 sm:grid-cols-2">

        <!-- Language -->
        <div>

          <label
            for="language"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Language
          </label>

          <select
            id="language"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="English">English</option>
            <option value="French">French</option>
            <option value="Arabic">Arabic</option>
            <option value="Spanish">Spanish</option>
            <option value="German">German</option>
            <option value="Italian">Italian</option>
          </select>

        </div>


        <!-- Tone -->
        <div>

          <label
            for="tone"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Tone
          </label>

          <select
            id="tone"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="Professional">Professional</option>
            <option value="Engaging">Engaging</option>
            <option value="Persuasive">Persuasive</option>
            <option value="Friendly">Friendly</option>
            <option value="Creative">Creative</option>
          </select>

        </div>

      </div>


      <!-- Generate -->
      <button
        id="generateBtn"
        type="button"
        class="mt-6 w-full rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200 disabled:cursor-not-allowed disabled:opacity-50"
      >
        ✨ Generate Meta Description
      </button>


      <!-- Loading -->
      <div
        id="loading"
        class="mt-6 hidden rounded-xl border border-white/10 bg-white/[0.03] p-6 text-center"
      >

        <div class="animate-pulse text-2xl">
          ✨
        </div>

        <p class="mt-2 text-sm text-gray-400">
          AI is generating your meta description...
        </p>

        <p class="mt-1 text-xs text-gray-500">
          This may take a few seconds.
        </p>

      </div>


      <!-- Error -->
      <div
        id="errorContainer"
        class="mt-6 hidden rounded-xl border border-red-500/20 bg-red-500/5 p-4"
      >

        <p
          id="errorMessage"
          class="text-sm text-red-400"
        ></p>

      </div>


      <!-- Result -->
      <div
        id="resultContainer"
        class="mt-8 hidden"
      >

        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">

          <h2 class="text-lg font-semibold">
            Generated Meta Description
          </h2>

          <div class="flex flex-wrap gap-2">

            <button
              id="regenerateBtn"
              type="button"
              class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
            >
              🔄 Regenerate
            </button>

            <button
              id="copyBtn"
              type="button"
              class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
            >
              📋 Copy
            </button>

          </div>

        </div>


        <div
          id="result"
          class="min-h-[150px] rounded-xl border border-white/10 bg-[#111118] p-5 leading-7 text-gray-200"
        ></div>


        <div class="mt-3 text-xs text-gray-500">
          Characters:
          <span id="resultCount">0</span>
        </div>


        <button
          id="clearBtn"
          type="button"
          class="mt-4 text-sm text-gray-500 transition hover:text-white"
        >
          Clear result
        </button>

      </div>

    </section>


    <!-- Features -->
    <section class="mt-10 grid gap-5 sm:grid-cols-3">

      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">

        <div class="text-2xl">
          🔎
        </div>

        <h3 class="mt-3 font-semibold">
          SEO Friendly
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Create descriptions optimized for search engines.
        </p>

      </div>


      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">

        <div class="text-2xl">
          ⚡
        </div>

        <h3 class="mt-3 font-semibold">
          Fast
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Generate a useful meta description in seconds.
        </p>

      </div>


      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">

        <div class="text-2xl">
          📋
        </div>

        <h3 class="mt-3 font-semibold">
          Easy to Copy
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Copy your generated description with one click.
        </p>

      </div>

    </section>

  </main>


  <script>
    const pageTitle =
      document.getElementById("pageTitle") as HTMLInputElement;

    const keyword =
      document.getElementById("keyword") as HTMLInputElement;

    const content =
      document.getElementById("content") as HTMLTextAreaElement;

    const language =
      document.getElementById("language") as HTMLSelectElement;

    const tone =
      document.getElementById("tone") as HTMLSelectElement;

    const charCount =
      document.getElementById("charCount")!;

    const generateBtn =
      document.getElementById("generateBtn") as HTMLButtonElement;

    const loading =
      document.getElementById("loading")!;

    const errorContainer =
      document.getElementById("errorContainer")!;

    const errorMessage =
      document.getElementById("errorMessage")!;

    const resultContainer =
      document.getElementById("resultContainer")!;

    const result =
      document.getElementById("result")!;

    const resultCount =
      document.getElementById("resultCount")!;

    const copyBtn =
      document.getElementById("copyBtn") as HTMLButtonElement;

    const regenerateBtn =
      document.getElementById("regenerateBtn") as HTMLButtonElement;

    const clearBtn =
      document.getElementById("clearBtn") as HTMLButtonElement;

    let hasGenerated = false;


    content.addEventListener("input", () => {
      charCount.textContent =
        String(content.value.length);
    });


    function showError(message: string) {
      errorMessage.textContent = message;
      errorContainer.classList.remove("hidden");
    }


    function hideError() {
      errorContainer.classList.add("hidden");
      errorMessage.textContent = "";
    }


    async function generateMetaDescription() {

      hideError();

      if (!pageTitle.value.trim()) {
        showError("Please enter a page title.");
        pageTitle.focus();
        return;
      }

      if (!keyword.value.trim()) {
        showError("Please enter a main keyword.");
        keyword.focus();
        return;
      }

      if (!content.value.trim()) {
        showError("Please describe your page content.");
        content.focus();
        return;
      }


      generateBtn.disabled = true;

      loading.classList.remove("hidden");

      resultContainer.classList.add("hidden");


      try {

        const response = await fetch(
          "/api/generate-meta-description",
          {
            method: "POST",

            headers: {
              "Content-Type": "application/json",
            },

            body: JSON.stringify({
              pageTitle: pageTitle.value.trim(),
              keyword: keyword.value.trim(),
              content: content.value.trim(),
              language: language.value,
              tone: tone.value,
            }),
          }
        );


        const data = await response.json();


        if (!response.ok) {
          throw new Error(
            data?.error ||
            "Failed to generate meta description."
          );
        }


        result.textContent =
          data.text || "";


        resultCount.textContent =
          String(
            (data.text || "").length
          );


        resultContainer.classList.remove("hidden");

        hasGenerated = true;


      } catch (error) {

        console.error(error);

        showError(
          error instanceof Error
            ? error.message
            : "Something went wrong."
        );


      } finally {

        generateBtn.disabled = false;

        loading.classList.add("hidden");

      }
    }


    generateBtn.addEventListener(
      "click",
      generateMetaDescription
    );


    regenerateBtn.addEventListener(
      "click",
      () => {
        if (hasGenerated) {
          generateMetaDescription();
        }
      }
    );


    copyBtn.addEventListener(
      "click",
      async () => {

        const text =
          result.textContent?.trim();

        if (!text) {
          return;
        }


        try {

          await navigator.clipboard.writeText(text);

          const oldText =
            copyBtn.textContent;

          copyBtn.textContent =
            "✅ Copied";

          setTimeout(() => {
            copyBtn.textContent =
              oldText;
          }, 1500);


        } catch {

          showError(
            "Could not copy the meta description."
          );

        }

      }
    );


    clearBtn.addEventListener(
      "click",
      () => {

        result.textContent = "";

        resultCount.textContent = "0";

        resultContainer.classList.add("hidden");

        hideError();

        hasGenerated = false;

      }
    );
  </script>
</Layout>