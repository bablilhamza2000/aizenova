---
import Layout from '../../layouts/Layout.astro';

const pageTitle = 'AI YouTube Thumbnail Text Generator | AIZENOVA';
const pageDescription =
  'Generate short, catchy, and clickable YouTube thumbnail text ideas with AIZENOVA.';
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="mx-auto max-w-5xl px-6 py-12 text-white">

    <a
      href="/ai-tools"
      class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
    >
      ← Back to AI Tools
    </a>

    <header class="mt-10 text-center">
      <div
        class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
      >
        🖼️
      </div>

      <h1 class="text-4xl font-bold sm:text-5xl">
        AI YouTube Thumbnail Text Generator
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-gray-400">
        Generate short, powerful, and clickable text ideas for your YouTube
        thumbnails.
      </p>
    </header>

    <section class="mt-12 grid gap-8 lg:grid-cols-2">

      <!-- INPUT -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8"
      >
        <h2 class="text-xl font-semibold">
          Thumbnail Details
        </h2>

        <p class="mt-2 text-sm text-gray-500">
          Describe your video and choose the style you want.
        </p>

        <div class="mt-7">
          <label
            for="topic"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Video Topic
          </label>

          <textarea
            id="topic"
            rows="6"
            placeholder="Example: How I learned Python in 30 days"
            class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm leading-7 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>
        </div>

        <div class="mt-5">
          <label
            for="keyword"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Main Keyword
          </label>

          <input
            id="keyword"
            type="text"
            placeholder="Example: Learn Python"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-5">
          <label
            for="style"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Thumbnail Style
          </label>

          <select
            id="style"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white outline-none focus:border-white/30"
          >
            <option value="bold" selected>
              Bold & Powerful
            </option>

            <option value="curiosity">
              Curiosity
            </option>

            <option value="simple">
              Simple & Clean
            </option>

            <option value="viral">
              Viral
            </option>

            <option value="educational">
              Educational
            </option>

            <option value="emotional">
              Emotional
            </option>
          </select>
        </div>

        <div class="mt-5">
          <label
            for="count"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Number of Ideas
          </label>

          <select
            id="count"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white outline-none focus:border-white/30"
          >
            <option value="5">
              5 Ideas
            </option>

            <option value="10" selected>
              10 Ideas
            </option>

            <option value="15">
              15 Ideas
            </option>
          </select>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <button
            id="generateBtn"
            type="button"
            class="flex-1 rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200"
          >
            Generate Text
          </button>

          <button
            id="clearBtn"
            type="button"
            class="rounded-xl border border-white/10 px-6 py-4 text-gray-300 transition hover:bg-white/10"
          >
            Clear
          </button>
        </div>

        <p
          id="status"
          class="mt-4 hidden text-center text-sm text-gray-400"
        ></p>
      </div>

      <!-- OUTPUT -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8 lg:sticky lg:top-8 lg:self-start"
      >
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold">
              Thumbnail Text Ideas
            </h2>

            <p class="mt-1 text-sm text-gray-500">
              Click an idea to copy it.
            </p>
          </div>

          <button
            id="copyAllBtn"
            type="button"
            class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10"
          >
            Copy All
          </button>
        </div>

        <div
          id="results"
          class="mt-6 space-y-3"
        >
          <div
            class="rounded-xl border border-white/10 bg-[#111118] p-6 text-center"
          >
            <div class="text-4xl">
              🖼️
            </div>

            <h3 class="mt-4 font-semibold">
              Ready to generate?
            </h3>

            <p class="mt-2 text-sm leading-6 text-gray-500">
              Enter your video topic and generate thumbnail text ideas.
            </p>
          </div>
        </div>
      </div>

    </section>

    <section class="mt-16 max-w-3xl">
      <h2 class="text-2xl font-bold">
        Tips for better thumbnail text
      </h2>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">⚡</div>

          <h3 class="mt-3 font-semibold">
            Keep it short
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Use a few powerful words that viewers can understand quickly.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">👀</div>

          <h3 class="mt-3 font-semibold">
            Create curiosity
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Make viewers want to discover what is inside the video.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">🎯</div>

          <h3 class="mt-3 font-semibold">
            Match the video
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Your thumbnail text should accurately represent the content.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">📱</div>

          <h3 class="mt-3 font-semibold">
            Make it readable
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Choose words that remain easy to read on small screens.
          </p>
        </div>

      </div>
    </section>

  </main>

  <script>
    const $ = (id: string) =>
      document.getElementById(id);

    const getValue = (id: string) => {
      const element =
        document.getElementById(id) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | HTMLSelectElement
          | null;

      return element?.value.trim() || '';
    };

    const clean = (text: string) =>
      text.replace(/\s+/g, ' ').trim();

    const titleCase = (text: string) =>
      text
        .split(' ')
        .map(
          (word) =>
            word.charAt(0).toUpperCase() +
            word.slice(1)
        )
        .join(' ');

    function generateIdeas(
      topic: string,
      keyword: string,
      style: string
    ) {
      const subject =
        clean(keyword) ||
        clean(topic) ||
        'THIS';

      const capital =
        subject.toUpperCase();

      const normal =
        titleCase(subject);

      const ideas: Record<
        string,
        string[]
      > = {

        bold: [
          `MASTER ${capital}`,
          `LEARN ${capital}`,
          `${capital} MADE EASY`,
          `DO THIS FIRST`,
          `THE ULTIMATE GUIDE`,
          `START HERE`,
          `STOP DOING THIS`,
          `YOU NEED THIS`,
          `THE BEST WAY`,
          `WATCH THIS FIRST`,
          `FROM ZERO TO PRO`,
          `THIS CHANGES EVERYTHING`,
          `THE SIMPLE METHOD`,
          `DON'T MISS THIS`,
          `HERE'S THE TRUTH`,
        ],

        curiosity: [
          `THE TRUTH ABOUT ${capital}`,
          `NOBODY TELLS YOU THIS`,
          `I WISH I KNEW THIS`,
          `YOU'RE DOING IT WRONG`,
          `WHAT THEY DON'T TELL YOU`,
          `THIS CHANGED EVERYTHING`,
          `THE SECRET IS...`,
          `WAIT UNTIL YOU SEE THIS`,
          `IS THIS REALLY TRUE?`,
          `WHAT HAPPENS NEXT?`,
          `THE MISTAKE EVERYONE MAKES`,
          `YOU NEED TO KNOW THIS`,
          `BEFORE YOU START`,
          `THE HIDDEN TRUTH`,
          `WHY DOES THIS WORK?`,
        ],

        simple: [
          `${capital} GUIDE`,
          `${capital} 101`,
          `LEARN ${capital}`,
          `${capital} EXPLAINED`,
          `${capital} BASICS`,
          `HOW IT WORKS`,
          `STEP BY STEP`,
          `QUICK GUIDE`,
          `BEGINNER GUIDE`,
          `GET STARTED`,
          `KEY TIPS`,
          `EASY METHOD`,
          `SIMPLE STEPS`,
          `START HERE`,
          `BEGINNER TIPS`,
        ],

        viral: [
          `THIS IS INSANE!`,
          `YOU WON'T BELIEVE THIS`,
          `EVERYONE NEEDS TO SEE THIS`,
          `I TRIED IT!`,
          `IT ACTUALLY WORKS!`,
          `GAME CHANGER!`,
          `DON'T DO THIS!`,
          `THIS CHANGES EVERYTHING`,
          `THE INTERNET WAS WRONG`,
          `I FINALLY UNDERSTOOD IT`,
          `THE FASTEST WAY`,
          `THIS SECRET WORKS`,
          `YOU NEED THIS NOW`,
          `WATCH BEFORE YOU TRY`,
          `THE RESULTS ARE CRAZY`,
        ],

        educational: [
          `HOW ${capital} WORKS`,
          `${capital} EXPLAINED`,
          `LEARN ${capital}`,
          `${capital} FOR BEGINNERS`,
          `COMPLETE ${capital} GUIDE`,
          `${capital} STEP BY STEP`,
          `UNDERSTAND ${capital}`,
          `${capital} BASICS`,
          `${capital} TUTORIAL`,
          `MASTER THE BASICS`,
          `KEY CONCEPTS`,
          `PRACTICAL GUIDE`,
          `BEGINNER ROADMAP`,
          `LEARN IT FAST`,
          `FROM ZERO TO ADVANCED`,
        ],

        emotional: [
          `I FINALLY DID IT`,
          `DON'T GIVE UP`,
          `YOU CAN DO THIS`,
          `MY BIGGEST LESSON`,
          `I WISH I STARTED SOONER`,
          `THIS CHANGED MY LIFE`,
          `NEVER GIVE UP`,
          `START TODAY`,
          `BELIEVE IN YOURSELF`,
          `THE MOMENT IT CLICKED`,
          `MY HONEST EXPERIENCE`,
          `WHAT I LEARNED`,
          `THE HARDEST PART`,
          `IT WAS WORTH IT`,
          `FROM FAILURE TO SUCCESS`,
        ],
      };

      const selected =
        ideas[style] ||
        ideas.bold;

      const extra = [
        `${capital} IN MINUTES`,
        `THE ${normal} METHOD`,
        `HOW TO MASTER IT`,
        `THE EASY WAY`,
        `THE RIGHT WAY`,
      ];

      return [
        ...new Set([
          ...selected,
          ...extra,
        ]),
      ];
    }

    function escapeHTML(text: string) {
      const div =
        document.createElement('div');

      div.textContent =
        text;

      return div.innerHTML;
    }

    let currentIdeas: string[] = [];

    function renderIdeas(
      ideas: string[]
    ) {
      const results =
        $('results')!;

      results.innerHTML = '';

      ideas.forEach(
        (idea, index) => {
          const button =
            document.createElement('button');

          button.type = 'button';

          button.className =
            'group flex w-full items-center gap-4 rounded-xl border border-white/10 bg-[#111118] p-4 text-left transition hover:border-white/20 hover:bg-white/[0.06]';

          button.innerHTML = `
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white/10 text-xs font-bold text-gray-400">
              ${index + 1}
            </span>

            <span class="flex-1 text-base font-bold tracking-wide text-gray-200">
              ${escapeHTML(idea)}
            </span>

            <span class="copy-label shrink-0 text-xs text-gray-500 group-hover:text-gray-300">
              Copy
            </span>
          `;

          button.addEventListener(
            'click',
            async () => {
              try {
                await navigator.clipboard.writeText(
                  idea
                );

                const label =
                  button.querySelector(
                    '.copy-label'
                  );

                if (label) {
                  label.textContent =
                    'Copied!';

                  setTimeout(() => {
                    label.textContent =
                      'Copy';
                  }, 1500);
                }
              } catch {
                showStatus(
                  'Unable to copy automatically.'
                );
              }
            }
          );

          results.appendChild(button);
        }
      );
    }

    function showStatus(
      message: string
    ) {
      const status =
        $('status')!;

      status.textContent =
        message;

      status.classList.remove(
        'hidden'
      );

      setTimeout(() => {
        status.classList.add(
          'hidden'
        );
      }, 2500);
    }

    $('generateBtn')!.addEventListener(
      'click',
      () => {
        const topic =
          getValue('topic');

        if (!topic) {
          showStatus(
            'Please enter your video topic first.'
          );

          return;
        }

        const keyword =
          getValue('keyword');

        const style =
          getValue('style');

        const count =
          Number(
            getValue('count') ||
            '10'
          );

        const allIdeas =
          generateIdeas(
            topic,
            keyword,
            style
          );

        currentIdeas =
          allIdeas.slice(
            0,
            count
          );

        renderIdeas(
          currentIdeas
        );

        showStatus(
          'Thumbnail text ideas generated successfully.'
        );
      }
    );

    $('copyAllBtn')!.addEventListener(
      'click',
      async () => {
        if (!currentIdeas.length) {
          showStatus(
            'Generate thumbnail text first.'
          );

          return;
        }

        const text =
          currentIdeas.join('\n');

        try {
          await navigator.clipboard.writeText(
            text
          );

          const button =
            $('copyAllBtn')!;

          const original =
            button.textContent;

          button.textContent =
            'Copied!';

          setTimeout(() => {
            button.textContent =
              original;
          }, 1800);

        } catch {
          showStatus(
            'Unable to copy automatically.'
          );
        }
      }
    );

    $('clearBtn')!.addEventListener(
      'click',
      () => {
        (
          $('topic') as HTMLTextAreaElement
        ).value = '';

        (
          $('keyword') as HTMLInputElement
        ).value = '';

        (
          $('style') as HTMLSelectElement
        ).value = 'bold';

        (
          $('count') as HTMLSelectElement
        ).value = '10';

        currentIdeas = [];

        $('results')!.innerHTML = `
          <div class="rounded-xl border border-white/10 bg-[#111118] p-6 text-center">
            <div class="text-4xl">
              🖼️
            </div>

            <h3 class="mt-4 font-semibold">
              Ready to generate?
            </h3>

            <p class="mt-2 text-sm leading-6 text-gray-500">
              Enter your video topic and generate thumbnail text ideas.
            </p>
          </div>
        `;

        $('status')!.classList.add(
          'hidden'
        );
      }
    );
  </script>
</Layout>