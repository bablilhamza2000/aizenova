---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="AI Bio Generator | AIZENOVA">
  <main class="mx-auto max-w-4xl px-6 py-16 text-white">

    <a
      href="/ai-tools"
      class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
    >
      ← Back to AI Tools
    </a>

    <div class="mt-10 text-center">

      <div
        class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
      >
        👤
      </div>

      <h1 class="text-4xl font-bold sm:text-5xl">
        AI Bio Generator
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-gray-400">
        Create professional and engaging bios for social media,
        websites, portfolios, and professional profiles.
      </p>

    </div>

    <section
      class="mt-12 rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8"
    >

      <!-- About -->
      <div>

        <label
          for="about"
          class="mb-3 block text-sm font-medium text-gray-200"
        >
          Tell us about yourself
        </label>

        <textarea
          id="about"
          rows="7"
          maxlength="5000"
          placeholder="Example: I'm a web developer interested in AI, technology, programming and entrepreneurship."
          class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-4 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
        ></textarea>

        <div class="mt-2 flex justify-between text-xs text-gray-500">
          <span>
            Add your profession, interests, skills, or goals.
          </span>

          <span>
            <span id="charCount">0</span>/5000
          </span>
        </div>

      </div>

      <!-- Options -->
      <div class="mt-6 grid gap-5 sm:grid-cols-3">

        <!-- Platform -->
        <div>

          <label
            for="platform"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Platform
          </label>

          <select
            id="platform"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="Instagram">Instagram</option>
            <option value="TikTok">TikTok</option>
            <option value="LinkedIn">LinkedIn</option>
            <option value="X">X (Twitter)</option>
            <option value="Facebook">Facebook</option>
            <option value="Personal Website">Personal Website</option>
            <option value="Portfolio">Portfolio</option>
          </select>

        </div>

        <!-- Language -->
        <div>

          <label
            for="language"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Language
          </label>

          <select
            id="language"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="English">English</option>
            <option value="French">French</option>
            <option value="Arabic">Arabic</option>
            <option value="Spanish">Spanish</option>
            <option value="German">German</option>
            <option value="Italian">Italian</option>
          </select>

        </div>

        <!-- Tone -->
        <div>

          <label
            for="tone"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Tone
          </label>

          <select
            id="tone"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="Professional">Professional</option>
            <option value="Friendly">Friendly</option>
            <option value="Casual">Casual</option>
            <option value="Creative">Creative</option>
            <option value="Minimal">Minimal</option>
            <option value="Confident">Confident</option>
          </select>

        </div>

      </div>

      <!-- Length -->
      <div class="mt-6">

        <label
          for="length"
          class="mb-3 block text-sm font-medium text-gray-200"
        >
          Bio Length
        </label>

        <select
          id="length"
          class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
        >
          <option value="Short">Short</option>
          <option value="Medium" selected>Medium</option>
          <option value="Long">Long</option>
        </select>

      </div>

      <!-- Generate -->
      <button
        id="generateBtn"
        type="button"
        class="mt-6 w-full rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200 disabled:cursor-not-allowed disabled:opacity-50"
      >
        ✨ Generate Bio
      </button>

      <!-- Loading -->
      <div
        id="loading"
        class="mt-6 hidden rounded-xl border border-white/10 bg-white/[0.03] p-6 text-center"
      >

        <div class="animate-pulse text-2xl">
          ✨
        </div>

        <p class="mt-2 text-sm text-gray-400">
          AI is creating your bio...
        </p>

        <p class="mt-1 text-xs text-gray-500">
          This may take a few seconds.
        </p>

      </div>

      <!-- Error -->
      <div
        id="errorContainer"
        class="mt-6 hidden rounded-xl border border-red-500/20 bg-red-500/5 p-4"
      >

        <p
          id="errorMessage"
          class="text-sm text-red-400"
        ></p>

      </div>

      <!-- Result -->
      <div
        id="resultContainer"
        class="mt-8 hidden"
      >

        <div
          class="mb-3 flex flex-wrap items-center justify-between gap-3"
        >

          <h2 class="text-lg font-semibold">
            Generated Bio
          </h2>

          <div class="flex flex-wrap gap-2">

            <button
              id="regenerateBtn"
              type="button"
              class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
            >
              🔄 Regenerate
            </button>

            <button
              id="copyBtn"
              type="button"
              class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
            >
              📋 Copy
            </button>

          </div>

        </div>

        <div
          id="result"
          class="min-h-[180px] whitespace-pre-wrap rounded-xl border border-white/10 bg-[#111118] p-5 leading-8 text-gray-200"
        ></div>

        <button
          id="clearBtn"
          type="button"
          class="mt-4 text-sm text-gray-500 transition hover:text-white"
        >
          Clear result
        </button>

      </div>

    </section>

    <!-- Features -->
    <section class="mt-10 grid gap-5 sm:grid-cols-3">

      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
      >

        <div class="text-2xl">
          👤
        </div>

        <h3 class="mt-3 font-semibold">
          Personal
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Create a bio based on your personality and goals.
        </p>

      </div>

      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
      >

        <div class="text-2xl">
          📱
        </div>

        <h3 class="mt-3 font-semibold">
          Multi-Platform
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Generate bios for social media and professional profiles.
        </p>

      </div>

      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
      >

        <div class="text-2xl">
          ⚡
        </div>

        <h3 class="mt-3 font-semibold">
          Fast
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Create a polished bio in seconds.
        </p>

      </div>

    </section>

  </main>

  <script>
    const about =
      document.getElementById("about") as HTMLTextAreaElement;

    const platform =
      document.getElementById("platform") as HTMLSelectElement;

    const language =
      document.getElementById("language") as HTMLSelectElement;

    const tone =
      document.getElementById("tone") as HTMLSelectElement;

    const length =
      document.getElementById("length") as HTMLSelectElement;

    const charCount =
      document.getElementById("charCount")!;

    const generateBtn =
      document.getElementById("generateBtn") as HTMLButtonElement;

    const loading =
      document.getElementById("loading")!;

    const errorContainer =
      document.getElementById("errorContainer")!;

    const errorMessage =
      document.getElementById("errorMessage")!;

    const resultContainer =
      document.getElementById("resultContainer")!;

    const result =
      document.getElementById("result")!;

    const regenerateBtn =
      document.getElementById("regenerateBtn") as HTMLButtonElement;

    const copyBtn =
      document.getElementById("copyBtn") as HTMLButtonElement;

    const clearBtn =
      document.getElementById("clearBtn") as HTMLButtonElement;

    let hasGenerated = false;

    about.addEventListener("input", () => {
      charCount.textContent =
        String(about.value.length);
    });

    function showError(message: string) {
      errorMessage.textContent = message;
      errorContainer.classList.remove("hidden");
    }

    function hideError() {
      errorContainer.classList.add("hidden");
      errorMessage.textContent = "";
    }

    async function generateBio() {
      hideError();

      const aboutValue =
        about.value.trim();

      if (!aboutValue) {
        showError(
          "Please tell us something about yourself."
        );

        about.focus();

        return;
      }

      generateBtn.disabled = true;
      loading.classList.remove("hidden");
      resultContainer.classList.add("hidden");

      try {
        const response = await fetch(
          "/api/generate-bio",
          {
            method: "POST",

            headers: {
              "Content-Type": "application/json",
            },

            body: JSON.stringify({
              about: aboutValue,
              platform: platform.value,
              language: language.value,
              tone: tone.value,
              length: length.value,
            }),
          }
        );

        const data = await response.json();

        if (!response.ok) {
          throw new Error(
            data?.error ||
            "Failed to generate bio."
          );
        }

        result.textContent =
          data.text || "";

        resultContainer.classList.remove(
          "hidden"
        );

        hasGenerated = true;

      } catch (error) {
        console.error(error);

        showError(
          error instanceof Error
            ? error.message
            : "Something went wrong."
        );

      } finally {
        generateBtn.disabled = false;
        loading.classList.add("hidden");
      }
    }

    generateBtn.addEventListener(
      "click",
      generateBio
    );

    regenerateBtn.addEventListener(
      "click",
      () => {
        if (hasGenerated) {
          generateBio();
        }
      }
    );

    copyBtn.addEventListener(
      "click",
      async () => {
        const text =
          result.textContent?.trim();

        if (!text) {
          return;
        }

        try {
          await navigator.clipboard.writeText(text);

          const oldText =
            copyBtn.textContent;

          copyBtn.textContent =
            "✅ Copied";

          setTimeout(() => {
            copyBtn.textContent =
              oldText;
          }, 1500);

        } catch {
          showError(
            "Could not copy the bio."
          );
        }
      }
    );

    clearBtn.addEventListener(
      "click",
      () => {
        result.textContent = "";

        resultContainer.classList.add(
          "hidden"
        );

        hideError();

        hasGenerated = false;
      }
    );
  </script>
</Layout>