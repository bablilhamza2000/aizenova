---
import Layout from '../../layouts/Layout.astro';

const pageTitle = 'AI YouTube Hashtag Generator | AIZENOVA';
const pageDescription =
  'Generate relevant YouTube hashtags for your videos with AIZENOVA.';
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="mx-auto max-w-5xl px-6 py-12 text-white">

    <a
      href="/ai-tools"
      class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
    >
      ← Back to AI Tools
    </a>

    <header class="mt-10 text-center">
      <div
        class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
      >
        #
      </div>

      <h1 class="text-4xl font-bold sm:text-5xl">
        AI YouTube Hashtag Generator
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-gray-400">
        Generate relevant and useful YouTube hashtag ideas based on your
        video topic and keywords.
      </p>
    </header>

    <section class="mt-12 grid gap-8 lg:grid-cols-2">

      <!-- INPUT -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8"
      >
        <h2 class="text-xl font-semibold">
          Video Details
        </h2>

        <p class="mt-2 text-sm text-gray-500">
          Enter your topic and generate hashtag suggestions.
        </p>

        <div class="mt-7">
          <label
            for="topic"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Video Topic
          </label>

          <textarea
            id="topic"
            rows="6"
            placeholder="Example: How to learn Python for beginners"
            class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm leading-7 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>
        </div>

        <div class="mt-5">
          <label
            for="keyword"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Main Keywords
          </label>

          <input
            id="keyword"
            type="text"
            placeholder="Example: Python, coding, programming"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-5">
          <label
            for="niche"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Niche
          </label>

          <input
            id="niche"
            type="text"
            placeholder="Example: Programming"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-5">
          <label
            for="count"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Number of Hashtags
          </label>

          <select
            id="count"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white outline-none focus:border-white/30"
          >
            <option value="5">
              5 Hashtags
            </option>

            <option value="10" selected>
              10 Hashtags
            </option>

            <option value="15">
              15 Hashtags
            </option>

            <option value="20">
              20 Hashtags
            </option>
          </select>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <button
            id="generateBtn"
            type="button"
            class="flex-1 rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200"
          >
            Generate Hashtags
          </button>

          <button
            id="clearBtn"
            type="button"
            class="rounded-xl border border-white/10 px-6 py-4 text-gray-300 transition hover:bg-white/10"
          >
            Clear
          </button>
        </div>

        <p
          id="status"
          class="mt-4 hidden text-center text-sm text-gray-400"
        ></p>
      </div>

      <!-- OUTPUT -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8 lg:sticky lg:top-8 lg:self-start"
      >
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold">
              Generated Hashtags
            </h2>

            <p class="mt-1 text-sm text-gray-500">
              Click a hashtag to copy it.
            </p>
          </div>

          <button
            id="copyAllBtn"
            type="button"
            class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10"
          >
            Copy All
          </button>
        </div>

        <div
          id="results"
          class="mt-6 min-h-[330px] rounded-xl border border-white/10 bg-[#111118] p-5"
        >
          <div
            class="flex min-h-[280px] items-center justify-center text-center"
          >
            <div>
              <div class="text-4xl">#</div>

              <h3 class="mt-4 font-semibold">
                Ready to generate?
              </h3>

              <p class="mt-2 max-w-sm text-sm leading-6 text-gray-500">
                Enter your video topic and generate relevant hashtags.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-4 text-xs text-gray-500">
          <span id="hashtagCount">0 hashtags</span>
        </div>
      </div>

    </section>

    <section class="mt-16 max-w-3xl">
      <h2 class="text-2xl font-bold">
        YouTube hashtag tips
      </h2>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">🎯</div>

          <h3 class="mt-3 font-semibold">
            Stay relevant
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Only use hashtags that accurately describe your video.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">🔎</div>

          <h3 class="mt-3 font-semibold">
            Use specific keywords
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Specific hashtags can make the topic of your content clearer.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">📌</div>

          <h3 class="mt-3 font-semibold">
            Avoid keyword stuffing
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            A smaller set of relevant hashtags is usually better than a long
            list of unrelated ones.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">📱</div>

          <h3 class="mt-3 font-semibold">
            Keep them readable
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Use simple words that are easy for viewers to understand.
          </p>
        </div>

      </div>
    </section>

  </main>

  <script>
    const $ = (id: string) =>
      document.getElementById(id);

    const getValue = (id: string) => {
      const element =
        document.getElementById(id) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | HTMLSelectElement
          | null;

      return element?.value.trim() || '';
    };

    const clean = (text: string) =>
      text
        .replace(/[^\p{L}\p{N}\s-]/gu, '')
        .replace(/\s+/g, ' ')
        .trim();

    const hashtag = (text: string) => {
      const value =
        clean(text)
          .replace(/[-\s]+(.)/g, (_, char) =>
            char.toUpperCase()
          );

      return value
        ? `#${value}`
        : '';
    };

    function generateHashtags(
      topic: string,
      keywords: string,
      niche: string
    ) {
      const cleanTopic =
        clean(topic);

      const cleanNiche =
        clean(niche);

      const keywordList =
        keywords
          .split(',')
          .map((item) => clean(item))
          .filter(Boolean);

      const base =
        cleanTopic ||
        keywordList[0] ||
        cleanNiche ||
        'YouTube';

      const firstKeyword =
        keywordList[0] ||
        base;

      const tags = [
        hashtag(firstKeyword),
        hashtag(base),
        hashtag(cleanNiche),

        hashtag(`${firstKeyword}Tutorial`),
        hashtag(`${firstKeyword}Tips`),
        hashtag(`${firstKeyword}Guide`),
        hashtag(`Learn${firstKeyword}`),
        hashtag(`${firstKeyword}ForBeginners`),
        hashtag(`${firstKeyword}Explained`),
        hashtag(`${firstKeyword}HowTo`),

        hashtag('YouTube'),
        hashtag('YouTubeTips'),
        hashtag('YouTubeCreator'),
        hashtag('ContentCreator'),
        hashtag('VideoCreator'),
        hashtag('CreatorTips'),

        ...keywordList.map(
          (keyword) =>
            hashtag(keyword)
        ),

        ...keywordList.map(
          (keyword) =>
            hashtag(`${keyword}Tips`)
        ),

        ...keywordList.map(
          (keyword) =>
            hashtag(`${keyword}Tutorial`)
        ),

        ...keywordList.map(
          (keyword) =>
            hashtag(`Learn${keyword}`)
        ),
      ];

      return [
        ...new Set(
          tags.filter(Boolean)
        ),
      ];
    }

    function escapeHTML(text: string) {
      const div =
        document.createElement('div');

      div.textContent =
        text;

      return div.innerHTML;
    }

    let currentHashtags: string[] = [];

    function renderHashtags(
      hashtags: string[]
    ) {
      const results =
        $('results')!;

      results.innerHTML = '';

      const wrapper =
        document.createElement('div');

      wrapper.className =
        'flex flex-wrap gap-2';

      hashtags.forEach(
        (tag) => {
          const button =
            document.createElement('button');

          button.type = 'button';

          button.className =
            'group rounded-lg border border-white/10 bg-white/[0.04] px-3 py-2 text-sm font-medium text-gray-300 transition hover:border-white/20 hover:bg-white/10 hover:text-white';

          button.innerHTML = `
            <span>${escapeHTML(tag)}</span>
            <span class="ml-2 text-xs text-gray-600 group-hover:text-gray-400">
              Copy
            </span>
          `;

          button.addEventListener(
            'click',
            async () => {
              try {
                await navigator.clipboard.writeText(
                  tag
                );

                const label =
                  button.querySelector(
                    'span:last-child'
                  );

                if (label) {
                  label.textContent =
                    'Copied!';

                  setTimeout(() => {
                    label.textContent =
                      'Copy';
                  }, 1500);
                }
              } catch {
                showStatus(
                  'Unable to copy automatically.'
                );
              }
            }
          );

          wrapper.appendChild(
            button
          );
        }
      );

      results.appendChild(
        wrapper
      );
    }

    function showStatus(
      message: string
    ) {
      const status =
        $('status')!;

      status.textContent =
        message;

      status.classList.remove(
        'hidden'
      );

      setTimeout(() => {
        status.classList.add(
          'hidden'
        );
      }, 2500);
    }

    $('generateBtn')!.addEventListener(
      'click',
      () => {
        const topic =
          getValue('topic');

        if (!topic) {
          showStatus(
            'Please enter your video topic first.'
          );

          return;
        }

        const keywords =
          getValue('keyword');

        const niche =
          getValue('niche');

        const count =
          Number(
            getValue('count') ||
            '10'
          );

        const allHashtags =
          generateHashtags(
            topic,
            keywords,
            niche
          );

        currentHashtags =
          allHashtags.slice(
            0,
            count
          );

        renderHashtags(
          currentHashtags
        );

        $('hashtagCount')!.textContent =
          `${currentHashtags.length} hashtags`;

        showStatus(
          'YouTube hashtags generated successfully.'
        );
      }
    );

    $('copyAllBtn')!.addEventListener(
      'click',
      async () => {
        if (!currentHashtags.length) {
          showStatus(
            'Generate hashtags first.'
          );

          return;
        }

        const text =
          currentHashtags.join(' ');

        try {
          await navigator.clipboard.writeText(
            text
          );

          const button =
            $('copyAllBtn')!;

          const original =
            button.textContent;

          button.textContent =
            'Copied!';

          setTimeout(() => {
            button.textContent =
              original;
          }, 1800);

        } catch {
          showStatus(
            'Unable to copy automatically.'
          );
        }
      }
    );

    $('clearBtn')!.addEventListener(
      'click',
      () => {
        (
          $('topic') as HTMLTextAreaElement
        ).value = '';

        (
          $('keyword') as HTMLInputElement
        ).value = '';

        (
          $('niche') as HTMLInputElement
        ).value = '';

        (
          $('count') as HTMLSelectElement
        ).value = '10';

        currentHashtags = [];

        $('results')!.innerHTML = `
          <div class="flex min-h-[280px] items-center justify-center text-center">
            <div>
              <div class="text-4xl">#</div>

              <h3 class="mt-4 font-semibold">
                Ready to generate?
              </h3>

              <p class="mt-2 max-w-sm text-sm leading-6 text-gray-500">
                Enter your video topic and generate relevant hashtags.
              </p>
            </div>
          </div>
        `;

        $('hashtagCount')!.textContent =
          '0 hashtags';

        $('status')!.classList.add(
          'hidden'
        );
      }
    );
  </script>
</Layout>