---
import Layout from '../../layouts/Layout.astro';

const pageTitle = 'AI Interview Question Generator | AIZENOVA';
const pageDescription =
  'Generate interview questions, sample answers, and interview tips based on your target job.';
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="mx-auto max-w-5xl px-6 py-12 text-white">

    <a
      href="/ai-tools"
      class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
    >
      ← Back to AI Tools
    </a>

    <header class="mt-10 text-center">
      <div
        class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
      >
        🎤
      </div>

      <h1 class="text-4xl font-bold sm:text-5xl">
        AI Interview Question Generator
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-gray-400">
        Generate realistic interview questions and sample answers based on
        the job you want.
      </p>
    </header>

    <section class="mt-12 grid gap-8 lg:grid-cols-2">

      <!-- FORM -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8"
      >
        <h2 class="text-xl font-semibold">
          Interview Details
        </h2>

        <p class="mt-2 text-sm text-gray-500">
          Tell us about the interview you are preparing for.
        </p>

        <!-- Job title -->
        <div class="mt-7">
          <label
            for="jobTitle"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Job Title
          </label>

          <input
            id="jobTitle"
            type="text"
            placeholder="e.g. Software Developer"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <!-- Industry -->
        <div class="mt-5">
          <label
            for="industry"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Industry
          </label>

          <input
            id="industry"
            type="text"
            placeholder="e.g. Technology, Finance, Marketing"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <!-- Experience -->
        <div class="mt-5">
          <label
            for="experience"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Experience Level
          </label>

          <select
            id="experience"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="entry">Entry Level</option>
            <option value="junior">Junior</option>
            <option value="mid">Mid-Level</option>
            <option value="senior">Senior</option>
            <option value="manager">Manager / Lead</option>
            <option value="executive">Executive</option>
          </select>
        </div>

        <!-- Interview type -->
        <div class="mt-5">
          <label
            for="interviewType"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Interview Type
          </label>

          <select
            id="interviewType"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="general">General Interview</option>
            <option value="technical">Technical Interview</option>
            <option value="behavioral">Behavioral Interview</option>
            <option value="hr">HR Interview</option>
            <option value="managerial">Managerial Interview</option>
          </select>
        </div>

        <!-- Number -->
        <div class="mt-5">
          <label
            for="questionCount"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Number of Questions
          </label>

          <select
            id="questionCount"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="5">5 Questions</option>
            <option value="8">8 Questions</option>
            <option value="10" selected>10 Questions</option>
            <option value="15">15 Questions</option>
          </select>
        </div>

        <!-- Skills -->
        <div class="mt-5">
          <label
            for="skills"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Skills / Topics
          </label>

          <textarea
            id="skills"
            rows="4"
            placeholder="JavaScript, React, communication, teamwork..."
            class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>

          <p class="mt-2 text-xs text-gray-500">
            Separate topics with commas.
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">

          <button
            id="generateBtn"
            type="button"
            class="flex-1 rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200"
          >
            Generate Questions
          </button>

          <button
            id="clearBtn"
            type="button"
            class="rounded-xl border border-white/10 px-6 py-4 text-gray-300 transition hover:bg-white/10"
          >
            Clear
          </button>

        </div>

        <p
          id="status"
          class="mt-4 hidden text-center text-sm text-gray-400"
        ></p>
      </div>

      <!-- RESULTS -->
      <div class="lg:sticky lg:top-8 lg:self-start">

        <div class="mb-4">
          <h2 class="text-xl font-semibold">
            Interview Questions
          </h2>

          <p class="mt-1 text-sm text-gray-500">
            Practice your answers before the interview.
          </p>
        </div>

        <div
          id="results"
          class="space-y-4"
        >
          <div
            class="rounded-xl border border-white/10 bg-white/[0.03] p-6 text-center"
          >
            <div class="text-4xl">
              🎯
            </div>

            <h3 class="mt-4 font-semibold">
              Ready to practice?
            </h3>

            <p class="mt-2 text-sm leading-6 text-gray-500">
              Enter your job information and click
              “Generate Questions” to get started.
            </p>
          </div>
        </div>

      </div>

    </section>

    <!-- Tips -->
    <section class="mt-16 max-w-3xl">

      <h2 class="text-2xl font-bold">
        Interview Preparation Tips
      </h2>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">💡</div>

          <h3 class="mt-3 font-semibold">
            Research the company
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Learn about the company's products, culture, values, and recent
            developments before your interview.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">🗣️</div>

          <h3 class="mt-3 font-semibold">
            Practice out loud
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Speaking your answers out loud can help you become more confident
            and communicate your ideas clearly.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">⭐</div>

          <h3 class="mt-3 font-semibold">
            Use real examples
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Support your answers with specific examples from your studies,
            work, projects, or other experiences.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">⏱️</div>

          <h3 class="mt-3 font-semibold">
            Keep answers focused
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Give clear answers and avoid unnecessary details. Structure your
            response around the most relevant points.
          </p>
        </div>

      </div>

    </section>

  </main>

  <script>
    interface Question {
      question: string;
      category: string;
      answer: string;
      tip: string;
    }

    const $ = (id: string) =>
      document.getElementById(id);

    const value = (id: string) => {
      const element =
        document.getElementById(id) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | HTMLSelectElement
          | null;

      return element?.value.trim() || "";
    };

    function escapeHTML(text: string) {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    function getExperienceLabel(level: string) {
      const labels: Record<string, string> = {
        entry: "entry-level",
        junior: "junior",
        mid: "mid-level",
        senior: "senior",
        manager: "managerial",
        executive: "executive",
      };

      return labels[level] || "professional";
    }

    function getQuestions(
      jobTitle: string,
      industry: string,
      experience: string,
      interviewType: string,
      skills: string[]
    ): Question[] {

      const role =
        jobTitle || "this position";

      const companyArea =
        industry || "your industry";

      const level =
        getExperienceLabel(experience);

      const skillText =
        skills.length
          ? skills.join(", ")
          : "the key skills required for the position";

      const questions: Question[] = [];

      if (
        interviewType === "general" ||
        interviewType === "hr"
      ) {
        questions.push({
          question:
            `Tell me about yourself and your background.`,
          category: "General",
          answer:
            `Start with a short professional introduction. Mention your current situation, relevant experience or education, your strongest skills, and why they are relevant to the ${role} position.`,
          tip:
            "Keep your answer focused on information relevant to the job."
        });

        questions.push({
          question:
            `Why are you interested in the ${role} position?`,
          category: "Motivation",
          answer:
            `Explain what attracts you to the role, how it matches your skills and career goals, and what you hope to contribute.`,
          tip:
            "Show genuine interest rather than giving a generic answer."
        });

        questions.push({
          question:
            `Why do you want to work in ${companyArea}?`,
          category: "Motivation",
          answer:
            `Talk about your interest in the industry, relevant experience, and the type of problems or opportunities that motivate you.`,
          tip:
            "Connect your personal goals with the industry."
        });

        questions.push({
          question:
            `What are your greatest strengths?`,
          category: "Personal",
          answer:
            `Choose two or three strengths that are useful for the position and support each one with a short example.`,
          tip:
            "Choose strengths that match the job requirements."
        });

        questions.push({
          question:
            `What is one area you are currently working to improve?`,
          category: "Personal",
          answer:
            `Choose a genuine but manageable weakness and explain what you are doing to improve it.`,
          tip:
            "Avoid presenting a critical job requirement as your weakness."
        });
      }

      if (
        interviewType === "technical"
      ) {
        questions.push({
          question:
            `What technical skills are most important for a ${role}?`,
          category: "Technical",
          answer:
            `Discuss the technical skills that are most relevant to the position and explain how you have developed or applied them.`,
          tip:
            `Mention specific technologies, projects, or practical examples.`
        });

        questions.push({
          question:
            `How would you approach solving a difficult technical problem?`,
          category: "Technical",
          answer:
            `Explain your process: understand the problem, break it into smaller parts, investigate possible solutions, test your approach, and evaluate the result.`,
          tip:
            "Interviewers often care about your reasoning process, not only the final answer."
        });

        questions.push({
          question:
            `Tell me about a technical project you are proud of.`,
          category: "Technical",
          answer:
            `Describe the project, your responsibilities, the technologies or methods you used, the main challenge, and the result.`,
          tip:
            "Use a real project whenever possible."
        });
      }

      if (
        interviewType === "behavioral"
      ) {
        questions.push({
          question:
            `Tell me about a difficult problem you faced and how you solved it.`,
          category: "Behavioral",
          answer:
            `Use the STAR method: Situation, Task, Action, and Result. Explain what happened, what you needed to accomplish, what you did, and what changed as a result.`,
          tip:
            "Focus most of your answer on the actions you personally took."
        });

        questions.push({
          question:
            `Tell me about a time you worked successfully as part of a team.`,
          category: "Behavioral",
          answer:
            `Describe the team situation, your role, how you communicated with others, and the final result.`,
          tip:
            "Show collaboration while making your individual contribution clear."
        });

        questions.push({
          question:
            `Tell me about a time you made a mistake.`,
          category: "Behavioral",
          answer:
            `Briefly explain the situation, take responsibility, explain what you learned, and describe how you changed your approach afterward.`,
          tip:
            "Show learning and accountability rather than blaming others."
        });
      }

      if (
        interviewType === "managerial"
      ) {
        questions.push({
          question:
            `How do you prioritize tasks when everything seems important?`,
          category: "Leadership",
          answer:
            `Explain how you evaluate urgency, impact, deadlines, dependencies, and available resources before setting priorities.`,
          tip:
            "Give a practical example if possible."
        });

        questions.push({
          question:
            `How would you handle a disagreement within your team?`,
          category: "Leadership",
          answer:
            `Explain how you listen to each perspective, identify the underlying issue, encourage respectful discussion, and work toward a practical solution.`,
          tip:
            "Emphasize communication and problem solving."
        });

        questions.push({
          question:
            `How do you motivate team members?`,
          category: "Leadership",
          answer:
            `Discuss clear goals, recognition, communication, development opportunities, and understanding individual strengths.`,
          tip:
            "Avoid suggesting that one management style works for everyone."
        });
      }

      questions.push({
        question:
          `How would your experience with ${skillText} help you succeed in this role?`,
        category: "Skills",
        answer:
          `Choose the skills most relevant to the position and give concrete examples of how you have used them to solve problems, complete projects, or achieve results.`,
        tip:
          "Prioritize skills mentioned in the job description."
      });

      questions.push({
        question:
          `Where do you see yourself professionally in the next few years?`,
        category: "Career",
        answer:
          `Describe realistic professional goals that show ambition while demonstrating that you are interested in developing within your field.`,
        tip:
          "Focus on skills and responsibilities you want to develop."
      });

      questions.push({
        question:
          `Why should we hire you for this ${level} ${role} position?`,
        category: "Closing",
        answer:
          `Summarize your most relevant skills, experience, motivation, and the value you can bring to the organization.`,
        tip:
          "Finish with a confident summary rather than simply repeating your CV."
      });

      return questions;
    }

    function renderQuestions() {

      const jobTitle =
        value("jobTitle");

      const industry =
        value("industry");

      const experience =
        value("experience");

      const interviewType =
        value("interviewType");

      const skills =
        value("skills")
          .split(",")
          .map((item) => item.trim())
          .filter(Boolean);

      const count =
        Number(
          value("questionCount") || "10"
        );

      let questions =
        getQuestions(
          jobTitle,
          industry,
          experience,
          interviewType,
          skills
        );

      /*
       * Add more general questions when the
       * requested amount is larger than the
       * initial question set.
       */

      const additional: Question[] = [
        {
          question:
            `How do you handle pressure and tight deadlines?`,
          category: "Work Style",
          answer:
            `Explain how you organize priorities, communicate expectations, and stay focused when deadlines are tight.`,
          tip:
            "Give a real example whenever possible."
        },
        {
          question:
            `How do you learn a new skill or technology?`,
          category: "Learning",
          answer:
            `Describe your preferred learning process, such as documentation, courses, practice projects, mentorship, and experimentation.`,
          tip:
            "Show that you are proactive about learning."
        },
        {
          question:
            `What motivates you at work?`,
          category: "Motivation",
          answer:
            `Mention factors such as solving meaningful problems, learning, achieving measurable results, teamwork, or taking responsibility.`,
          tip:
            "Connect your motivation to the position."
        },
        {
          question:
            `What questions do you have for us?`,
          category: "Closing",
          answer:
            `Prepare two or three thoughtful questions about the role, team, expectations, company culture, or future projects.`,
          tip:
            "Never finish an interview by saying you have no questions."
        },
        {
          question:
            `What would you do during your first 30 days in this role?`,
          category: "Strategy",
          answer:
            `Explain that you would learn the organization, understand expectations, build relationships, review existing processes, and identify priorities.`,
          tip:
            "Show curiosity before suggesting major changes."
        },
      ];

      let index = 0;

      while (
        questions.length < count
      ) {
        questions.push(
          additional[
            index % additional.length
          ]
        );

        index++;
      }

      questions =
        questions.slice(0, count);

      const results =
        $("results")!;

      results.innerHTML = "";

      questions.forEach(
        (item, questionIndex) => {

          const card =
            document.createElement("article");

          card.className =
            "overflow-hidden rounded-xl border border-white/10 bg-white/[0.03]";

          card.innerHTML = `
            <button
              type="button"
              class="question-toggle flex w-full items-start justify-between gap-4 p-5 text-left"
              aria-expanded="false"
            >
              <div class="flex gap-4">
                <span
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/10 text-xs font-bold text-gray-300"
                >
                  ${questionIndex + 1}
                </span>

                <div>
                  <span class="text-xs font-medium uppercase tracking-wider text-gray-500">
                    ${escapeHTML(item.category)}
                  </span>

                  <h3 class="mt-1 font-semibold leading-6 text-gray-100">
                    ${escapeHTML(item.question)}
                  </h3>
                </div>
              </div>

              <span class="toggle-icon shrink-0 text-gray-500">
                +
              </span>
            </button>

            <div class="question-answer hidden border-t border-white/10 px-5 pb-5 pt-4">

              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                  Sample Answer
                </p>

                <p class="mt-2 text-sm leading-7 text-gray-400">
                  ${escapeHTML(item.answer)}
                </p>
              </div>

              <div class="mt-5 rounded-lg bg-white/[0.04] p-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                  Interview Tip
                </p>

                <p class="mt-2 text-sm leading-6 text-gray-400">
                  ${escapeHTML(item.tip)}
                </p>
              </div>

            </div>
          `;

          const toggle =
            card.querySelector(
              ".question-toggle"
            ) as HTMLButtonElement;

          const answer =
            card.querySelector(
              ".question-answer"
            ) as HTMLElement;

          const icon =
            card.querySelector(
              ".toggle-icon"
            ) as HTMLElement;

          toggle.addEventListener(
            "click",
            () => {

              const isHidden =
                answer.classList.contains(
                  "hidden"
                );

              answer.classList.toggle(
                "hidden"
              );

              toggle.setAttribute(
                "aria-expanded",
                String(isHidden)
              );

              icon.textContent =
                isHidden ? "−" : "+";
            }
          );

          results.appendChild(card);
        }
      );
    }

    $("generateBtn")!.addEventListener(
      "click",
      () => {

        renderQuestions();

        const status =
          $("status")!;

        status.textContent =
          "Interview questions generated successfully.";

        status.classList.remove(
          "hidden"
        );

        setTimeout(() => {
          status.classList.add(
            "hidden"
          );
        }, 3000);

        $("results")!.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }
    );

    $("clearBtn")!.addEventListener(
      "click",
      () => {

        (
          document.getElementById(
            "jobTitle"
          ) as HTMLInputElement
        ).value = "";

        (
          document.getElementById(
            "industry"
          ) as HTMLInputElement
        ).value = "";

        (
          document.getElementById(
            "skills"
          ) as HTMLTextAreaElement
        ).value = "";

        (
          document.getElementById(
            "experience"
          ) as HTMLSelectElement
        ).value = "entry";

        (
          document.getElementById(
            "interviewType"
          ) as HTMLSelectElement
        ).value = "general";

        (
          document.getElementById(
            "questionCount"
          ) as HTMLSelectElement
        ).value = "10";

        $("results")!.innerHTML = `
          <div class="rounded-xl border border-white/10 bg-white/[0.03] p-6 text-center">
            <div class="text-4xl">🎯</div>

            <h3 class="mt-4 font-semibold">
              Ready to practice?
            </h3>

            <p class="mt-2 text-sm leading-6 text-gray-500">
              Enter your job information and click
              “Generate Questions” to get started.
            </p>
          </div>
        `;

        $("status")!.classList.add(
          "hidden"
        );
      }
    );
  </script>
</Layout>