---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="AI Grammar Checker | AIZENOVA"
  description="Check and improve your grammar, spelling, punctuation, and writing with AI."
>
  <main class="mx-auto max-w-5xl px-6 py-16">

    <!-- Back -->
    <a
      href="/ai-tools"
      class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
    >
      ← Back to AI Tools
    </a>

    <!-- Header -->
    <section class="mt-10 text-center">
      <div
        class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
      >
        ✏️
      </div>

      <h1 class="text-4xl font-bold sm:text-5xl">
        AI Grammar Checker
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-gray-400">
        Check grammar, spelling, punctuation, and clarity with AI.
      </p>
    </section>

    <!-- Tool -->
    <section class="mx-auto mt-12 max-w-4xl">

      <!-- Language -->
      <div>
        <label
          for="language"
          class="mb-3 block text-sm font-medium text-gray-200"
        >
          Language
        </label>

        <select
          id="language"
          class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
        >
          <option value="English">English</option>
          <option value="French">French</option>
          <option value="Spanish">Spanish</option>
          <option value="German">German</option>
          <option value="Italian">Italian</option>
          <option value="Arabic">Arabic</option>
        </select>
      </div>

      <!-- Text -->
      <div class="mt-6">

        <div class="mb-3 flex items-center justify-between">
          <label
            for="text"
            class="text-sm font-medium text-gray-200"
          >
            Your text
          </label>

          <span class="text-xs text-gray-500">
            <span id="charCount">0</span>/5000
          </span>
        </div>

        <textarea
          id="text"
          rows="12"
          maxlength="5000"
          placeholder="Paste or write your text here..."
          class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-4 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
        ></textarea>

      </div>

      <!-- Check button -->
      <button
        id="checkBtn"
        type="button"
        class="mt-6 w-full rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200 disabled:cursor-not-allowed disabled:opacity-50"
      >
        Check Grammar
      </button>

      <!-- Loading -->
      <div
        id="loading"
        class="mt-6 hidden rounded-xl border border-white/10 bg-white/[0.03] p-6 text-center"
      >
        <div class="animate-pulse text-2xl">
          ✨
        </div>

        <p class="mt-2 text-sm text-gray-400">
          Checking your text...
        </p>

        <p class="mt-1 text-xs text-gray-500">
          This may take a few seconds.
        </p>
      </div>

      <!-- Error -->
      <div
        id="errorContainer"
        class="mt-6 hidden rounded-xl border border-red-500/20 bg-red-500/5 p-4"
      >
        <p
          id="errorMessage"
          class="text-sm text-red-400"
        ></p>
      </div>

      <!-- Result -->
      <div
        id="resultContainer"
        class="mt-8 hidden"
      >

        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">

          <h2 class="text-lg font-semibold">
            Corrected Text
          </h2>

          <div class="flex flex-wrap gap-2">

            <button
              id="copyBtn"
              type="button"
              class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
            >
              📋 Copy
            </button>

            <button
              id="downloadBtn"
              type="button"
              class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
            >
              ⬇️ Download
            </button>

          </div>

        </div>

        <div
          id="result"
          class="min-h-[250px] whitespace-pre-wrap rounded-xl border border-white/10 bg-[#111118] p-5 leading-7 text-gray-200"
        ></div>

        <button
          id="clearBtn"
          type="button"
          class="mt-4 text-sm text-gray-500 transition hover:text-white"
        >
          Clear result
        </button>

      </div>

    </section>

    <!-- Features -->
    <section class="mt-16 grid gap-5 sm:grid-cols-3">

      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
      >
        <div class="text-2xl">
          ✍️
        </div>

        <h3 class="mt-3 font-semibold">
          Grammar
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Detect and fix common grammar mistakes.
        </p>
      </div>

      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
      >
        <div class="text-2xl">
          🔤
        </div>

        <h3 class="mt-3 font-semibold">
          Spelling
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Improve spelling and punctuation automatically.
        </p>
      </div>

      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-5"
      >
        <div class="text-2xl">
          ⚡
        </div>

        <h3 class="mt-3 font-semibold">
          Fast & Simple
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Check your writing in just a few seconds.
        </p>
      </div>

    </section>

  </main>

  <script>
    const textInput =
      document.getElementById("text") as HTMLTextAreaElement;

    const languageInput =
      document.getElementById("language") as HTMLSelectElement;

    const checkBtn =
      document.getElementById("checkBtn") as HTMLButtonElement;

    const loading =
      document.getElementById("loading") as HTMLDivElement;

    const errorContainer =
      document.getElementById("errorContainer") as HTMLDivElement;

    const errorMessage =
      document.getElementById("errorMessage") as HTMLParagraphElement;

    const resultContainer =
      document.getElementById("resultContainer") as HTMLDivElement;

    const result =
      document.getElementById("result") as HTMLDivElement;

    const copyBtn =
      document.getElementById("copyBtn") as HTMLButtonElement;

    const downloadBtn =
      document.getElementById("downloadBtn") as HTMLButtonElement;

    const clearBtn =
      document.getElementById("clearBtn") as HTMLButtonElement;

    const charCount =
      document.getElementById("charCount") as HTMLSpanElement;

    textInput.addEventListener("input", () => {
      charCount.textContent = String(textInput.value.length);
    });

    function showError(message: string) {
      errorMessage.textContent = message;
      errorContainer.classList.remove("hidden");
    }

    function hideError() {
      errorContainer.classList.add("hidden");
      errorMessage.textContent = "";
    }

    checkBtn.addEventListener("click", async () => {
      hideError();

      const text = textInput.value.trim();
      const language = languageInput.value;

      if (!text) {
        showError("Please enter some text first.");
        return;
      }

      if (text.length > 5000) {
        showError("Text is too long. Maximum 5000 characters.");
        return;
      }

      checkBtn.disabled = true;
      loading.classList.remove("hidden");
      resultContainer.classList.add("hidden");

      try {
        const response = await fetch("/api/grammar-check", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            text,
            language,
          }),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(
            data.error || "Failed to check grammar."
          );
        }

        if (!data.text) {
          throw new Error(
            "The AI did not return corrected text."
          );
        }

        result.textContent = data.text;
        resultContainer.classList.remove("hidden");

        resultContainer.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });

      } catch (error) {
        showError(
          error instanceof Error
            ? error.message
            : "Something went wrong."
        );
      } finally {
        checkBtn.disabled = false;
        loading.classList.add("hidden");
      }
    });

    copyBtn.addEventListener("click", async () => {
      const text = result.textContent || "";

      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);

        const original = copyBtn.textContent;

        copyBtn.textContent = "✅ Copied!";

        setTimeout(() => {
          copyBtn.textContent = original;
        }, 1500);

      } catch {
        showError("Could not copy the text.");
      }
    });

    downloadBtn.addEventListener("click", () => {
      const text = result.textContent || "";

      if (!text) return;

      const blob = new Blob([text], {
        type: "text/plain;charset=utf-8",
      });

      const url = URL.createObjectURL(blob);

      const link = document.createElement("a");

      link.href = url;
      link.download = "grammar-checked-text.txt";

      document.body.appendChild(link);
      link.click();
      link.remove();

      URL.revokeObjectURL(url);
    });

    clearBtn.addEventListener("click", () => {
      result.textContent = "";
      resultContainer.classList.add("hidden");
      hideError();
    });
  </script>
</Layout>