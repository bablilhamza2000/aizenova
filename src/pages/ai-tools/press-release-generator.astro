---
import Layout from '../../layouts/Layout.astro';

const pageTitle = 'AI Press Release Generator | AIZENOVA';
const pageDescription =
  'Create professional press releases for product launches, company news, events, and announcements with AIZENOVA.';
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="mx-auto max-w-6xl px-6 py-12 text-white">

    <a
      href="/ai-tools"
      class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
    >
      ← Back to AI Tools
    </a>

    <header class="mt-10 text-center">
      <div
        class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
      >
        📰
      </div>

      <h1 class="text-4xl font-bold sm:text-5xl">
        AI Press Release Generator
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-gray-400">
        Create professional press releases for product launches, company
        announcements, events, partnerships, and important news.
      </p>
    </header>

    <section class="mt-12 grid gap-8 lg:grid-cols-2">

      <!-- INPUT -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8"
      >
        <h2 class="text-xl font-semibold">
          Press Release Details
        </h2>

        <p class="mt-2 text-sm text-gray-500">
          Add the important information about your announcement.
        </p>

        <div class="mt-7">
          <label
            for="headline"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Main Headline
          </label>

          <input
            id="headline"
            type="text"
            placeholder="Example: AIZENOVA Launches New AI Productivity Platform"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-5">
          <label
            for="organization"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Company / Organization
          </label>

          <input
            id="organization"
            type="text"
            placeholder="Example: AIZENOVA"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-5">
          <label
            for="announcement"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            What are you announcing?
          </label>

          <textarea
            id="announcement"
            rows="6"
            placeholder="Describe your product, service, event, partnership, launch, or company news..."
            class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm leading-7 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>
        </div>

        <div class="mt-5">
          <label
            for="type"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Announcement Type
          </label>

          <select
            id="type"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white outline-none focus:border-white/30"
          >
            <option value="product" selected>
              Product Launch
            </option>

            <option value="company">
              Company News
            </option>

            <option value="event">
              Event
            </option>

            <option value="partnership">
              Partnership
            </option>

            <option value="funding">
              Funding / Investment
            </option>

            <option value="award">
              Award / Achievement
            </option>

            <option value="update">
              Company Update
            </option>
          </select>
        </div>

        <div class="mt-5">
          <label
            for="audience"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Target Audience
          </label>

          <input
            id="audience"
            type="text"
            placeholder="Example: Customers, journalists, investors, businesses"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-5">
          <label
            for="location"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Location
          </label>

          <input
            id="location"
            type="text"
            placeholder="Example: Casablanca, Morocco"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-5">
          <label
            for="date"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Date
          </label>

          <input
            id="date"
            type="text"
            placeholder="Example: August 2026"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-5">
          <label
            for="quote"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Optional Quote
          </label>

          <textarea
            id="quote"
            rows="3"
            placeholder="Example: We are excited to help businesses work smarter..."
            class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm leading-7 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>
        </div>

        <div class="mt-5">
          <label
            for="contact"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Contact Information
          </label>

          <input
            id="contact"
            type="text"
            placeholder="Example: press@aizenova.com"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <button
            id="generateBtn"
            type="button"
            class="flex-1 rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200"
          >
            Generate Press Release
          </button>

          <button
            id="clearBtn"
            type="button"
            class="rounded-xl border border-white/10 px-6 py-4 text-gray-300 transition hover:bg-white/10"
          >
            Clear
          </button>
        </div>

        <p
          id="status"
          class="mt-4 hidden text-center text-sm text-gray-400"
        ></p>
      </div>

      <!-- OUTPUT -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8 lg:sticky lg:top-8 lg:self-start"
      >
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold">
              Generated Press Release
            </h2>

            <p class="mt-1 text-sm text-gray-500">
              Your professional press release will appear here.
            </p>
          </div>

          <button
            id="copyBtn"
            type="button"
            class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10"
          >
            Copy
          </button>
        </div>

        <textarea
          id="output"
          readonly
          rows="35"
          placeholder="Your press release will appear here..."
          class="mt-6 w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-4 text-sm leading-7 text-gray-300 outline-none"
        ></textarea>

        <div class="mt-4 flex items-center justify-between text-xs text-gray-500">
          <span id="wordCount">
            0 words
          </span>

          <span id="charCount">
            0 characters
          </span>
        </div>
      </div>

    </section>

    <section class="mt-16 max-w-4xl">
      <h2 class="text-2xl font-bold">
        Tips for writing a better press release
      </h2>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">📰</div>

          <h3 class="mt-3 font-semibold">
            Lead with the news
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Put the most important information near the beginning so readers
            understand the announcement quickly.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">🎯</div>

          <h3 class="mt-3 font-semibold">
            Keep it factual
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Use clear facts and specific information instead of unnecessary
            marketing language.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">💬</div>

          <h3 class="mt-3 font-semibold">
            Add a strong quote
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            A relevant quote can make the announcement more personal and
            provide useful context.
          </p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <div class="text-2xl">📞</div>

          <h3 class="mt-3 font-semibold">
            Include contact details
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            Give journalists, customers, or other readers a clear way to
            contact the organization.
          </p>
        </div>

      </div>
    </section>

  </main>

  <script>
    const $ = (id: string) =>
      document.getElementById(id);

    const getValue = (id: string) => {
      const element =
        document.getElementById(id) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | HTMLSelectElement
          | null;

      return element?.value.trim() || '';
    };

    const clean = (text: string) =>
      text.replace(/\s+/g, ' ').trim();

    function getTypeIntro(type: string) {
      const intros: Record<string, string> = {
        product:
          'The company today announced the launch of a new product designed to provide customers with a more efficient and accessible solution.',

        company:
          'The company today announced an important development as part of its continued growth and commitment to its customers and community.',

        event:
          'The company today announced an upcoming event that will bring together professionals, customers, and industry participants.',

        partnership:
          'The companies today announced a new partnership designed to combine their capabilities and create additional value for customers.',

        funding:
          'The company today announced a new funding development that will support its continued growth, product development, and long-term plans.',

        award:
          'The company today announced a new achievement recognizing its continued work, progress, and contribution to its industry.',

        update:
          'The company today announced an important update as it continues to develop its products, services, and customer experience.',
      };

      return (
        intros[type] ||
        intros.company
      );
    }

    function getTypeClosing(type: string) {
      const closings: Record<string, string> = {
        product:
          'The launch represents another step in the company’s mission to provide practical and useful solutions to its customers.',

        company:
          'The company will continue building on this progress while focusing on its customers, products, and long-term goals.',

        event:
          'Additional information about the event, including participation details and updates, will be made available through the organization’s official channels.',

        partnership:
          'The partnership is expected to create new opportunities while providing additional value to customers and stakeholders.',

        funding:
          'The company plans to use the new resources to support its strategic priorities and continue investing in future growth.',

        award:
          'The achievement reflects the company’s continued commitment to quality, innovation, and the people it serves.',

        update:
          'The company remains focused on delivering useful products and services while continuing to improve the experience for its customers.',
      };

      return (
        closings[type] ||
        closings.company
      );
    }

    function createPressRelease(
      headline: string,
      organization: string,
      announcement: string,
      type: string,
      audience: string,
      location: string,
      date: string,
      quote: string,
      contact: string
    ) {
      const company =
        clean(organization) ||
        'AIZENOVA';

      const news =
        clean(announcement);

      const target =
        clean(audience) ||
        'customers and industry professionals';

      const place =
        clean(location) ||
        'Casablanca, Morocco';

      const releaseDate =
        clean(date) ||
        new Date().toLocaleDateString(
          'en-US',
          {
            month: 'long',
            year: 'numeric',
          }
        );

      const contactInfo =
        clean(contact) ||
        'Contact the organization for more information.';

      const title =
        clean(headline) ||
        `${company} Announces New Development`;

      const intro =
        getTypeIntro(type);

      const closing =
        getTypeClosing(type);

      const quoteBlock =
        quote
          ? `"${clean(quote)}"\n\n— ${company}`
          : `"We are excited to share this announcement and continue building meaningful value for ${target}."\n\n— ${company}`;

      return [
        'FOR IMMEDIATE RELEASE',
        '',
        title.toUpperCase(),
        '',
        `${place} — ${releaseDate} — ${company} today announced ${news}.`,
        '',
        intro,
        '',
        `The announcement is expected to be relevant to ${target}, providing additional opportunities and information around the company’s latest development.`,
        '',
        `According to ${company}, the initiative reflects its continued focus on delivering practical solutions and creating long-term value.`,
        '',
        quoteBlock,
        '',
        closing,
        '',
        `About ${company}`,
        '',
        `${company} is an organization focused on developing useful products, services, and solutions for its customers and the wider market.`,
        '',
        `Media Contact`,
        '',
        contactInfo,
        '',
        '###',
        '',
        'END',
      ].join('\n');
    }

    function updateStats(text: string) {
      const trimmed =
        text.trim();

      const words =
        trimmed
          ? trimmed.split(/\s+/).length
          : 0;

      $('wordCount')!.textContent =
        `${words} ${words === 1 ? 'word' : 'words'}`;

      $('charCount')!.textContent =
        `${text.length} characters`;
    }

    function showStatus(message: string) {
      const status =
        $('status')!;

      status.textContent =
        message;

      status.classList.remove(
        'hidden'
      );

      setTimeout(() => {
        status.classList.add(
          'hidden'
        );
      }, 2500);
    }

    $('generateBtn')!.addEventListener(
      'click',
      () => {
        const headline =
          getValue('headline');

        const organization =
          getValue('organization');

        const announcement =
          getValue('announcement');

        if (!announcement) {
          showStatus(
            'Please describe what you are announcing first.'
          );

          return;
        }

        const type =
          getValue('type');

        const audience =
          getValue('audience');

        const location =
          getValue('location');

        const date =
          getValue('date');

        const quote =
          getValue('quote');

        const contact =
          getValue('contact');

        const pressRelease =
          createPressRelease(
            headline,
            organization,
            announcement,
            type,
            audience,
            location,
            date,
            quote,
            contact
          );

        const output =
          $('output') as HTMLTextAreaElement;

        output.value =
          pressRelease;

        updateStats(
          pressRelease
        );

        showStatus(
          'Press release generated successfully.'
        );
      }
    );

    $('copyBtn')!.addEventListener(
      'click',
      async () => {
        const output =
          (
            $('output') as HTMLTextAreaElement
          ).value.trim();

        if (!output) {
          showStatus(
            'Generate a press release first.'
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(
            output
          );

          const button =
            $('copyBtn')!;

          const original =
            button.textContent;

          button.textContent =
            'Copied!';

          setTimeout(() => {
            button.textContent =
              original;
          }, 1800);
        } catch {
          showStatus(
            'Unable to copy automatically.'
          );
        }
      }
    );

    $('clearBtn')!.addEventListener(
      'click',
      () => {
        (
          $('headline') as HTMLInputElement
        ).value = '';

        (
          $('organization') as HTMLInputElement
        ).value = '';

        (
          $('announcement') as HTMLTextAreaElement
        ).value = '';

        (
          $('type') as HTMLSelectElement
        ).value = 'product';

        (
          $('audience') as HTMLInputElement
        ).value = '';

        (
          $('location') as HTMLInputElement
        ).value = '';

        (
          $('date') as HTMLInputElement
        ).value = '';

        (
          $('quote') as HTMLTextAreaElement
        ).value = '';

        (
          $('contact') as HTMLInputElement
        ).value = '';

        (
          $('output') as HTMLTextAreaElement
        ).value = '';

        updateStats('');

        $('status')!.classList.add(
          'hidden'
        );
      }
    );

    updateStats('');
  </script>
</Layout>