---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="AI FAQ Generator | AIZENOVA">
  <main class="mx-auto max-w-4xl px-6 py-16 text-white">

    <a
      href="/ai-tools"
      class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
    >
      ← Back to AI Tools
    </a>

    <div class="mt-10 text-center">

      <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl">
        ❓
      </div>

      <h1 class="text-4xl font-bold sm:text-5xl">
        AI FAQ Generator
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-gray-400">
        Generate useful frequently asked questions and answers from any topic or article.
      </p>

    </div>

    <section class="mt-12 rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8">

      <div>
        <label
          for="topic"
          class="mb-3 block text-sm font-medium text-gray-200"
        >
          Topic or Article Content
        </label>

        <textarea
          id="topic"
          rows="8"
          maxlength="5000"
          placeholder="Example: Artificial intelligence for small businesses..."
          class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-4 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
        ></textarea>

        <div class="mt-2 flex justify-between text-xs text-gray-500">
          <span>
            Enter a topic, article summary, or existing content.
          </span>

          <span>
            <span id="charCount">0</span>/5000
          </span>
        </div>
      </div>

      <div class="mt-6 grid gap-5 sm:grid-cols-2">

        <div>
          <label
            for="language"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Language
          </label>

          <select
            id="language"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none"
          >
            <option value="English">English</option>
            <option value="French">French</option>
            <option value="Arabic">Arabic</option>
            <option value="Spanish">Spanish</option>
            <option value="German">German</option>
            <option value="Italian">Italian</option>
          </select>
        </div>

        <div>
          <label
            for="count"
            class="mb-3 block text-sm font-medium text-gray-200"
          >
            Number of FAQs
          </label>

          <select
            id="count"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none"
          >
            <option value="5">5 FAQs</option>
            <option value="8">8 FAQs</option>
            <option value="10" selected>10 FAQs</option>
            <option value="15">15 FAQs</option>
          </select>
        </div>

      </div>

      <button
        id="generateBtn"
        type="button"
        class="mt-6 w-full rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200 disabled:cursor-not-allowed disabled:opacity-50"
      >
        ✨ Generate FAQs
      </button>

      <div
        id="loading"
        class="mt-6 hidden rounded-xl border border-white/10 bg-white/[0.03] p-6 text-center"
      >
        <div class="animate-pulse text-2xl">✨</div>

        <p class="mt-2 text-sm text-gray-400">
          AI is generating your FAQs...
        </p>
      </div>

      <div
        id="errorContainer"
        class="mt-6 hidden rounded-xl border border-red-500/20 bg-red-500/5 p-4"
      >
        <p id="errorMessage" class="text-sm text-red-400"></p>
      </div>

      <div id="resultContainer" class="mt-8 hidden">

        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">

          <h2 class="text-lg font-semibold">
            Generated FAQs
          </h2>

          <div class="flex gap-2">

            <button
              id="regenerateBtn"
              type="button"
              class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
            >
              🔄 Regenerate
            </button>

            <button
              id="copyBtn"
              type="button"
              class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10 hover:text-white"
            >
              📋 Copy
            </button>

          </div>

        </div>

        <div
          id="result"
          class="min-h-[300px] whitespace-pre-wrap rounded-xl border border-white/10 bg-[#111118] p-5 leading-7 text-gray-200"
        ></div>

        <button
          id="clearBtn"
          type="button"
          class="mt-4 text-sm text-gray-500 transition hover:text-white"
        >
          Clear result
        </button>

      </div>

    </section>

    <section class="mt-10 grid gap-5 sm:grid-cols-3">

      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
        <div class="text-2xl">❓</div>

        <h3 class="mt-3 font-semibold">
          Relevant Questions
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Generate questions users are likely to ask.
        </p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
        <div class="text-2xl">💡</div>

        <h3 class="mt-3 font-semibold">
          Clear Answers
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Get simple and useful answers for each question.
        </p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
        <div class="text-2xl">🚀</div>

        <h3 class="mt-3 font-semibold">
          SEO Content
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Useful for building FAQ sections in your articles.
        </p>
      </div>

    </section>

  </main>

  <script>
    const topic =
      document.getElementById("topic") as HTMLTextAreaElement;

    const language =
      document.getElementById("language") as HTMLSelectElement;

    const count =
      document.getElementById("count") as HTMLSelectElement;

    const charCount =
      document.getElementById("charCount")!;

    const generateBtn =
      document.getElementById("generateBtn") as HTMLButtonElement;

    const loading =
      document.getElementById("loading")!;

    const errorContainer =
      document.getElementById("errorContainer")!;

    const errorMessage =
      document.getElementById("errorMessage")!;

    const resultContainer =
      document.getElementById("resultContainer")!;

    const result =
      document.getElementById("result")!;

    const regenerateBtn =
      document.getElementById("regenerateBtn") as HTMLButtonElement;

    const copyBtn =
      document.getElementById("copyBtn") as HTMLButtonElement;

    const clearBtn =
      document.getElementById("clearBtn") as HTMLButtonElement;

    let hasGenerated = false;

    topic.addEventListener("input", () => {
      charCount.textContent =
        String(topic.value.length);
    });

    function showError(message: string) {
      errorMessage.textContent = message;
      errorContainer.classList.remove("hidden");
    }

    function hideError() {
      errorContainer.classList.add("hidden");
      errorMessage.textContent = "";
    }

    async function generateFAQs() {
      hideError();

      const topicValue =
        topic.value.trim();

      if (!topicValue) {
        showError("Please enter a topic or article content.");
        topic.focus();
        return;
      }

      generateBtn.disabled = true;
      loading.classList.remove("hidden");
      resultContainer.classList.add("hidden");

      try {
        const response = await fetch(
          "/api/generate-faq",
          {
            method: "POST",

            headers: {
              "Content-Type": "application/json",
            },

            body: JSON.stringify({
              topic: topicValue,
              language: language.value,
              count: Number(count.value),
            }),
          }
        );

        const data = await response.json();

        if (!response.ok) {
          throw new Error(
            data?.error ||
            "Failed to generate FAQs."
          );
        }

        if (!data.text) {
          throw new Error(
            "The AI did not return any FAQs."
          );
        }

        result.textContent =
          data.text;

        resultContainer.classList.remove(
          "hidden"
        );

        hasGenerated = true;

      } catch (error) {
        console.error(error);

        showError(
          error instanceof Error
            ? error.message
            : "Something went wrong."
        );

      } finally {
        generateBtn.disabled = false;
        loading.classList.add("hidden");
      }
    }

    generateBtn.addEventListener(
      "click",
      generateFAQs
    );

    regenerateBtn.addEventListener(
      "click",
      () => {
        if (hasGenerated) {
          generateFAQs();
        }
      }
    );

    copyBtn.addEventListener(
      "click",
      async () => {
        const text =
          result.textContent?.trim();

        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);

          const oldText =
            copyBtn.textContent;

          copyBtn.textContent =
            "✅ Copied";

          setTimeout(() => {
            copyBtn.textContent =
              oldText;
          }, 1500);

        } catch {
          showError(
            "Could not copy the FAQs."
          );
        }
      }
    );

    clearBtn.addEventListener(
      "click",
      () => {
        result.textContent = "";

        resultContainer.classList.add(
          "hidden"
        );

        hideError();

        hasGenerated = false;
      }
    );
  </script>
</Layout>
```