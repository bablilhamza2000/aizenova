---
import Layout from '../../layouts/Layout.astro';

const pageTitle = 'AI YouTube Script Generator | AIZENOVA';
const pageDescription =
  'Generate structured YouTube video scripts from your topic, audience, and desired video length with AIZENOVA.';
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="mx-auto max-w-5xl px-6 py-12 text-white">

    <a
      href="/ai-tools"
      class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
    >
      ← Back to AI Tools
    </a>

    <header class="mt-10 text-center">
      <div
        class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
      >
        🎬
      </div>

      <h1 class="text-4xl font-bold sm:text-5xl">
        AI YouTube Script Generator
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-gray-400">
        Create a structured YouTube script with a hook, introduction,
        main points, and call to action.
      </p>
    </header>

    <section class="mt-12 grid gap-8 lg:grid-cols-2">

      <!-- INPUT -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8"
      >
        <h2 class="text-xl font-semibold">
          Video Details
        </h2>

        <p class="mt-2 text-sm text-gray-500">
          Add information about the video you want to create.
        </p>

        <div class="mt-7">
          <label
            for="topic"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Video Topic
          </label>

          <textarea
            id="topic"
            rows="6"
            placeholder="Example: How to start learning Python from zero"
            class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm leading-7 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>
        </div>

        <div class="mt-5">
          <label
            for="audience"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Target Audience
          </label>

          <input
            id="audience"
            type="text"
            placeholder="Example: Complete beginners"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-5">
          <label
            for="keyword"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Main Keyword
          </label>

          <input
            id="keyword"
            type="text"
            placeholder="Example: Learn Python"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-5">
          <label
            for="length"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Video Length
          </label>

          <select
            id="length"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white outline-none focus:border-white/30"
          >
            <option value="short">Short — 1–3 minutes</option>
            <option value="medium" selected>Medium — 5–8 minutes</option>
            <option value="long">Long — 10–15 minutes</option>
          </select>
        </div>

        <div class="mt-5">
          <label
            for="style"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Script Style
          </label>

          <select
            id="style"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white outline-none focus:border-white/30"
          >
            <option value="educational" selected>
              Educational
            </option>

            <option value="friendly">
              Friendly & Conversational
            </option>

            <option value="storytelling">
              Storytelling
            </option>

            <option value="professional">
              Professional
            </option>

            <option value="energetic">
              Energetic
            </option>
          </select>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <button
            id="generateBtn"
            type="button"
            class="flex-1 rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200"
          >
            Generate Script
          </button>

          <button
            id="clearBtn"
            type="button"
            class="rounded-xl border border-white/10 px-6 py-4 text-gray-300 transition hover:bg-white/10"
          >
            Clear
          </button>
        </div>

        <p
          id="status"
          class="mt-4 hidden text-center text-sm text-gray-400"
        ></p>
      </div>

      <!-- OUTPUT -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8 lg:sticky lg:top-8 lg:self-start"
      >
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold">
              Generated Script
            </h2>

            <p class="mt-1 text-sm text-gray-500">
              Your YouTube script will appear here.
            </p>
          </div>

          <button
            id="copyBtn"
            type="button"
            class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10"
          >
            Copy
          </button>
        </div>

        <textarea
          id="output"
          readonly
          rows="25"
          placeholder="Your generated script will appear here..."
          class="mt-6 w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-4 text-sm leading-7 text-gray-300 outline-none"
        ></textarea>

        <div class="mt-4 flex items-center justify-between text-xs text-gray-500">
          <span id="wordCount">
            0 words
          </span>

          <span id="charCount">
            0 characters
          </span>
        </div>
      </div>

    </section>

    <section class="mt-16 max-w-3xl">
      <h2 class="text-2xl font-bold">
        How to create a better YouTube script
      </h2>

      <div class="mt-5 space-y-4 text-sm leading-7 text-gray-400">
        <p>
          A strong YouTube script usually starts with a clear hook that gives
          viewers a reason to keep watching.
        </p>

        <p>
          Organize the main content into simple sections and keep each section
          focused on one idea.
        </p>

        <p>
          Finish with a natural call to action that encourages viewers to
          subscribe, comment, or explore another relevant video.
        </p>
      </div>
    </section>

  </main>

  <script>
    const $ = (id: string) =>
      document.getElementById(id);

    const getValue = (id: string) => {
      const element =
        document.getElementById(id) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | HTMLSelectElement
          | null;

      return element?.value.trim() || '';
    };

    const clean = (text: string) =>
      text.replace(/\s+/g, ' ').trim();

    function getStyleParts(style: string) {
      const styles: Record<
        string,
        {
          hook: string;
          transition: string;
          tone: string;
        }
      > = {
        educational: {
          hook:
            'Let’s break this down step by step so you can understand exactly how it works.',
          transition:
            'Now that we understand the basics, let’s move on to the next important point.',
          tone:
            'Keep the explanation clear, practical, and easy to follow.',
        },

        friendly: {
          hook:
            'Hey everyone! If you’ve been wondering about this, you’re in the right place.',
          transition:
            'Alright, now let’s take a closer look at this.',
          tone:
            'Keep the conversation natural, simple, and relatable.',
        },

        storytelling: {
          hook:
            'Imagine starting with absolutely no idea where to begin. That is exactly where our story starts.',
          transition:
            'But there is another important part of the story.',
          tone:
            'Use examples and a natural narrative flow.',
        },

        professional: {
          hook:
            'In this video, we’ll examine the key ideas you need to understand.',
          transition:
            'Let’s now look at the next key aspect.',
          tone:
            'Keep the language precise, structured, and professional.',
        },

        energetic: {
          hook:
            'Ready to learn something that can completely change the way you approach this?',
          transition:
            'And now, here’s where things get really interesting!',
          tone:
            'Keep the delivery energetic, direct, and engaging.',
        },
      };

      return styles[style] || styles.educational;
    }

    function createScript(
      topic: string,
      audience: string,
      keyword: string,
      length: string,
      style: string
    ) {
      const subject =
        clean(topic) || 'this topic';

      const target =
        clean(audience) || 'viewers';

      const mainKeyword =
        clean(keyword) || subject;

      const styleParts =
        getStyleParts(style);

      let sections = 5;

      if (length === 'short') {
        sections = 3;
      }

      if (length === 'long') {
        sections = 7;
      }

      const lines: string[] = [];

      lines.push(
        `TITLE: ${subject}`
      );

      lines.push('');

      lines.push(
        '[HOOK]'
      );

      lines.push(
        styleParts.hook
      );

      lines.push(
        `Today, we’re going to talk about ${subject} and show you what you need to know.`
      );

      lines.push(
        `By the end of this video, you should have a clearer understanding of ${mainKeyword}.`
      );

      lines.push('');

      lines.push(
        '[INTRODUCTION]'
      );

      lines.push(
        `Welcome back! In this video, we’re focusing on ${subject}.`
      );

      lines.push(
        `This video is designed for ${target}, so we’ll keep everything practical and easy to follow.`
      );

      lines.push(
        styleParts.tone
      );

      lines.push('');

      const mainSections = [
        {
          title: '1. Understanding the Basics',
          text:
            `First, let’s establish the basics. Before going deeper into ${mainKeyword}, it’s important to understand what it is, why it matters, and where it can be useful.`
        },

        {
          title: '2. The Most Important Things to Know',
          text:
            `The next step is understanding the most important parts of ${subject}. Focus on the ideas that provide the most value and avoid unnecessary complexity.`
        },

        {
          title: '3. Practical Steps',
          text:
            `Now let’s turn the theory into action. Start with one simple step, apply what you’ve learned, and gradually build from there. Consistency is usually more important than trying to learn everything at once.`
        },

        {
          title: '4. Common Mistakes',
          text:
            `One common mistake is trying to do too much too quickly. Another is relying only on theory without actually practicing. A better approach is to learn one concept, apply it, review the result, and then continue.`
        },

        {
          title: '5. Useful Tips',
          text:
            `Here are a few useful tips: keep your goal clear, practice regularly, take notes on what you learn, and use real examples whenever possible. These simple habits can make the learning process much easier.`
        },

        {
          title: '6. Example',
          text:
            `Let’s look at a simple example. Imagine you are starting with no previous experience. Instead of trying to understand everything immediately, focus on one small part of ${mainKeyword}, practice it, and then build on that knowledge.`
        },

        {
          title: '7. Final Takeaways',
          text:
            `The main idea is simple: understand the fundamentals, practice consistently, and improve step by step. Once you have a strong foundation, you can move toward more advanced concepts.`
        },
      ];

      for (
        let i = 0;
        i < sections;
        i++
      ) {
        const section =
          mainSections[i];

        lines.push(
          `[${section.title}]`
        );

        lines.push(
          section.text
        );

        if (i < sections - 1) {
          lines.push(
            styleParts.transition
          );
        }

        lines.push('');
      }

      lines.push(
        '[OUTRO]'
      );

      lines.push(
        `So, that’s the basic roadmap for ${subject}.`
      );

      lines.push(
        `If you found this video useful, make sure to like the video and subscribe for more helpful content.`
      );

      lines.push(
        `If you have a question about ${mainKeyword}, leave it in the comments below.`
      );

      lines.push('');

      lines.push(
        '[CALL TO ACTION]'
      );

      lines.push(
        `Thanks for watching! Subscribe for more videos and let me know what topic you’d like to see next.`
      );

      return lines.join('\n');
    }

    function updateStats(text: string) {
      const words =
        text.trim()
          ? text.trim().split(/\s+/).length
          : 0;

      const characters =
        text.length;

      $('wordCount')!.textContent =
        `${words} ${words === 1 ? 'word' : 'words'}`;

      $('charCount')!.textContent =
        `${characters} characters`;
    }

    function showStatus(message: string) {
      const status =
        $('status')!;

      status.textContent =
        message;

      status.classList.remove(
        'hidden'
      );

      setTimeout(() => {
        status.classList.add(
          'hidden'
        );
      }, 2500);
    }

    $('generateBtn')!.addEventListener(
      'click',
      () => {
        const topic =
          getValue('topic');

        if (!topic) {
          showStatus(
            'Please enter your video topic first.'
          );

          return;
        }

        const audience =
          getValue('audience');

        const keyword =
          getValue('keyword');

        const length =
          getValue('length');

        const style =
          getValue('style');

        const script =
          createScript(
            topic,
            audience,
            keyword,
            length,
            style
          );

        const output =
          $('output') as HTMLTextAreaElement;

        output.value =
          script;

        updateStats(
          script
        );

        showStatus(
          'YouTube script generated successfully.'
        );
      }
    );

    $('copyBtn')!.addEventListener(
      'click',
      async () => {
        const output =
          (
            $('output') as HTMLTextAreaElement
          ).value.trim();

        if (!output) {
          showStatus(
            'Generate a script first.'
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(
            output
          );

          const button =
            $('copyBtn')!;

          const original =
            button.textContent;

          button.textContent =
            'Copied!';

          setTimeout(() => {
            button.textContent =
              original;
          }, 1800);

        } catch {
          showStatus(
            'Unable to copy automatically.'
          );
        }
      }
    );

    $('clearBtn')!.addEventListener(
      'click',
      () => {
        (
          $('topic') as HTMLTextAreaElement
        ).value = '';

        (
          $('audience') as HTMLInputElement
        ).value = '';

        (
          $('keyword') as HTMLInputElement
        ).value = '';

        (
          $('length') as HTMLSelectElement
        ).value = 'medium';

        (
          $('style') as HTMLSelectElement
        ).value = 'educational';

        (
          $('output') as HTMLTextAreaElement
        ).value = '';

        updateStats('');

        $('status')!.classList.add(
          'hidden'
        );
      }
    );

    updateStats('');
  </script>
</Layout>