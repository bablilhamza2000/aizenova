---
import Layout from '../../layouts/Layout.astro';

const pageTitle = 'AI Job Description Generator | AIZENOVA';
const pageDescription =
  'Create professional job descriptions quickly with AIZENOVA’s free job description generator.';
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="mx-auto max-w-5xl px-6 py-12 text-white">

    <a
      href="/ai-tools"
      class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
    >
      ← Back to AI Tools
    </a>

    <header class="mt-10 text-center">
      <div
        class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
      >
        💼
      </div>

      <h1 class="text-4xl font-bold sm:text-5xl">
        AI Job Description Generator
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-gray-400">
        Create a clear and professional job description in seconds.
        Add the role, responsibilities, skills, and requirements to generate
        a polished description ready to use.
      </p>
    </header>

    <section class="mt-12 grid gap-8 lg:grid-cols-2">

      <!-- FORM -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8"
      >
        <h2 class="text-xl font-semibold">
          Job Details
        </h2>

        <p class="mt-2 text-sm text-gray-500">
          Enter the information about the position.
        </p>

        <!-- Job title -->
        <div class="mt-7">
          <label
            for="jobTitle"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Job Title
          </label>

          <input
            id="jobTitle"
            type="text"
            placeholder="e.g. Frontend Developer"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <!-- Company -->
        <div class="mt-5">
          <label
            for="company"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Company Name
          </label>

          <input
            id="company"
            type="text"
            placeholder="e.g. AIZENOVA"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <!-- Location -->
        <div class="mt-5">
          <label
            for="location"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Location
          </label>

          <input
            id="location"
            type="text"
            placeholder="e.g. Remote, Paris, New York"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <!-- Employment type -->
        <div class="mt-5">
          <label
            for="employmentType"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Employment Type
          </label>

          <select
            id="employmentType"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="Full-time">Full-time</option>
            <option value="Part-time">Part-time</option>
            <option value="Contract">Contract</option>
            <option value="Temporary">Temporary</option>
            <option value="Internship">Internship</option>
            <option value="Freelance">Freelance</option>
          </select>
        </div>

        <!-- Experience -->
        <div class="mt-5">
          <label
            for="experience"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Experience Level
          </label>

          <select
            id="experience"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="Entry-level">Entry-level</option>
            <option value="Junior">Junior</option>
            <option value="Mid-level">Mid-level</option>
            <option value="Senior">Senior</option>
            <option value="Lead / Manager">Lead / Manager</option>
          </select>
        </div>

        <!-- Responsibilities -->
        <div class="mt-5">
          <label
            for="responsibilities"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Responsibilities
          </label>

          <textarea
            id="responsibilities"
            rows="6"
            placeholder="e.g. Build web applications, collaborate with designers, maintain existing features..."
            class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>

          <p class="mt-2 text-xs text-gray-500">
            Separate responsibilities with commas or write them on separate lines.
          </p>
        </div>

        <!-- Skills -->
        <div class="mt-5">
          <label
            for="skills"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Required Skills
          </label>

          <textarea
            id="skills"
            rows="5"
            placeholder="e.g. JavaScript, React, communication, problem solving..."
            class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>
        </div>

        <!-- Qualifications -->
        <div class="mt-5">
          <label
            for="qualifications"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Qualifications
          </label>

          <textarea
            id="qualifications"
            rows="4"
            placeholder="e.g. Bachelor's degree, 2+ years of experience..."
            class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>
        </div>

        <!-- Benefits -->
        <div class="mt-5">
          <label
            for="benefits"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Benefits
          </label>

          <textarea
            id="benefits"
            rows="4"
            placeholder="e.g. Flexible hours, remote work, health insurance..."
            class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>
        </div>

        <!-- Tone -->
        <div class="mt-5">
          <label
            for="tone"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Writing Style
          </label>

          <select
            id="tone"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-white outline-none transition focus:border-white/30"
          >
            <option value="professional">Professional</option>
            <option value="modern">Modern & Engaging</option>
            <option value="formal">Formal</option>
            <option value="friendly">Friendly</option>
          </select>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">

          <button
            id="generateBtn"
            type="button"
            class="flex-1 rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200"
          >
            Generate Job Description
          </button>

          <button
            id="clearBtn"
            type="button"
            class="rounded-xl border border-white/10 px-6 py-4 text-gray-300 transition hover:bg-white/10"
          >
            Clear
          </button>

        </div>

        <p
          id="status"
          class="mt-4 hidden text-center text-sm text-gray-400"
        ></p>
      </div>

      <!-- PREVIEW -->
      <div class="lg:sticky lg:top-8 lg:self-start">

        <div class="mb-4 flex items-center justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold">
              Job Description Preview
            </h2>

            <p class="mt-1 text-sm text-gray-500">
              Review and edit the generated description.
            </p>
          </div>

          <button
            id="copyBtn"
            type="button"
            class="shrink-0 rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10"
          >
            Copy
          </button>
        </div>

        <article
          id="preview"
          class="overflow-hidden rounded-xl border border-white/10 bg-white text-gray-900 shadow-2xl"
        >

          <!-- Preview header -->
          <div class="border-b border-gray-200 p-7 sm:p-9">

            <div class="flex flex-wrap items-start justify-between gap-4">

              <div>
                <p
                  id="previewCompany"
                  class="text-sm font-semibold uppercase tracking-wider text-gray-500"
                >
                  Company Name
                </p>

                <h2
                  id="previewTitle"
                  class="mt-2 text-3xl font-bold"
                >
                  Job Title
                </h2>
              </div>

              <span
                id="previewType"
                class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-600"
              >
                Full-time
              </span>

            </div>

            <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-500">

              <span id="previewLocation">
                📍 Location
              </span>

              <span id="previewExperience">
                💼 Entry-level
              </span>

            </div>

          </div>

          <!-- Preview body -->
          <div class="p-7 sm:p-9">

            <section>
              <h3 class="text-lg font-bold">
                About the Role
              </h3>

              <p
                id="previewIntro"
                class="mt-3 whitespace-pre-line text-sm leading-7 text-gray-600"
              >
                The job description will appear here.
              </p>
            </section>

            <section class="mt-8">
              <h3 class="text-lg font-bold">
                Responsibilities
              </h3>

              <ul
                id="previewResponsibilities"
                class="mt-3 space-y-2 text-sm leading-7 text-gray-600"
              >
                <li>Responsibilities will appear here.</li>
              </ul>
            </section>

            <section class="mt-8">
              <h3 class="text-lg font-bold">
                Required Skills
              </h3>

              <ul
                id="previewSkills"
                class="mt-3 space-y-2 text-sm leading-7 text-gray-600"
              >
                <li>Required skills will appear here.</li>
              </ul>
            </section>

            <section class="mt-8">
              <h3 class="text-lg font-bold">
                Qualifications
              </h3>

              <ul
                id="previewQualifications"
                class="mt-3 space-y-2 text-sm leading-7 text-gray-600"
              >
                <li>Qualifications will appear here.</li>
              </ul>
            </section>

            <section class="mt-8">
              <h3 class="text-lg font-bold">
                Benefits
              </h3>

              <ul
                id="previewBenefits"
                class="mt-3 space-y-2 text-sm leading-7 text-gray-600"
              >
                <li>Benefits will appear here.</li>
              </ul>
            </section>

            <section class="mt-8 border-t border-gray-200 pt-7">
              <h3 class="text-lg font-bold">
                How to Apply
              </h3>

              <p
                id="previewApply"
                class="mt-3 text-sm leading-7 text-gray-600"
              >
                Interested candidates are encouraged to apply for this
                position.
              </p>
            </section>

          </div>

        </article>

      </div>

    </section>

    <!-- SEO section -->
    <section class="mt-16 max-w-3xl">

      <h2 class="text-2xl font-bold">
        How to write an effective job description
      </h2>

      <div class="mt-5 space-y-4 text-sm leading-7 text-gray-400">

        <p>
          A good job description clearly explains what the position involves,
          what qualifications candidates need, and what they can expect from
          the company.
        </p>

        <p>
          Keep responsibilities specific and focus on the skills and
          qualifications that are genuinely important for the role.
        </p>

        <p>
          Including information about company benefits, work location,
          employment type, and career opportunities can also help attract
          relevant candidates.
        </p>

      </div>

    </section>

  </main>

  <script>
    const $ = (id: string) =>
      document.getElementById(id);

    function getValue(id: string) {
      const element =
        document.getElementById(id) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | HTMLSelectElement
          | null;

      return element?.value.trim() || "";
    }

    function splitItems(text: string) {
      return text
        .split(/\n|,/)
        .map((item) => item.trim())
        .filter(Boolean);
    }

    function escapeHTML(text: string) {
      const div =
        document.createElement("div");

      div.textContent = text;

      return div.innerHTML;
    }

    function createList(
      items: string[],
      fallback: string
    ) {
      if (!items.length) {
        return `
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gray-400"></span>
            <span>${escapeHTML(fallback)}</span>
          </li>
        `;
      }

      return items
        .map(
          (item) => `
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gray-400"></span>
              <span>${escapeHTML(item)}</span>
            </li>
          `
        )
        .join("");
    }

    function generateJobDescription() {
      const jobTitle =
        getValue("jobTitle");

      const company =
        getValue("company");

      const location =
        getValue("location");

      const employmentType =
        getValue("employmentType");

      const experience =
        getValue("experience");

      const responsibilities =
        splitItems(
          getValue("responsibilities")
        );

      const skills =
        splitItems(
          getValue("skills")
        );

      const qualifications =
        splitItems(
          getValue("qualifications")
        );

      const benefits =
        splitItems(
          getValue("benefits")
        );

      const tone =
        getValue("tone");

      const title =
        jobTitle || "Job Title";

      const companyName =
        company || "Company Name";

      const jobLocation =
        location || "Location";

      let intro = "";

      if (tone === "modern") {
        intro =
          `${companyName} is looking for a motivated ${experience.toLowerCase()} ${title} to join our team. This is an exciting opportunity for someone who enjoys solving problems, collaborating with others, and making a meaningful impact.`;
      } else if (tone === "formal") {
        intro =
          `${companyName} is seeking a qualified ${experience.toLowerCase()} ${title} to join its organization. The successful candidate will be responsible for contributing to key business objectives while maintaining high professional standards.`;
      } else if (tone === "friendly") {
        intro =
          `We are looking for a talented ${experience.toLowerCase()} ${title} to join ${companyName}. If you enjoy learning, collaborating, and doing great work, we would love to hear from you.`;
      } else {
        intro =
          `${companyName} is seeking a ${experience.toLowerCase()} ${title} to join our team. The successful candidate will contribute to key projects, collaborate with colleagues, and help achieve organizational goals.`;
      }

      const responsibilityItems =
        responsibilities.length
          ? responsibilities
          : [
              `Perform key responsibilities associated with the ${title} role`,
              "Collaborate with team members and relevant stakeholders",
              "Contribute to projects and organizational objectives",
              "Maintain high standards of quality and professionalism",
            ];

      const skillItems =
        skills.length
          ? skills
          : [
              "Strong communication and collaboration skills",
              "Problem-solving and analytical abilities",
              "Ability to work independently and as part of a team",
              "Strong attention to detail",
            ];

      const qualificationItems =
        qualifications.length
          ? qualifications
          : [
              `${experience} level experience in a relevant field`,
              "Strong organizational and communication skills",
              "Ability to learn and adapt to new challenges",
            ];

      const benefitItems =
        benefits.length
          ? benefits
          : [
              "Competitive compensation",
              "Professional development opportunities",
              "Collaborative working environment",
            ];

      $("previewCompany")!.textContent =
        companyName;

      $("previewTitle")!.textContent =
        title;

      $("previewType")!.textContent =
        employmentType;

      $("previewLocation")!.textContent =
        `📍 ${jobLocation}`;

      $("previewExperience")!.textContent =
        `💼 ${experience}`;

      $("previewIntro")!.textContent =
        intro;

      $("previewResponsibilities")!.innerHTML =
        createList(
          responsibilityItems,
          "Responsibilities will appear here."
        );

      $("previewSkills")!.innerHTML =
        createList(
          skillItems,
          "Required skills will appear here."
        );

      $("previewQualifications")!.innerHTML =
        createList(
          qualificationItems,
          "Qualifications will appear here."
        );

      $("previewBenefits")!.innerHTML =
        createList(
          benefitItems,
          "Benefits will appear here."
        );

      $("previewApply")!.textContent =
        `Interested candidates are encouraged to apply for the ${title} position at ${companyName}. Please submit your application and relevant materials through the company's preferred application process.`;
    }

    const fields = [
      "jobTitle",
      "company",
      "location",
      "employmentType",
      "experience",
      "responsibilities",
      "skills",
      "qualifications",
      "benefits",
      "tone",
    ];

    fields.forEach((id) => {
      const element =
        document.getElementById(id);

      element?.addEventListener(
        "input",
        generateJobDescription
      );

      element?.addEventListener(
        "change",
        generateJobDescription
      );
    });

    $("generateBtn")!.addEventListener(
      "click",
      () => {
        generateJobDescription();

        const status =
          $("status")!;

        status.textContent =
          "Job description generated successfully.";

        status.classList.remove(
          "hidden"
        );

        setTimeout(() => {
          status.classList.add(
            "hidden"
          );
        }, 3000);

        $("preview")!.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }
    );

    $("clearBtn")!.addEventListener(
      "click",
      () => {

        fields.forEach((id) => {
          const element =
            document.getElementById(id) as
              | HTMLInputElement
              | HTMLTextAreaElement
              | HTMLSelectElement
              | null;

          if (!element) return;

          if (
            element instanceof HTMLSelectElement
          ) {
            element.selectedIndex = 0;
          } else {
            element.value = "";
          }
        });

        generateJobDescription();

        $("status")!.classList.add(
          "hidden"
        );
      }
    );

    $("copyBtn")!.addEventListener(
      "click",
      async () => {

        const title =
          getValue("jobTitle") ||
          "Job Title";

        const company =
          getValue("company") ||
          "Company Name";

        const location =
          getValue("location") ||
          "Location";

        const employmentType =
          getValue("employmentType");

        const experience =
          getValue("experience");

        const responsibilities =
          splitItems(
            getValue("responsibilities")
          );

        const skills =
          splitItems(
            getValue("skills")
          );

        const qualifications =
          splitItems(
            getValue("qualifications")
          );

        const benefits =
          splitItems(
            getValue("benefits")
          );

        const text = `
${title}
${company}
${employmentType} | ${experience} | ${location}

ABOUT THE ROLE

${$("previewIntro")!.textContent}

RESPONSIBILITIES

${responsibilities.length
  ? responsibilities.map((item) => `• ${item}`).join("\n")
  : "• Perform key responsibilities associated with the role"
}

REQUIRED SKILLS

${skills.length
  ? skills.map((item) => `• ${item}`).join("\n")
  : "• Strong communication and problem-solving skills"
}

QUALIFICATIONS

${qualifications.length
  ? qualifications.map((item) => `• ${item}`).join("\n")
  : "• Relevant experience and qualifications"
}

BENEFITS

${benefits.length
  ? benefits.map((item) => `• ${item}`).join("\n")
  : "• Professional development opportunities"
}

HOW TO APPLY

${$("previewApply")!.textContent}
`.trim();

        try {
          await navigator.clipboard.writeText(
            text
          );

          const button =
            $("copyBtn")!;

          const original =
            button.textContent;

          button.textContent =
            "Copied!";

          setTimeout(() => {
            button.textContent =
              original;
          }, 2000);

        } catch {
          const status =
            $("status")!;

          status.textContent =
            "Unable to copy automatically. Please select and copy the text manually.";

          status.classList.remove(
            "hidden"
          );
        }
      }
    );

    generateJobDescription();
  </script>
</Layout>