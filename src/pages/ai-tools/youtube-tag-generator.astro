---
import Layout from '../../layouts/Layout.astro';

const pageTitle = 'AI YouTube Tag Generator | AIZENOVA';
const pageDescription =
  'Generate relevant YouTube tags and keywords for your videos with AIZENOVA.';
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="mx-auto max-w-5xl px-6 py-12 text-white">

    <a
      href="/ai-tools"
      class="inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white"
    >
      ← Back to AI Tools
    </a>

    <header class="mt-10 text-center">
      <div
        class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl"
      >
        🏷️
      </div>

      <h1 class="text-4xl font-bold sm:text-5xl">
        AI YouTube Tag Generator
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-gray-400">
        Generate relevant YouTube tags and keyword ideas based on your video
        topic.
      </p>
    </header>

    <section class="mt-12 grid gap-8 lg:grid-cols-2">

      <!-- INPUT -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8"
      >
        <h2 class="text-xl font-semibold">
          Video Details
        </h2>

        <p class="mt-2 text-sm text-gray-500">
          Enter your topic and generate related tags.
        </p>

        <div class="mt-7">
          <label
            for="topic"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Video Topic
          </label>

          <textarea
            id="topic"
            rows="6"
            placeholder="Example: How to learn Python for beginners"
            class="w-full resize-y rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm leading-7 text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          ></textarea>
        </div>

        <div class="mt-5">
          <label
            for="keyword"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Main Keyword
          </label>

          <input
            id="keyword"
            type="text"
            placeholder="Example: Learn Python"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-5">
          <label
            for="audience"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Target Audience
          </label>

          <input
            id="audience"
            type="text"
            placeholder="Example: Beginners, students"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white placeholder-gray-500 outline-none transition focus:border-white/30"
          />
        </div>

        <div class="mt-5">
          <label
            for="count"
            class="mb-2 block text-sm font-medium text-gray-300"
          >
            Number of Tags
          </label>

          <select
            id="count"
            class="w-full rounded-xl border border-white/10 bg-[#111118] px-4 py-3 text-sm text-white outline-none focus:border-white/30"
          >
            <option value="10">10 Tags</option>
            <option value="20" selected>20 Tags</option>
            <option value="30">30 Tags</option>
            <option value="40">40 Tags</option>
          </select>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <button
            id="generateBtn"
            type="button"
            class="flex-1 rounded-xl bg-white px-6 py-4 font-semibold text-black transition hover:bg-gray-200"
          >
            Generate Tags
          </button>

          <button
            id="clearBtn"
            type="button"
            class="rounded-xl border border-white/10 px-6 py-4 text-gray-300 transition hover:bg-white/10"
          >
            Clear
          </button>
        </div>

        <p
          id="status"
          class="mt-4 hidden text-center text-sm text-gray-400"
        ></p>
      </div>

      <!-- OUTPUT -->
      <div
        class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8 lg:sticky lg:top-8 lg:self-start"
      >
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold">
              Generated Tags
            </h2>

            <p class="mt-1 text-sm text-gray-500">
              Click a tag to copy it.
            </p>
          </div>

          <button
            id="copyAllBtn"
            type="button"
            class="rounded-lg border border-white/10 px-4 py-2 text-sm text-gray-300 transition hover:bg-white/10"
          >
            Copy All
          </button>
        </div>

        <div
          id="results"
          class="mt-6 min-h-[330px] rounded-xl border border-white/10 bg-[#111118] p-5"
        >
          <div class="flex min-h-[280px] items-center justify-center text-center">
            <div>
              <div class="text-4xl">🏷️</div>

              <h3 class="mt-4 font-semibold">
                Ready to generate?
              </h3>

              <p class="mt-2 max-w-sm text-sm leading-6 text-gray-500">
                Enter your video topic and generate relevant YouTube tags.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-4 text-xs text-gray-500">
          <span id="tagCount">0 tags</span>
        </div>
      </div>

    </section>

    <section class="mt-16 max-w-3xl">
      <h2 class="text-2xl font-bold">
        What are YouTube tags?
      </h2>

      <div class="mt-5 space-y-4 text-sm leading-7 text-gray-400">
        <p>
          YouTube tags are descriptive keywords that can help provide
          additional context about your video.
        </p>

        <p>
          The most important part of YouTube optimization is creating useful
          content with clear titles and descriptions. Tags should remain
          relevant to the actual video.
        </p>

        <p>
          Use the generated suggestions as ideas and remove anything that does
          not accurately describe your content.
        </p>
      </div>
    </section>

  </main>

  <script>
    const $ = (id: string) =>
      document.getElementById(id);

    const getValue = (id: string) => {
      const element =
        document.getElementById(id) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | HTMLSelectElement
          | null;

      return element?.value.trim() || '';
    };

    const clean = (text: string) =>
      text
        .replace(/[^\p{L}\p{N}\s-]/gu, '')
        .replace(/\s+/g, ' ')
        .trim();

    const titleCase = (text: string) =>
      text
        .split(' ')
        .map(
          (word) =>
            word.charAt(0).toUpperCase() +
            word.slice(1)
        )
        .join(' ');

    function generateTags(
      topic: string,
      keyword: string,
      audience: string
    ) {
      const cleanTopic = clean(topic);
      const cleanKeyword = clean(keyword);
      const cleanAudience = clean(audience);

      const base =
        cleanKeyword || cleanTopic;

      const words =
        base
          .split(/\s+/)
          .filter(
            (word) => word.length > 2
          );

      const tags = [
        base,
        cleanTopic,
        `${base} tutorial`,
        `${base} guide`,
        `${base} for beginners`,
        `learn ${base}`,
        `how to ${base}`,
        `${base} tips`,
        `${base} explained`,
        `${base} step by step`,
        `${base} tutorial for beginners`,
        `${base} tips and tricks`,
        `${base} basics`,
        `${base} course`,
        `${base} training`,
        `${base} 2026`,
        `best ${base}`,
        `${base} beginner guide`,
        `how to learn ${base}`,
        `${base} easy`,
        ...words,
        ...words.map(
          (word) => `learn ${word}`
        ),
        ...words.map(
          (word) => `${word} tutorial`
        ),
      ];

      if (cleanAudience) {
        tags.push(
          `${base} for ${cleanAudience}`,
          `learn ${base} for ${cleanAudience}`,
          `${cleanAudience} ${base}`
        );
      }

      const unique = [
        ...new Set(
          tags
            .map((tag) => tag.trim())
            .filter(
              (tag) => tag.length > 1
            )
        ),
      ];

      return unique;
    }

    function escapeHTML(text: string) {
      const div =
        document.createElement('div');

      div.textContent = text;

      return div.innerHTML;
    }

    function renderTags(tags: string[]) {
      const results =
        $('results')!;

      results.innerHTML = '';

      const wrapper =
        document.createElement('div');

      wrapper.className =
        'flex flex-wrap gap-2';

      tags.forEach((tag) => {
        const button =
          document.createElement('button');

        button.type = 'button';

        button.className =
          'group rounded-lg border border-white/10 bg-white/[0.04] px-3 py-2 text-sm text-gray-300 transition hover:border-white/20 hover:bg-white/10 hover:text-white';

        button.innerHTML = `
          <span>${escapeHTML(tag)}</span>
          <span class="ml-2 text-xs text-gray-600 group-hover:text-gray-400">
            Copy
          </span>
        `;

        button.addEventListener(
          'click',
          async () => {
            try {
              await navigator.clipboard.writeText(
                tag
              );

              const original =
                button.innerHTML;

              button.innerHTML = `
                <span>${escapeHTML(tag)}</span>
                <span class="ml-2 text-xs text-gray-300">
                  Copied!
                </span>
              `;

              setTimeout(() => {
                button.innerHTML =
                  original;
              }, 1500);

            } catch {
              showStatus(
                'Unable to copy automatically.'
              );
            }
          }
        );

        wrapper.appendChild(button);
      });

      results.appendChild(wrapper);
    }

    let currentTags: string[] = [];

    function showStatus(message: string) {
      const status =
        $('status')!;

      status.textContent = message;
      status.classList.remove('hidden');

      setTimeout(() => {
        status.classList.add('hidden');
      }, 2500);
    }

    $('generateBtn')!.addEventListener(
      'click',
      () => {
        const topic =
          getValue('topic');

        if (!topic) {
          showStatus(
            'Please enter your video topic first.'
          );
          return;
        }

        const keyword =
          getValue('keyword');

        const audience =
          getValue('audience');

        const count =
          Number(
            getValue('count') || '20'
          );

        const allTags =
          generateTags(
            topic,
            keyword,
            audience
          );

        currentTags =
          allTags.slice(
            0,
            count
          );

        renderTags(
          currentTags
        );

        $('tagCount')!.textContent =
          `${currentTags.length} tags`;

        showStatus(
          'YouTube tags generated successfully.'
        );
      }
    );

    $('copyAllBtn')!.addEventListener(
      'click',
      async () => {
        if (!currentTags.length) {
          showStatus(
            'Generate tags first.'
          );
          return;
        }

        const text =
          currentTags.join(', ');

        try {
          await navigator.clipboard.writeText(
            text
          );

          const button =
            $('copyAllBtn')!;

          const original =
            button.textContent;

          button.textContent =
            'Copied!';

          setTimeout(() => {
            button.textContent =
              original;
          }, 1800);

        } catch {
          showStatus(
            'Unable to copy automatically.'
          );
        }
      }
    );

    $('clearBtn')!.addEventListener(
      'click',
      () => {
        (
          $('topic') as HTMLTextAreaElement
        ).value = '';

        (
          $('keyword') as HTMLInputElement
        ).value = '';

        (
          $('audience') as HTMLInputElement
        ).value = '';

        (
          $('count') as HTMLSelectElement
        ).value = '20';

        currentTags = [];

        $('results')!.innerHTML = `
          <div class="flex min-h-[280px] items-center justify-center text-center">
            <div>
              <div class="text-4xl">🏷️</div>

              <h3 class="mt-4 font-semibold">
                Ready to generate?
              </h3>

              <p class="mt-2 max-w-sm text-sm leading-6 text-gray-500">
                Enter your video topic and generate relevant YouTube tags.
              </p>
            </div>
          </div>
        `;

        $('tagCount')!.textContent =
          '0 tags';

        $('status')!.classList.add(
          'hidden'
        );
      }
    );
  </script>
</Layout>