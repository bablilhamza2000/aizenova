---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'AIZENOVA | AI, Technology, Programming & Business',
  description:
    'AIZENOVA is your destination for Artificial Intelligence, Technology, Programming, Business, SEO, Digital Marketing and practical tutorials.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Explore Blog',
        href: '/blog',
      },
      {
        text: 'Search',
        href: '/search',
      },
      {
        text: 'About Us',
        href: '/about',
      },
    ]}
    image={{
      src: '~/assets/images/hero-image.png',
      alt: 'AIZENOVA - AI, Technology and Programming',
    }}
  >
    <Fragment slot="title">
      AI, Technology, Programming & Digital Innovation
    </Fragment>

    <Fragment slot="subtitle">
      Welcome to <strong>AIZENOVA</strong>, your trusted destination for
      Artificial Intelligence, Programming, Technology, Business, SEO,
      Digital Marketing and practical step-by-step tutorials designed to help
      you learn, build and grow your skills.
    </Fragment>
  </Hero>

  <Features
    id="features"
    tagline="Why AIZENOVA?"
    title="Everything you need to learn and grow"
    subtitle="Explore high-quality articles, expert reviews, practical tutorials and in-depth guides across today's most important technologies."
    items={[
      {
        title: 'Artificial Intelligence',
        description: 'ChatGPT, Gemini, Claude, AI tools, automation and productivity.',
        icon: 'tabler:brain',
      },
      {
        title: 'Programming',
        description: 'Python, JavaScript, React, Astro, APIs and modern web development.',
        icon: 'tabler:code',
      },
      {
        title: 'Technology',
        description: 'Latest technology news, software, smartphones, laptops and digital tools.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Business',
        description: 'Online business, freelancing, blogging and digital entrepreneurship.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'SEO',
        description: 'Search Engine Optimization, Google ranking and website growth strategies.',
        icon: 'tabler:search',
      },
      {
        title: 'Tutorials',
        description: 'Beginner-friendly guides and advanced tutorials with practical examples.',
        icon: 'tabler:book',
      },
    ]}
  />

  <BlogLatestPosts
    title="Latest Articles"
    information="Discover the latest AI news, technology updates, programming tutorials and business guides published on AIZENOVA."
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Explore All Articles',
        href: '/blog',
      },
      {
        text: 'Search Articles',
        href: '/search',
      },
    ]}
  >
    <Fragment slot="title">
      Learn. Build. Innovate.
    </Fragment>

    <Fragment slot="subtitle">
      Join thousands of readers exploring Artificial Intelligence,
      Programming, Technology, Business, SEO and Digital Innovation with
      practical tutorials and expert insights from AIZENOVA.
    </Fragment>
  </CallToAction>

</Layout>