---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'AIZENOVA | AI, Technology, Programming & Business',
  description:
    'AIZENOVA is your destination for Artificial Intelligence, Technology, Programming, Business, SEO, Digital Marketing and practical tutorials.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Explore AI Tools',
        href: '/ai-tools',
      },
      {
        text: 'Explore Blog',
        href: '/blog',
      },
      {
        text: 'About Us',
        href: '/about',
      },
    ]}
    image={{
      src: '~/assets/images/hero-image.png',
      alt: 'AIZENOVA - AI, Technology and Programming',
    }}
  >
    <Fragment slot="title">
      AI, Technology, Programming & Digital Innovation
    </Fragment>

    <Fragment slot="subtitle">
      Welcome to <strong>AIZENOVA</strong>, your trusted destination for
      Artificial Intelligence, Programming, Technology, Business, SEO,
      Digital Marketing and practical step-by-step tutorials designed to help
      you learn, build and grow your skills.
    </Fragment>
  </Hero>

  <Features
    id="features"
    tagline="Why AIZENOVA?"
    title="Everything you need to learn and grow"
    subtitle="Explore high-quality articles, expert reviews, practical tutorials and in-depth guides across today's most important technologies."
    items={[
      {
        title: 'Artificial Intelligence',
        description:
          'ChatGPT, Gemini, Claude, AI tools, automation and productivity.',
        icon: 'tabler:brain',
      },
      {
        title: 'Programming',
        description:
          'Python, JavaScript, React, Astro, APIs and modern web development.',
        icon: 'tabler:code',
      },
      {
        title: 'Technology',
        description:
          'Latest technology news, software, smartphones, laptops and digital tools.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Business',
        description:
          'Online business, freelancing, blogging and digital entrepreneurship.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'SEO',
        description:
          'Search Engine Optimization, Google ranking and website growth strategies.',
        icon: 'tabler:search',
      },
      {
        title: 'Tutorials',
        description:
          'Beginner-friendly guides and advanced tutorials with practical examples.',
        icon: 'tabler:book',
      },
    ]}
  />

  <!-- AI TOOLS -->
  <section class="mx-auto max-w-7xl px-6 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary">
        AIZENOVA AI Tools
      </p>

      <h2 class="text-3xl font-bold sm:text-4xl">
        Powerful AI Tools for Everyday Work
      </h2>

      <p class="mt-4 text-lg text-gray-500 dark:text-gray-400">
        Create, write, summarize, improve and work smarter with practical AI
        tools built for students, professionals, creators and businesses.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">

      <a
        href="/ai-tools/resume-builder"
        class="group rounded-2xl border border-gray-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-xl dark:border-gray-700 dark:bg-gray-900"
      >
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-2xl">
          📄
        </div>

        <h3 class="mt-5 text-xl font-semibold">
          AI Resume Builder
        </h3>

        <p class="mt-2 text-gray-500 dark:text-gray-400">
          Create a professional resume quickly with an easy-to-use AI-powered
          builder.
        </p>

        <span class="mt-5 inline-block text-sm font-semibold">
          Try it →
        </span>
      </a>

      <a
        href="/ai-tools/email-writer"
        class="group rounded-2xl border border-gray-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-xl dark:border-gray-700 dark:bg-gray-900"
      >
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-2xl">
          ✉️
        </div>

        <h3 class="mt-5 text-xl font-semibold">
          AI Email Writer
        </h3>

        <p class="mt-2 text-gray-500 dark:text-gray-400">
          Write clear and professional emails for work, business and everyday
          communication.
        </p>

        <span class="mt-5 inline-block text-sm font-semibold">
          Try it →
        </span>
      </a>

      <a
        href="/ai-tools/summarizer"
        class="group rounded-2xl border border-gray-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-xl dark:border-gray-700 dark:bg-gray-900"
      >
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-2xl">
          📝
        </div>

        <h3 class="mt-5 text-xl font-semibold">
          AI Summarizer
        </h3>

        <p class="mt-2 text-gray-500 dark:text-gray-400">
          Turn long articles and text into concise summaries that are easier
          to understand.
        </p>

        <span class="mt-5 inline-block text-sm font-semibold">
          Try it →
        </span>
      </a>

      <a
        href="/ai-tools/proofreader"
        class="group rounded-2xl border border-gray-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-xl dark:border-gray-700 dark:bg-gray-900"
      >
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-2xl">
          ✍️
        </div>

        <h3 class="mt-5 text-xl font-semibold">
          AI Proofreader
        </h3>

        <p class="mt-2 text-gray-500 dark:text-gray-400">
          Improve grammar, spelling, punctuation and readability in your
          writing.
        </p>

        <span class="mt-5 inline-block text-sm font-semibold">
          Try it →
        </span>
      </a>

      <a
        href="/ai-tools/email-subject-generator"
        class="group rounded-2xl border border-gray-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-xl dark:border-gray-700 dark:bg-gray-900"
      >
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-2xl">
          📧
        </div>

        <h3 class="mt-5 text-xl font-semibold">
          Email Subject Generator
        </h3>

        <p class="mt-2 text-gray-500 dark:text-gray-400">
          Generate engaging subject lines designed to improve email
          open rates.
        </p>

        <span class="mt-5 inline-block text-sm font-semibold">
          Try it →
        </span>
      </a>

      <a
        href="/ai-tools/press-release-generator"
        class="group rounded-2xl border border-gray-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-xl dark:border-gray-700 dark:bg-gray-900"
      >
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-2xl">
          📰
        </div>

        <h3 class="mt-5 text-xl font-semibold">
          Press Release Generator
        </h3>

        <p class="mt-2 text-gray-500 dark:text-gray-400">
          Create professional press releases for launches, announcements,
          events and company news.
        </p>

        <span class="mt-5 inline-block text-sm font-semibold">
          Try it →
        </span>
      </a>

    </div>

    <div class="mt-10 text-center">
      <a
        href="/ai-tools"
        class="inline-flex items-center justify-center rounded-xl bg-primary px-7 py-3.5 font-semibold text-white transition hover:opacity-90"
      >
        View All AI Tools
        <span class="ml-2">→</span>
      </a>
    </div>
  </section>

  <BlogLatestPosts
    title="Latest Articles"
    information="Discover the latest AI news, technology updates, programming tutorials and business guides published on AIZENOVA."
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Explore All Articles',
        href: '/blog',
      },
      {
        text: 'Explore AI Tools',
        href: '/ai-tools',
      },
      {
        text: 'Search Articles',
        href: '/search',
      },
    ]}
  >
    <Fragment slot="title">
      Learn. Build. Innovate.
    </Fragment>

    <Fragment slot="subtitle">
      Join thousands of readers exploring Artificial Intelligence,
      Programming, Technology, Business, SEO and Digital Innovation with
      practical tutorials and expert insights from AIZENOVA.
    </Fragment>
  </CallToAction>

</Layout>