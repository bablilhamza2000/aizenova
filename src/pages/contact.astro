---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact Us',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contact AIZENOVA"
    title="Let's Build the Future Together"
  />

  <ContactUs
    id="form"
    title="Send us a message"
    subtitle="Have a question, feedback, partnership proposal or business inquiry? We'd love to hear from you."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Full Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email Address',
      },
    ]}
    textarea={{
      label: 'Message',
    }}
    disclaimer={{
      label:
        'By submitting this form you agree to our Privacy Policy and Terms of Service.',
    }}
    description="We usually reply within 24–48 hours."
  />

  <Features2
    title="Get in Touch"
    items={[
      {
        title: 'General Inquiries',
        description:
          'Questions about our articles, tutorials or website.',
      },
      {
        title: 'Business & Partnerships',
        description:
          'Advertising, sponsorships and collaboration opportunities.',
      },
      {
        title: 'Technical Support',
        description:
          'Report website issues or broken pages.',
      },
      {
        title: 'Email',
        description: 'Aizenovahelp@gmail.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Website',
        description: 'https://aizenova.com',
        icon: 'tabler:world',
      },
      {
        title: 'Location',
        description: 'Online • Worldwide',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>