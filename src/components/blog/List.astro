---
import Item from '~/components/blog/ListItem.astro';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;
---

<ul class="space-y-12">
  {
    posts.map((post) => (
      <li class="max-w-6xl mx-auto">
        <Item post={post} />
      </li>
    ))
  }
</ul>